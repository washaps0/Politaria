# =========================================================
# POLITARIA — ORE COUNTRY LOCK
# Запрещает добывать руды игрокам без страны
#
# Требуется система стран Politaria с функцией:
# countryId(player)
# =========================================================


# =========================================================
# ПРОВЕРКА: ЯВЛЯЕТСЯ ЛИ БЛОК РУДОЙ
# =========================================================

function isCountryOre(blockType: item type) :: boolean:

	# ---------- Обычный мир ----------

	if {_blockType} is coal ore:
		return true

	if {_blockType} is deepslate coal ore:
		return true


	if {_blockType} is iron ore:
		return true

	if {_blockType} is deepslate iron ore:
		return true


	if {_blockType} is copper ore:
		return true

	if {_blockType} is deepslate copper ore:
		return true


	if {_blockType} is gold ore:
		return true

	if {_blockType} is deepslate gold ore:
		return true


	if {_blockType} is redstone ore:
		return true

	if {_blockType} is deepslate redstone ore:
		return true


	if {_blockType} is lapis ore:
		return true

	if {_blockType} is deepslate lapis ore:
		return true


	if {_blockType} is diamond ore:
		return true

	if {_blockType} is deepslate diamond ore:
		return true


	if {_blockType} is emerald ore:
		return true

	if {_blockType} is deepslate emerald ore:
		return true


	# ---------- Нижний мир ----------

	if {_blockType} is nether gold ore:
		return true

	if {_blockType} is nether quartz ore:
		return true

	if {_blockType} is ancient debris:
		return true


	return false


# =========================================================
# БЛОКИРОВКА ДОБЫЧИ
# =========================================================

on break:

	# Администраторский обход
	if player has permission "politaria.ore.bypass":
		stop

	# Нас интересуют только руды
	if isCountryOre(type of event-block) is false:
		stop

	# Если игрок состоит в стране — разрешаем
	if countryId(player) is not "":
		stop

	# Игрок без страны
	cancel event

	send action bar "<red><bold>НЕЛЬЗЯ ДОБЫВАТЬ РУДУ</bold> <dark gray>• <gray>Сначала вступите в страну." to player