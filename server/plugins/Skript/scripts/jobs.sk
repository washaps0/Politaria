options:
	jobs-currency: монет
	jobs-click-delay: 8 ticks

	# Lumberjack rewards
	jobs-common-log: 1
	jobs-rare-log: 2

	# Miner rewards
	jobs-coal-copper: 3
	jobs-iron-redstone-lapis-quartz: 4
	jobs-gold: 6
	jobs-diamond: 10
	jobs-emerald: 12
	jobs-ancient-debris: 20

	# Hunter rewards
	jobs-animal: 3
	jobs-common-monster: 5
	jobs-dangerous-monster: 8
	jobs-rare-monster: 20
	jobs-boss: 300

	# Experience required in each profession (total, not per level)
	jobs-level-2-xp: 300
	jobs-level-3-xp: 1000
	jobs-level-4-xp: 2500
	jobs-level-5-xp: 5000

	# Salary bonus by level
	jobs-level-2-bonus: 0.08
	jobs-level-3-bonus: 0.16
	jobs-level-4-bonus: 0.25
	jobs-level-5-bonus: 0.35

# {jobs.current::<uuid>} = lumberjack, miner or hunter
# {jobs.xp::<uuid>::<job>} = permanent experience in a specific profession.
# {jobs.bonus-bank::<uuid>::<job>} stores a fractional salary bonus.
# {jobs.placed::<block location>} prevents rewards for player-placed resources.

function jobsName(id: text) :: text:
	if {_id} is "lumberjack":
		return "Лесоруб"
	if {_id} is "miner":
		return "Шахтёр"
	if {_id} is "hunter":
		return "Охотник"
	return "Безработный"

function jobsCurrent(p: player) :: text:
	if {jobs.current::%uuid of {_p}%} is not set:
		return ""
	# Force a saved value back into plain lower-case text after reconnect/restart.
	set {_job} to lowercase "%{jobs.current::%uuid of {_p}%}%"
	if {_job} is "lumberjack":
		set {jobs.current::%uuid of {_p}%} to "lumberjack"
		return "lumberjack"
	if {_job} is "miner":
		set {jobs.current::%uuid of {_p}%} to "miner"
		return "miner"
	if {_job} is "hunter":
		set {jobs.current::%uuid of {_p}%} to "hunter"
		return "hunter"
	delete {jobs.current::%uuid of {_p}%}
	return ""

function jobsExperience(p: player, job: text) :: number:
	if {jobs.xp::%uuid of {_p}%::%{_job}%} is not set:
		set {jobs.xp::%uuid of {_p}%::%{_job}%} to 0
	return {jobs.xp::%uuid of {_p}%::%{_job}%}

function jobsLevel(p: player, job: text) :: number:
	set {_xp} to jobsExperience({_p}, {_job})
	if {_xp} is greater than or equal to {@jobs-level-5-xp}:
		return 5
	if {_xp} is greater than or equal to {@jobs-level-4-xp}:
		return 4
	if {_xp} is greater than or equal to {@jobs-level-3-xp}:
		return 3
	if {_xp} is greater than or equal to {@jobs-level-2-xp}:
		return 2
	return 1

function jobsNextLevelExperience(level: number) :: number:
	if {_level} is 1:
		return {@jobs-level-2-xp}
	if {_level} is 2:
		return {@jobs-level-3-xp}
	if {_level} is 3:
		return {@jobs-level-4-xp}
	if {_level} is 4:
		return {@jobs-level-5-xp}
	return {@jobs-level-5-xp}

function jobsBonus(level: number) :: number:
	if {_level} is 2:
		return {@jobs-level-2-bonus}
	if {_level} is 3:
		return {@jobs-level-3-bonus}
	if {_level} is 4:
		return {@jobs-level-4-bonus}
	if {_level} is 5:
		return {@jobs-level-5-bonus}
	return 0

function jobsBonusPercent(level: number) :: number:
	return round(jobsBonus({_level}) * 100)

function jobsProgress(p: player, job: text) :: text:
	set {_level} to jobsLevel({_p}, {_job})
	if {_level} is 5:
		return "<gold>МАКСИМАЛЬНЫЙ УРОВЕНЬ"
	set {_xp} to jobsExperience({_p}, {_job})
	set {_needed} to jobsNextLevelExperience({_level})
	return "<gray>Опыт: <white>%{_xp}%<dark gray>/<white>%{_needed}%"

function jobsAddExperience(p: player, job: text, amount: number):
	set {_old-level} to jobsLevel({_p}, {_job})
	if {_old-level} is 5:
		stop
	set {_earned-xp} to rounded down {_amount}
	add {_earned-xp} to {jobs.xp::%uuid of {_p}%::%{_job}%}
	set {_new-level} to jobsLevel({_p}, {_job})
	if {_new-level} is greater than {_old-level}:
		set {_bonus} to jobsBonusPercent({_new-level})
		send formatted "<gold><bold>НОВЫЙ УРОВЕНЬ!</bold> <gray>Работа: <white>%jobsName({_job})% <dark gray>• <gray>Уровень: <white>%{_new-level}% <dark gray>• <green>+%{_bonus}%%% к зарплате" to {_p}

function jobsBlockKey(b: block) :: text:
	return "%location of {_b}%"

function jobsWoodReward(kind: item type) :: number:
	if {_kind} is oak log:
		return {@jobs-common-log}
	if {_kind} is spruce log:
		return {@jobs-common-log}
	if {_kind} is birch log:
		return {@jobs-common-log}
	if {_kind} is jungle log:
		return {@jobs-common-log}
	if {_kind} is acacia log:
		return {@jobs-common-log}
	if {_kind} is dark oak log:
		return {@jobs-common-log}
	if {_kind} is stripped oak log:
		return {@jobs-common-log}
	if {_kind} is stripped spruce log:
		return {@jobs-common-log}
	if {_kind} is stripped birch log:
		return {@jobs-common-log}
	if {_kind} is stripped jungle log:
		return {@jobs-common-log}
	if {_kind} is stripped acacia log:
		return {@jobs-common-log}
	if {_kind} is stripped dark oak log:
		return {@jobs-common-log}
	if {_kind} is mangrove log:
		return {@jobs-rare-log}
	if {_kind} is cherry log:
		return {@jobs-rare-log}
	if {_kind} is crimson stem:
		return {@jobs-rare-log}
	if {_kind} is warped stem:
		return {@jobs-rare-log}
	if {_kind} is stripped mangrove log:
		return {@jobs-rare-log}
	if {_kind} is stripped cherry log:
		return {@jobs-rare-log}
	if {_kind} is stripped crimson stem:
		return {@jobs-rare-log}
	if {_kind} is stripped warped stem:
		return {@jobs-rare-log}
	return 0

function jobsMineReward(kind: item type) :: number:
	if {_kind} is coal ore:
		return {@jobs-coal-copper}
	if {_kind} is deepslate coal ore:
		return {@jobs-coal-copper}
	if {_kind} is copper ore:
		return {@jobs-coal-copper}
	if {_kind} is deepslate copper ore:
		return {@jobs-coal-copper}
	if {_kind} is iron ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is deepslate iron ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is redstone ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is deepslate redstone ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is lapis ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is deepslate lapis ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is nether quartz ore:
		return {@jobs-iron-redstone-lapis-quartz}
	if {_kind} is gold ore:
		return {@jobs-gold}
	if {_kind} is deepslate gold ore:
		return {@jobs-gold}
	if {_kind} is nether gold ore:
		return {@jobs-gold}
	if {_kind} is diamond ore:
		return {@jobs-diamond}
	if {_kind} is deepslate diamond ore:
		return {@jobs-diamond}
	if {_kind} is emerald ore:
		return {@jobs-emerald}
	if {_kind} is deepslate emerald ore:
		return {@jobs-emerald}
	if {_kind} is ancient debris:
		return {@jobs-ancient-debris}
	return 0

function jobsHuntReward(kind: entity type) :: number:
	# Peaceful farm animals and wild animals
	if {_kind} is cow:
		return {@jobs-animal}
	if {_kind} is pig:
		return {@jobs-animal}
	if {_kind} is sheep:
		return {@jobs-animal}
	if {_kind} is chicken:
		return {@jobs-animal}
	if {_kind} is rabbit:
		return {@jobs-animal}
	if {_kind} is cod:
		return {@jobs-animal}
	if {_kind} is salmon:
		return {@jobs-animal}
	if {_kind} is squid:
		return {@jobs-animal}
	if {_kind} is glow squid:
		return {@jobs-animal}
	if {_kind} is horse:
		return {@jobs-animal}
	if {_kind} is donkey:
		return {@jobs-animal}
	if {_kind} is mule:
		return {@jobs-animal}
	if {_kind} is llama:
		return {@jobs-animal}
	if {_kind} is goat:
		return {@jobs-animal}
	
	# Common hostile mobs
	if {_kind} is zombie:
		return {@jobs-common-monster}
	if {_kind} is skeleton:
		return {@jobs-common-monster}
	if {_kind} is spider:
		return {@jobs-common-monster}
	if {_kind} is cave spider:
		return {@jobs-common-monster}
	if "%{_kind}%" is "creeper":
		return {@jobs-common-monster}
	if {_kind} is drowned:
		return {@jobs-common-monster}
	if {_kind} is husk:
		return {@jobs-common-monster}
	if {_kind} is stray:
		return {@jobs-common-monster}
	if {_kind} is bogged:
		return {@jobs-common-monster}
	if {_kind} is silverfish:
		return {@jobs-common-monster}
	if {_kind} is slime:
		return {@jobs-common-monster}
	if {_kind} is magma cube:
		return {@jobs-common-monster}
	if {_kind} is endermite:
		return {@jobs-common-monster}
	if {_kind} is zombie villager:
		return {@jobs-common-monster}
	
	# Dangerous mobs
	if {_kind} is blaze:
		return {@jobs-dangerous-monster}
	if {_kind} is enderman:
		return {@jobs-dangerous-monster}
	if {_kind} is witch:
		return {@jobs-dangerous-monster}
	if {_kind} is guardian:
		return {@jobs-dangerous-monster}
	if {_kind} is phantom:
		return {@jobs-dangerous-monster}
	if {_kind} is wither skeleton:
		return {@jobs-dangerous-monster}
	if {_kind} is piglin brute:
		return {@jobs-dangerous-monster}
	if {_kind} is shulker:
		return {@jobs-dangerous-monster}
	if {_kind} is breeze:
		return {@jobs-dangerous-monster}
	
	# Rare and very dangerous mobs
	if {_kind} is ghast:
		return {@jobs-rare-monster}
	if {_kind} is ravager:
		return {@jobs-rare-monster}
	if {_kind} is elder guardian:
		return {@jobs-rare-monster}
	if {_kind} is evoker:
		return {@jobs-rare-monster}
	if {_kind} is warden:
		return {@jobs-boss}
	if "%{_kind}%" is "wither":
		return {@jobs-boss}
	if {_kind} is ender dragon:
		return {@jobs-boss}
	return 0

function jobsPay(p: player, baseAmount: number, job: text):
	if {_baseAmount} is less than 1:
		stop
	set {_level} to jobsLevel({_p}, {_job})
	set {_reward} to {_baseAmount}
	set {_fraction} to {_baseAmount} * jobsBonus({_level})
	if {jobs.bonus-bank::%uuid of {_p}%::%{_job}%} is not set:
		set {jobs.bonus-bank::%uuid of {_p}%::%{_job}%} to 0
	add {_fraction} to {jobs.bonus-bank::%uuid of {_p}%::%{_job}%}
	set {_extra} to floor({jobs.bonus-bank::%uuid of {_p}%::%{_job}%})
	if {_extra} is greater than 0:
		add {_extra} to {_reward}
		remove {_extra} from {jobs.bonus-bank::%uuid of {_p}%::%{_job}%}
	economyEnsure({_p})
	add {_reward} to {economy.balance::%uuid of {_p}%}
	jobsAddExperience({_p}, {_job}, {_baseAmount})
	send action bar formatted "<green><bold>+%{_reward}%</bold> {@jobs-currency} <dark gray>• <gray>%jobsName({_job})% <dark gray>• <gray>ур. %{_level}%" to {_p}

function jobsSet(p: player, newJob: text):
	set {_old-job} to jobsCurrent({_p})
	if {_old-job} is {_newJob}:
		delete {jobs.current::%uuid of {_p}%}
		send formatted "<red>Вы уволились с работы <white>%jobsName({_old-job})%<red>." to {_p}
		stop
	if {_old-job} is not "":
		send formatted "<gray>Вы автоматически уволились с работы <white>%jobsName({_old-job})%<gray>." to {_p}
	set {jobs.current::%uuid of {_p}%} to {_newJob}
	send formatted "<green>Вы начали работать: <white><bold>%jobsName({_newJob})%</bold><green>." to {_p}

function jobsOpen(p: player):
	set {_menu} to chest inventory with 3 rows named "<dark gray>Выбор работы"
	loop integers between 0 and 26:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	set {_current} to jobsCurrent({_p})
	set {_lumber-status} to "<yellow>Нажмите, чтобы устроиться"
	set {_miner-status} to "<yellow>Нажмите, чтобы устроиться"
	set {_hunter-status} to "<yellow>Нажмите, чтобы устроиться"
	if {_current} is "lumberjack":
		set {_lumber-status} to "<red>Нажмите, чтобы уволиться"
	if {_current} is "miner":
		set {_miner-status} to "<red>Нажмите, чтобы уволиться"
	if {_current} is "hunter":
		set {_hunter-status} to "<red>Нажмите, чтобы уволиться"

	set {_lumber-level} to jobsLevel({_p}, "lumberjack")
	set {_miner-level} to jobsLevel({_p}, "miner")
	set {_hunter-level} to jobsLevel({_p}, "hunter")
	set {_lumber-bonus} to jobsBonusPercent({_lumber-level})
	set {_miner-bonus} to jobsBonusPercent({_miner-level})
	set {_hunter-bonus} to jobsBonusPercent({_hunter-level})
	set {_lumber-progress} to jobsProgress({_p}, "lumberjack")
	set {_miner-progress} to jobsProgress({_p}, "miner")
	set {_hunter-progress} to jobsProgress({_p}, "hunter")
	set slot 11 of {_menu} to iron axe named "<green><bold>ЛЕСОРУБ" with lore "<gray>Срубайте натуральные брёвна" and "<gray>Обычное бревно: <gold>{@jobs-common-log} монета" and "<gray>Редкое бревно: <gold>{@jobs-rare-log} монеты" and "" and "<gray>Уровень: <white>%{_lumber-level}%<dark gray>/5 <gray>• Бонус: <green>+%{_lumber-bonus}%%%" and "%{_lumber-progress}%" and "" and "%{_lumber-status}%"
	set slot 13 of {_menu} to iron pickaxe named "<aqua><bold>ШАХТЁР" with lore "<gray>Добывайте натуральную руду" and "<gray>Уголь и медь: <gold>{@jobs-coal-copper}" and "<gray>Железо и кварц: <gold>{@jobs-iron-redstone-lapis-quartz}" and "<gray>Алмаз: <gold>{@jobs-diamond}" and "<gray>Древние обломки: <gold>{@jobs-ancient-debris}" and "" and "<gray>Уровень: <white>%{_miner-level}%<dark gray>/5 <gray>• Бонус: <green>+%{_miner-bonus}%%%" and "%{_miner-progress}%" and "" and "%{_miner-status}%"
	set slot 15 of {_menu} to iron sword named "<red><bold>ОХОТНИК" with lore "<gray>Убивайте животных и монстров" and "<gray>Животные: <gold>{@jobs-animal}" and "<gray>Обычные монстры: <gold>{@jobs-common-monster}" and "<gray>Опасные монстры: <gold>{@jobs-dangerous-monster}" and "<gray>Редкие монстры: <gold>{@jobs-rare-monster}" and "" and "<gray>Уровень: <white>%{_hunter-level}%<dark gray>/5 <gray>• Бонус: <green>+%{_hunter-bonus}%%%" and "%{_hunter-progress}%" and "" and "%{_hunter-status}%"
	if {_current} is "":
		set slot 22 of {_menu} to gold ingot named "<gold><bold>ТЕКУЩАЯ РАБОТА" with lore "<gray>Безработный" and "<gray>Баланс: <white>%economyBalance({_p})% {@jobs-currency}"
	else:
		set {_current-level} to jobsLevel({_p}, {_current})
		set slot 22 of {_menu} to gold ingot named "<gold><bold>ТЕКУЩАЯ РАБОТА" with lore "<white>%jobsName({_current})%" and "<gray>Уровень: <white>%{_current-level}%<dark gray>/5" and "<gray>Баланс: <white>%economyBalance({_p})% {@jobs-currency}"
	open {_menu} to {_p}
	set {jobs.menu::%uuid of {_p}%} to true

command /jobs:
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		jobsOpen(player)

on inventory click:
	if {jobs.menu::%uuid of player%} is not set:
		stop
	cancel event
	if {ui.click-until::%uuid of player%} is in the future:
		stop
	set {ui.click-until::%uuid of player%} to {@jobs-click-delay} from now
	if event-slot is not set:
		stop
	set {_slot} to raw index of event-slot
	if {_slot} is 11:
		jobsSet(player, "lumberjack")
		jobsOpen(player)
		stop
	if {_slot} is 13:
		jobsSet(player, "miner")
		jobsOpen(player)
		stop
	if {_slot} is 15:
		jobsSet(player, "hunter")
		jobsOpen(player)

on inventory drag:
	if {jobs.menu::%uuid of player%} is set:
		cancel event

on inventory close:
	if {jobs.menu::%uuid of player%} is set:
		delete {jobs.menu::%uuid of player%}

on place:
	set {_wood-reward} to jobsWoodReward(type of event-block)
	set {_mine-reward} to jobsMineReward(type of event-block)
	if {_wood-reward} is greater than 0:
		set {jobs.placed::%jobsBlockKey(event-block)%} to true
		stop
	if {_mine-reward} is greater than 0:
		set {jobs.placed::%jobsBlockKey(event-block)%} to true

on break:
	set {_key} to jobsBlockKey(event-block)
	if {jobs.placed::%{_key}%} is set:
		delete {jobs.placed::%{_key}%}
		stop
	set {_job} to jobsCurrent(player)
	if {_job} is "lumberjack":
		set {_reward} to jobsWoodReward(type of event-block)
		if {_reward} is greater than 0:
			clear drops
			jobsPay(player, {_reward}, "lumberjack")
		stop
	if {_job} is "miner":
		set {_reward} to jobsMineReward(type of event-block)
		if {_reward} is greater than 0:
			clear drops
			jobsPay(player, {_reward}, "miner")

on death:
	if attacker is not a player:
		stop
	set {_hunter} to attacker
	if jobsCurrent({_hunter}) is not "hunter":
		stop
	if victim is a player:
		stop
	set {_reward} to jobsHuntReward(type of victim)
	if {_reward} is less than 1:
		stop
	clear drops
	jobsPay({_hunter}, {_reward}, "hunter")

on quit:
	delete {jobs.menu::%uuid of player%}

on join:
	wait 20 ticks
	if player is not online:
		stop
	set {_job} to jobsCurrent(player)
	if {_job} is not "":
		send action bar formatted "<green>Работа активна: <white><bold>%jobsName({_job})%" to player
