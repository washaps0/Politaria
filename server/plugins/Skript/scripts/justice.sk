options:
	justice-jail-radius: 10
	justice-arrest-distance: 6
	justice-cuff-follow-distance: 4
	justice-prison-escape-radius: 6
	justice-max-cells: 20
	justice-max-jail-minutes: 1440
	justice-max-fine: 1000000

# =========================================================
# POLITARIA — JUSTICE / POLICE UI
# Единый файл: наказания законов, судимости, тюрьма,
# наручники, паспортные данные и исправления GUI.
# =========================================================

function justiceCanManageCountry(p: player, id: text) :: boolean:
	if countryIsAdmin({_p}) is true:
		return true
	if countryCanEditSettings({_p}, {_id}) is true:
		return true
	return false

function justiceLawStars(id: text, number: number) :: number:
	if {justice.law-stars::%{_id}%::%{_number}%} is set:
		return {justice.law-stars::%{_id}%::%{_number}%}
	return 0

function justiceLawFine(id: text, number: number) :: number:
	if {justice.law-fine::%{_id}%::%{_number}%} is set:
		return {justice.law-fine::%{_id}%::%{_number}%}
	return 0

function justiceLawJail(id: text, number: number) :: number:
	if {justice.law-jail::%{_id}%::%{_number}%} is set:
		return {justice.law-jail::%{_id}%::%{_number}%}
	return 0

function justiceLawPenaltyText(id: text, number: number) :: text:
	set {_stars} to justiceLawStars({_id}, {_number})
	set {_fine} to justiceLawFine({_id}, {_number})
	set {_jail} to justiceLawJail({_id}, {_number})
	return "<gray>Наказание: <gold>%{_stars}%★ <dark gray>• <yellow>%{_fine}% мон. <dark gray>• <red>%{_jail}% мин."

function justiceClearLawPenalty(id: text, number: number):
	delete {justice.law-stars::%{_id}%::%{_number}%}
	delete {justice.law-fine::%{_id}%::%{_number}%}
	delete {justice.law-jail::%{_id}%::%{_number}%}

function justiceDeleteLaw(id: text, number: number):
	set {_count} to countryLawCount({_id})
	set {_current} to {_number}
	while {_current} is less than {_count}:
		set {_next} to {_current} + 1
		set {country.law::%{_id}%::%{_current}%} to {country.law::%{_id}%::%{_next}%}
		set {justice.law-stars::%{_id}%::%{_current}%} to justiceLawStars({_id}, {_next})
		set {justice.law-fine::%{_id}%::%{_current}%} to justiceLawFine({_id}, {_next})
		set {justice.law-jail::%{_id}%::%{_current}%} to justiceLawJail({_id}, {_next})
		add 1 to {_current}
	delete {country.law::%{_id}%::%{_count}%}
	justiceClearLawPenalty({_id}, {_count})

function justiceMoveLaw(id: text, oldNumber: number, newNumber: number):
	set {_text} to {country.law::%{_id}%::%{_oldNumber}%}
	set {_stars} to justiceLawStars({_id}, {_oldNumber})
	set {_fine} to justiceLawFine({_id}, {_oldNumber})
	set {_jail} to justiceLawJail({_id}, {_oldNumber})
	if {_oldNumber} is less than {_newNumber}:
		set {_current} to {_oldNumber}
		while {_current} is less than {_newNumber}:
			set {_next} to {_current} + 1
			set {country.law::%{_id}%::%{_current}%} to {country.law::%{_id}%::%{_next}%}
			set {justice.law-stars::%{_id}%::%{_current}%} to justiceLawStars({_id}, {_next})
			set {justice.law-fine::%{_id}%::%{_current}%} to justiceLawFine({_id}, {_next})
			set {justice.law-jail::%{_id}%::%{_current}%} to justiceLawJail({_id}, {_next})
			add 1 to {_current}
	else if {_oldNumber} is greater than {_newNumber}:
		set {_current} to {_oldNumber}
		while {_current} is greater than {_newNumber}:
			set {_previous} to {_current} - 1
			set {country.law::%{_id}%::%{_current}%} to {country.law::%{_id}%::%{_previous}%}
			set {justice.law-stars::%{_id}%::%{_current}%} to justiceLawStars({_id}, {_previous})
			set {justice.law-fine::%{_id}%::%{_current}%} to justiceLawFine({_id}, {_previous})
			set {justice.law-jail::%{_id}%::%{_current}%} to justiceLawJail({_id}, {_previous})
			subtract 1 from {_current}
	set {country.law::%{_id}%::%{_newNumber}%} to {_text}
	set {justice.law-stars::%{_id}%::%{_newNumber}%} to {_stars}
	set {justice.law-fine::%{_id}%::%{_newNumber}%} to {_fine}
	set {justice.law-jail::%{_id}%::%{_newNumber}%} to {_jail}

function justicePlayerFromUuid(targetUuid: text) :: player:
	loop all players:
		if "%uuid of loop-player%" is {_targetUuid}:
			return loop-player

function justicePropertyCount(targetUuid: text) :: number:
	set {_count} to 0
	loop {country.chunk-owner::*}:
		if loop-value is {_targetUuid}:
			add 1 to {_count}
	return {_count}

function justiceConvictionCount(targetUuid: text) :: number:
	if {justice.conviction-count::%{_targetUuid}%} is set:
		return {justice.conviction-count::%{_targetUuid}%}
	return 0

function justiceFineDebt(targetUuid: text) :: number:
	set {_total} to 0
	loop {justice.fine-debt::%{_targetUuid}%::*}:
		add loop-value to {_total}
	return {_total}

function justiceCellCount(id: text) :: number:
	set {_count} to 0
	loop {justice.jail-cell::%{_id}%::*}:
		add 1 to {_count}
	return {_count}

function justiceNearestCell(id: text, where: location, maxDistance: number) :: location:
	set {_bestDistance} to 999999
	loop {justice.jail-cell::%{_id}%::*}:
		set {_cell} to loop-value
		if world of {_cell} is world of {_where}:
			set {_distance} to distance between {_cell} and {_where}
			if {_distance} is less than or equal to {_maxDistance}:
				if {_distance} is less than {_bestDistance}:
					set {_bestDistance} to {_distance}
					set {_best} to {_cell}
	return {_best}

function justiceRecordConviction(targetUuid: text, country: text, lawNumber: number):
	if {justice.conviction-count::%{_targetUuid}%} is not set:
		set {justice.conviction-count::%{_targetUuid}%} to 0
	add 1 to {justice.conviction-count::%{_targetUuid}%}
	set {_n} to {justice.conviction-count::%{_targetUuid}%}
	set {justice.conviction::%{_targetUuid}%::%{_n}%::country} to {_country}
	set {justice.conviction::%{_targetUuid}%::%{_n}%::law} to {country.law::%{_country}%::%{_lawNumber}%}
	set {justice.conviction::%{_targetUuid}%::%{_n}%::law-number} to {_lawNumber}
	set {justice.conviction::%{_targetUuid}%::%{_n}%::stars} to justiceLawStars({_country}, {_lawNumber})
	set {justice.conviction::%{_targetUuid}%::%{_n}%::fine} to justiceLawFine({_country}, {_lawNumber})
	set {justice.conviction::%{_targetUuid}%::%{_n}%::jail} to justiceLawJail({_country}, {_lawNumber})
	set {justice.conviction::%{_targetUuid}%::%{_n}%::date} to now

function justiceApplyLaw(guard: player, targetUuid: text, lawNumber: number):
	set {_id} to countryId({_guard})
	if {_id} is "":
		stop
	if policeIsGuard({_guard}) is not true:
		stop
	if {country.law::%{_id}%::%{_lawNumber}%} is not set:
		send "<red>Этот закон больше не существует." to {_guard}
		stop
	set {_stars} to justiceLawStars({_id}, {_lawNumber})
	set {_fine} to justiceLawFine({_id}, {_lawNumber})
	set {_jail} to justiceLawJail({_id}, {_lawNumber})
	set {_name} to policeTargetName({_targetUuid})
	if {_stars} is greater than 0:
		set {_current} to policeWantedStars({_id}, {_targetUuid})
		if {_current} is less than {_stars}:
			policeSetWanted({_id}, {_targetUuid}, {_name}, {_stars})
	if {_fine} is greater than 0:
		if {economy.balance::%{_targetUuid}%} is not set:
			set {economy.balance::%{_targetUuid}%} to 0
		set {_paid} to {_fine}
		if {economy.balance::%{_targetUuid}%} is less than {_fine}:
			set {_paid} to {economy.balance::%{_targetUuid}%}
		if {_paid} is less than 0:
			set {_paid} to 0
		set {_debt} to {_fine} - {_paid}
		remove {_paid} from {economy.balance::%{_targetUuid}%}
		if {country.treasury::%{_id}%} is not set:
			set {country.treasury::%{_id}%} to 0
		add {_paid} to {country.treasury::%{_id}%}
		if {_debt} is greater than 0:
			if {justice.fine-debt::%{_targetUuid}%::%{_id}%} is not set:
				set {justice.fine-debt::%{_targetUuid}%::%{_id}%} to 0
			add {_debt} to {justice.fine-debt::%{_targetUuid}%::%{_id}%}
	if {_jail} is greater than 0:
		if {justice.pending-jail::%{_id}%::%{_targetUuid}%} is not set:
			set {justice.pending-jail::%{_id}%::%{_targetUuid}%} to 0
		add {_jail} to {justice.pending-jail::%{_id}%::%{_targetUuid}%}
	justiceRecordConviction({_targetUuid}, {_id}, {_lawNumber})
	policeNotifyCountry({_id}, "%{_name}% осуждён по закону №%{_lawNumber}%.")
	set {_target} to justicePlayerFromUuid({_targetUuid})
	if {_target} is set:
		send formatted "<red><bold>СУДИМОСТЬ</bold> <dark gray>• %countryColor({_id})%%countryName({_id})%" to {_target}
		send formatted "<gray>Закон №%{_lawNumber}%: <white>%{country.law::%{_id}%::%{_lawNumber}%}%" to {_target}
		send formatted justiceLawPenaltyText({_id}, {_lawNumber}) to {_target}

# =========================================================
# НАРУЧНИКИ
# =========================================================

function justiceReleaseCuffs(targetUuid: text):
	set {_guardUuid} to {justice.cuffed-by::%{_targetUuid}%}
	if {_guardUuid} is set:
		delete {justice.cuff-target::%{_guardUuid}%}
	delete {justice.cuffed-by::%{_targetUuid}%}
	delete {justice.cuff-mode::%{_targetUuid}%}
	delete {justice.cuff-hold::%{_targetUuid}%}

function justiceCanCuff(guard: player, target: player) :: boolean:
	if policeIsGuard({_guard}) is not true:
		return false
	set {_guardCountry} to countryId({_guard})
	if {_guardCountry} is "":
		return false
	set {_targetCountry} to countryId({_target})
	if {_targetCountry} is "":
		return true
	if {_targetCountry} is {_guardCountry}:
		return true
	return false

function justiceOpenCuffControl(p: player, target: player):
	set {_menu} to chest inventory with 3 rows named "<dark gray>Наручники • %name of {_target}%"
	loop integers between 0 and 26:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	set {_mode} to {justice.cuff-mode::%uuid of {_target}%}
	set slot 4 of {_menu} to iron bars named "<aqua><bold>%name of {_target}%" with lore "<gray>Режим: <white>%{_mode}%"
	set slot 10 of {_menu} to lead named "<yellow><bold>ВЕСТИ ЗА СОБОЙ" with lore "<gray>Игрок сможет двигаться только рядом с вами"
	set slot 12 of {_menu} to feather named "<light green><bold>РАЗРЕШИТЬ ХОДИТЬ" with lore "<gray>Свободное движение, но действия всё ещё заблокированы"
	set slot 14 of {_menu} to iron boots named "<red><bold>ЗАПРЕТИТЬ ДВИЖЕНИЕ" with lore "<gray>Полностью зафиксировать игрока на месте"
	set slot 16 of {_menu} to shears named "<white><bold>СНЯТЬ НАРУЧНИКИ"
	set slot 22 of {_menu} to arrow named "<yellow>Закрыть"
	set {justice.cuff-menu-target::%uuid of {_p}%} to "%uuid of {_target}%"
	set {justice.menu::%uuid of {_p}%} to "cuff-control"
	set {justice.readonly::%uuid of {_p}%} to true
	open {_menu} to {_p}

# =========================================================
# ТЮРЬМА / BOSSBAR
# =========================================================

function justiceBossbarId(p: player) :: text:
	set {_name} to lowercase name of {_p}
	return "politaria:jail_%{_name}%"

function justiceCreateBossbar(p: player):
	set {_id} to justiceBossbarId({_p})
	execute console command "bossbar remove %{_id}%"
	execute console command "bossbar add %{_id}% {""text"":""Тюрьма"",""color"":""red""}"
	execute console command "bossbar set %{_id}% color red"
	execute console command "bossbar set %{_id}% max 100"
	execute console command "bossbar set %{_id}% players %name of {_p}%"

function justiceRemoveBossbar(p: player):
	set {_id} to justiceBossbarId({_p})
	execute console command "bossbar remove %{_id}%"

function justiceReleasePrisoner(p: player):
	set {_country} to {justice.prison-country::%uuid of {_p}%}
	justiceRemoveBossbar({_p})
	delete {justice.prison-until::%uuid of {_p}%}
	delete {justice.prison-country::%uuid of {_p}%}
	delete {justice.prison-cell::%uuid of {_p}%}
	if {_country} is set:
		if {country.spawn::%{_country}%} is set:
			teleport {_p} to {country.spawn::%{_country}%}
			send "<light green><bold>СРОК ОКОНЧЕН</bold> <gray>Вы освобождены и доставлены в столицу." to {_p}
			stop
	teleport {_p} to spawn point of world of {_p}
	send "<light green><bold>СРОК ОКОНЧЕН</bold> <gray>Вы освобождены." to {_p}

# =========================================================
# GUI DECORATION + COMPATIBILITY
# =========================================================

function justiceDecorateMain(p: player):
	if {country.menu::%uuid of {_p}%} is not "main":
		stop
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	set {_count} to size of {police.wanted::%{_id}%::*}
	if policeIsGuard({_p}) is true:
		set slot 35 of current inventory of {_p} to recovery compass named "<red><bold>РОЗЫСК" with lore "<gray>Разыскиваемых: <white>%{_count}%" and "<gray>Управление и отслеживание" and "" and "<yellow>Нажмите, чтобы открыть"
	else:
		set slot 35 of current inventory of {_p} to compass named "<red><bold>РОЗЫСК" with lore "<gray>Разыскиваемых: <white>%{_count}%" and "<gray>Просмотр списка страны" and "" and "<yellow>Нажмите, чтобы открыть"
	set {_pages} to countryStoragePages({_id})
	set slot 36 of current inventory of {_p} to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Категории и быстрый склад" and "<gray>Страниц: <white>%{_pages}%/2" and "" and "<yellow>Нажмите, чтобы открыть"

function justiceDecorateLawEditor(p: player):
	if {country.menu::%uuid of {_p}%} is not "law-editor":
		stop
	set {_id} to countryId({_p})
	set {_number} to {country.selected-law::%uuid of {_p}%}
	if {_number} is not set:
		stop
	set slot 4 of current inventory of {_p} to written book named "<yellow><bold>ЗАКОН №%{_number}%" with lore "<white>%{country.law::%{_id}%::%{_number}%}%" and "" and justiceLawPenaltyText({_id}, {_number})
	if countryHasPermission({_p}, "MANAGE_LAWS") is true:
		set slot 10 of current inventory of {_p} to redstone torch named "<gold><bold>РОЗЫСК" with lore "<gray>Звёзды: <gold>%justiceLawStars({_id}, {_number})%/5" and "<yellow>Нажмите, чтобы переключить"
		set slot 12 of current inventory of {_p} to gold ingot named "<yellow><bold>ШТРАФ" with lore "<gray>%justiceLawFine({_id}, {_number})% монет" and "<yellow>Нажмите, чтобы изменить"
		set slot 14 of current inventory of {_p} to iron bars named "<red><bold>ТЮРЬМА" with lore "<gray>%justiceLawJail({_id}, {_number})% минут" and "<yellow>Нажмите, чтобы изменить"
		set slot 13 of current inventory of {_p} to gray stained glass pane named " "
		set slot 15 of current inventory of {_p} to gray stained glass pane named " "
		set slot 16 of current inventory of {_p} to compass named "<gold><bold>ИЗМЕНИТЬ НОМЕР"
		set slot 18 of current inventory of {_p} to barrier named "<red><bold>УДАЛИТЬ"

function justiceDecorateLawList(p: player):
	if {country.menu::%uuid of {_p}%} is not "laws":
		stop
	set {_id} to countryId({_p})
	loop integers between 0 and 44:
		set {_number} to {country.menu-law::%uuid of {_p}%::%loop-value%}
		if {_number} is set:
			set slot loop-value of current inventory of {_p} to paper named "<yellow><bold>ЗАКОН №%{_number}%" with lore "<white>%{country.law::%{_id}%::%{_number}%}%" and "" and justiceLawPenaltyText({_id}, {_number}) and "" and "<gray>Нажмите, чтобы открыть"

function justiceDecorateSettings(p: player):
	if {country.menu::%uuid of {_p}%} is not "settings":
		stop
	set {_id} to countryEditingId({_p})
	if {_id} is "":
		stop
	set slot 33 of current inventory of {_p} to iron bars named "<red><bold>ТЮРЬМА" with lore "<gray>Камер: <white>%justiceCellCount({_id})%" and "<gray>Настройка камер"

function justiceDecoratePassport(p: player):
	set {_targetUuid} to {police.passport-target::%uuid of {_p}%}
	if {_targetUuid} is not set:
		stop
	set {_country} to policeTargetCountry({_targetUuid})
	if {_country} is not "":
		set {_roles} to name tag named "<light purple><bold>ВСЕ РОЛИ"
		delete {_roleLore::*}
		if {country.owner::%{_country}%} is {_targetUuid}:
			add "<gold>• Правитель" to {_roleLore::*}
		else:
			countryEnsureRoleStorage({_country}, {_targetUuid})
			loop {country.roles-of::%{_country}%::%{_targetUuid}%::*}:
				if loop-value is true:
					add "<gray>• <white>%countryRoleName({_country}, loop-index)%" to {_roleLore::*}
		if size of {_roleLore::*} is 0:
			add "<gray>• Гражданин" to {_roleLore::*}
		set lore of {_roles} to {_roleLore::*}
		set slot 13 of current inventory of {_p} to {_roles}
	set slot 17 of current inventory of {_p} to bricks named "<yellow><bold>НЕДВИЖИМОСТЬ" with lore "<gray>Собственных чанков: <white>%justicePropertyCount({_targetUuid})%"
	set slot 19 of current inventory of {_p} to written book named "<red><bold>СУДИМОСТИ" with lore "<gray>Всего: <white>%justiceConvictionCount({_targetUuid})%" and "<yellow>Нажмите для истории"
	set slot 21 of current inventory of {_p} to gold nugget named "<gold><bold>ШТРАФЫ" with lore "<gray>Неоплачено: <gold>%justiceFineDebt({_targetUuid})% монет"
	if {justice.prison-until::%{_targetUuid}%} is in the future:
		set {_prisonCountry} to {justice.prison-country::%{_targetUuid}%}
		set slot 23 of current inventory of {_p} to iron bars named "<red><bold>В ТЮРЬМЕ" with lore "<gray>Страна: %countryColor({_prisonCountry})%%countryName({_prisonCountry})%"
	else:
		set slot 23 of current inventory of {_p} to lime dye named "<light green><bold>НЕ В ТЮРЬМЕ"

function justiceDecorateWanted(p: player):
	if {police.menu::%uuid of {_p}%} is not "wanted-detail":
		stop
	if policeIsGuard({_p}) is not true:
		stop
	set {_targetUuid} to {police.selected-target::%uuid of {_p}%}
	set {_id} to countryId({_p})
	set {_pending} to {justice.pending-jail::%{_id}%::%{_targetUuid}%}
	if {_pending} is not set:
		set {_pending} to 0
	set slot 13 of current inventory of {_p} to written book named "<yellow><bold>ПРИМЕНИТЬ ЗАКОН" with lore "<gray>Судимость, розыск, штраф и срок"
	set slot 22 of current inventory of {_p} to iron bars named "<red><bold>ПОСАДИТЬ В ТЮРЬМУ" with lore "<gray>Назначено: <white>%{_pending}% мин." and "<gray>Нужны наручники и камера рядом"

function justiceDecorateSocial(p: player):
	if {social.menu-open::%uuid of {_p}%} is not true:
		stop
	if policeIsGuard({_p}) is not true:
		stop
	set {_raw} to {social.menu-target::%uuid of {_p}%}
	if {_raw} is not set:
		stop
	set {_targetUuid} to "%{_raw}%"
	set {_target} to justicePlayerFromUuid({_targetUuid})
	if {_target} is not set:
		stop
	if justiceCanCuff({_p}, {_target}) is not true:
		set slot 29 of current inventory of {_p} to barrier named "<red><bold>ЗАДЕРЖАТЬ НЕЛЬЗЯ" with lore "<gray>Нельзя задерживать граждан чужой страны"
		stop
	if {justice.cuffed-by::%{_targetUuid}%} is "%uuid of {_p}%":
		set slot 29 of current inventory of {_p} to iron bars named "<aqua><bold>НАРУЧНИКИ" with lore "<green>Игрок задержан вами" and "<yellow>Нажмите для управления"
		stop
	if {justice.cuffed-by::%{_targetUuid}%} is set:
		set slot 29 of current inventory of {_p} to barrier named "<red><bold>УЖЕ ЗАДЕРЖАН"
		stop
	if {justice.cuff-target::%uuid of {_p}%} is set:
		set slot 29 of current inventory of {_p} to barrier named "<red><bold>ВЫ УЖЕ ВЕДЁТЕ ЗАДЕРЖАННОГО"
		stop
	set slot 29 of current inventory of {_p} to iron bars named "<aqua><bold>ЗАДЕРЖАТЬ" with lore "<gray>Надеть наручники" and "<yellow>Нажмите, чтобы задержать"

on inventory open:
	wait 3 ticks
	if player is not online:
		stop
	justiceDecorateMain(player)
	justiceDecorateLawEditor(player)
	justiceDecorateLawList(player)
	justiceDecorateSettings(player)
	justiceDecorateWanted(player)
	justiceDecorateSocial(player)
	set {_title} to name of current inventory of player

	# Восстанавливаем police.menu после переходов между GUI.
	# Иначе wanted.sk рисует предметы, но его обработчик кликов не видит меню.
	if {_title} contains "Розыск страны":
		set {police.menu::%uuid of player%} to "wanted-list"
		stop
	if {_title} contains "Розыск •":
		if {police.selected-target::%uuid of player%} is set:
			set {police.menu::%uuid of player%} to "wanted-detail"
			justiceDecorateWanted(player)
			stop

	if {_title} contains "Наручники •":
		if {justice.cuff-menu-target::%uuid of player%} is set:
			set {justice.menu::%uuid of player%} to "cuff-control"
			set {justice.readonly::%uuid of player%} to true
			stop
	if {police.passport-target::%uuid of player%} is set:
		if {_title} contains "Паспорт игрока":
			set {police.menu::%uuid of player%} to "passport"
			set {justice.readonly::%uuid of player%} to true
			justiceDecoratePassport(player)

# =========================================================
# OWN GUI
# =========================================================

function justiceOpenJailSettings(p: player, id: text):
	set {_menu} to chest inventory with 4 rows named "<dark gray>Тюрьма • %countryName({_id})%"
	loop integers between 0 and 35:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	set slot 4 of {_menu} to iron bars named "<red><bold>КАМЕРЫ" with lore "<gray>%justiceCellCount({_id})%/{@justice-max-cells}"
	set slot 11 of {_menu} to lime dye named "<light green><bold>ДОБАВИТЬ КАМЕРУ"
	set slot 15 of {_menu} to red dye named "<red><bold>УДАЛИТЬ БЛИЖАЙШУЮ"
	set {_slot} to 18
	loop {justice.jail-cell::%{_id}%::*}:
		if {_slot} is greater than 26:
			stop loop
		set {_loc} to loop-value
		set {_x} to floor(x-coordinate of {_loc})
		set {_y} to floor(y-coordinate of {_loc})
		set {_z} to floor(z-coordinate of {_loc})
		set slot {_slot} of {_menu} to iron bars named "<white>Камера %loop-index%" with lore "<gray>%name of world of {_loc}%: <white>%{_x}% %{_y}% %{_z}%"
		add 1 to {_slot}
	set slot 31 of {_menu} to arrow named "<yellow>Назад"
	open {_menu} to {_p}
	set {justice.edit-country::%uuid of {_p}%} to {_id}
	set {justice.menu::%uuid of {_p}%} to "jail-settings"
	set {justice.readonly::%uuid of {_p}%} to true

function justiceOpenConvictions(p: player, targetUuid: text, page: number):
	set {_count} to justiceConvictionCount({_targetUuid})
	set {_max} to floor(({_count} + 27) / 28)
	if {_max} is less than 1:
		set {_max} to 1
	if {_page} is less than 1:
		set {_page} to 1
	if {_page} is greater than {_max}:
		set {_page} to {_max}
	set {_menu} to chest inventory with 6 rows named "<dark gray>Судимости • %policeTargetName({_targetUuid})%"
	loop integers between 0 and 53:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 28, 29, 30, 31, 32, 33, 34, 37, 38, 39, 40, 41, 42 and 43
	set {_start} to ({_page} - 1) * 28 + 1
	set {_end} to {_start} + 27
	if {_end} is greater than {_count}:
		set {_end} to {_count}
	if {_count} is greater than 0:
		loop integers between {_start} and {_end}:
			set {_n} to loop-value
			set {_pos} to loop-value - {_start} + 1
			set {_slot} to {_slots::%{_pos}%}
			set {_country} to {justice.conviction::%{_targetUuid}%::%{_n}%::country}
			set {_law} to {justice.conviction::%{_targetUuid}%::%{_n}%::law}
			set {_stars} to {justice.conviction::%{_targetUuid}%::%{_n}%::stars}
			set {_fine} to {justice.conviction::%{_targetUuid}%::%{_n}%::fine}
			set {_jail} to {justice.conviction::%{_targetUuid}%::%{_n}%::jail}
			set {_date} to {justice.conviction::%{_targetUuid}%::%{_n}%::date}
			set slot {_slot} of {_menu} to written book named "<red><bold>СУДИМОСТЬ №%{_n}%" with lore "<gray>Страна: %countryColor({_country})%%countryName({_country})%" and "<white>%{_law}%" and "" and "<gold>%{_stars}%★ <dark gray>• <yellow>%{_fine}% мон. <dark gray>• <red>%{_jail}% мин." and "<dark gray>%{_date}%"
	else:
		set slot 22 of {_menu} to lime dye named "<light green><bold>СУДИМОСТЕЙ НЕТ"
	if {_page} is greater than 1:
		set slot 45 of {_menu} to arrow named "<yellow>Назад"
	set slot 49 of {_menu} to book named "<white>%{_page}%/%{_max}%"
	if {_page} is less than {_max}:
		set slot 53 of {_menu} to arrow named "<yellow>Далее"
	open {_menu} to {_p}
	set {justice.conviction-target::%uuid of {_p}%} to {_targetUuid}
	set {justice.conviction-page::%uuid of {_p}%} to {_page}
	set {justice.menu::%uuid of {_p}%} to "convictions"
	set {justice.readonly::%uuid of {_p}%} to true

function justiceOpenSentenceLaws(p: player, targetUuid: text, page: number):
	set {_id} to countryId({_p})
	set {_count} to countryLawCount({_id})
	set {_max} to floor(({_count} + 27) / 28)
	if {_max} is less than 1:
		set {_max} to 1
	if {_page} is less than 1:
		set {_page} to 1
	if {_page} is greater than {_max}:
		set {_page} to {_max}
	set {_menu} to chest inventory with 6 rows named "<dark gray>Применить закон"
	loop integers between 0 and 53:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	delete {justice.menu-law::%uuid of {_p}%::*}
	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 28, 29, 30, 31, 32, 33, 34, 37, 38, 39, 40, 41, 42 and 43
	set {_start} to ({_page} - 1) * 28 + 1
	set {_end} to {_start} + 27
	if {_end} is greater than {_count}:
		set {_end} to {_count}
	if {_count} is greater than 0:
		loop integers between {_start} and {_end}:
			set {_law} to loop-value
			set {_pos} to loop-value - {_start} + 1
			set {_slot} to {_slots::%{_pos}%}
			set slot {_slot} of {_menu} to written book named "<yellow><bold>ЗАКОН №%{_law}%" with lore "<white>%{country.law::%{_id}%::%{_law}%}%" and "" and justiceLawPenaltyText({_id}, {_law}) and "" and "<red>Нажмите, чтобы применить"
			set {justice.menu-law::%uuid of {_p}%::%{_slot}%} to {_law}
	else:
		set slot 22 of {_menu} to barrier named "<red>В стране нет законов"
	if {_page} is greater than 1:
		set slot 45 of {_menu} to arrow named "<yellow>Назад"
	set slot 48 of {_menu} to barrier named "<red>Отмена"
	set slot 49 of {_menu} to book named "<white>%{_page}%/%{_max}%"
	if {_page} is less than {_max}:
		set slot 53 of {_menu} to arrow named "<yellow>Далее"
	open {_menu} to {_p}
	set {justice.sentence-target::%uuid of {_p}%} to {_targetUuid}
	set {justice.sentence-page::%uuid of {_p}%} to {_page}
	set {justice.menu::%uuid of {_p}%} to "sentence-law"
	set {justice.readonly::%uuid of {_p}%} to true

# =========================================================
# GUI CLICKS
# =========================================================

on inventory click:
	if event-slot is not set:
		stop
	set {_slot} to raw index of event-slot

	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event
		stop

	if {justice.readonly::%uuid of player%} is true:
		cancel event

	if {country.menu::%uuid of player%} is "main":
		if {_slot} is 36:
			cancel event
			countryOpenStorageHub(player)
			stop
		if {_slot} is 35:
			cancel event
			policeOpenWantedList(player, 1)
			stop

	if {country.menu::%uuid of player%} is "law-editor":
		if {_slot} is 10:
			cancel event
			if countryHasPermission(player, "MANAGE_LAWS") is not true:
				stop
			set {_id} to countryId(player)
			set {_number} to {country.selected-law::%uuid of player%}
			set {_stars} to justiceLawStars({_id}, {_number}) + 1
			if {_stars} is greater than 5:
				set {_stars} to 0
			set {justice.law-stars::%{_id}%::%{_number}%} to {_stars}
			justiceDecorateLawEditor(player)
			stop
		if {_slot} is 12:
			cancel event
			set {justice.input::%uuid of player%} to "LAW_FINE"
			close player's inventory
			send "<yellow>Введите штраф в монетах (0 — без штрафа)." to player
			stop
		if {_slot} is 14:
			cancel event
			set {justice.input::%uuid of player%} to "LAW_JAIL"
			close player's inventory
			send "<yellow>Введите срок тюрьмы в минутах (0 — без тюрьмы)." to player
			stop
		if {_slot} is 16:
			cancel event
			set {justice.input::%uuid of player%} to "LAW_MOVE"
			close player's inventory
			send "<yellow>Введите новый номер закона." to player
			stop
		if {_slot} is 18:
			cancel event
			set {_id} to countryId(player)
			set {_number} to {country.selected-law::%uuid of player%}
			justiceDeleteLaw({_id}, {_number})
			delete {country.selected-law::%uuid of player%}
			countryOpenLaws(player, 1)
			stop

	if {country.menu::%uuid of player%} is "settings":
		if {_slot} is 33:
			cancel event
			set {_id} to countryEditingId(player)
			if justiceCanManageCountry(player, {_id}) is not true:
				send "<red>Тюрьму может настраивать только правитель страны." to player
				stop
			justiceOpenJailSettings(player, {_id})
			stop

	if {police.menu::%uuid of player%} is "passport":
		cancel event
		if {_slot} is 19:
			justiceOpenConvictions(player, {police.passport-target::%uuid of player%}, 1)
			stop
		stop

	if {police.menu::%uuid of player%} is "wanted-detail":
		if {_slot} is 13:
			cancel event
			if policeIsGuard(player) is true:
				justiceOpenSentenceLaws(player, {police.selected-target::%uuid of player%}, 1)
			stop
		if {_slot} is 22:
			cancel event
			if policeIsGuard(player) is not true:
				stop
			set {_id} to countryId(player)
			set {_targetUuid} to {police.selected-target::%uuid of player%}
			set {_target} to justicePlayerFromUuid({_targetUuid})
			if {_target} is not set:
				send "<red>Заключённый должен быть онлайн." to player
				stop
			if distance between player and {_target} is greater than {@justice-arrest-distance}:
				send "<red>Подведите заключённого ближе." to player
				stop
			if {justice.cuffed-by::%{_targetUuid}%} is not "%uuid of player%":
				send "<red>Сначала возьмите игрока в наручники." to player
				stop
			set {_minutes} to {justice.pending-jail::%{_id}%::%{_targetUuid}%}
			if {_minutes} is not set:
				set {_minutes} to 0
			if {_minutes} is less than 1:
				send "<red>Нет назначенного срока." to player
				stop
			set {_cell} to justiceNearestCell({_id}, location of player, {@justice-jail-radius})
			if {_cell} is not set:
				send "<red>В радиусе {@justice-jail-radius} блоков нет настроенной камеры." to player
				stop
			justiceReleaseCuffs({_targetUuid})
			set {justice.prison-country::%{_targetUuid}%} to {_id}
			set {justice.prison-cell::%{_targetUuid}%} to {_cell}
			set {_until} to now
			set {_minutesLeft} to {_minutes}
			while {_minutesLeft} is greater than 0:
				add 1 minute to {_until}
				subtract 1 from {_minutesLeft}
			set {justice.prison-until::%{_targetUuid}%} to {_until}
			delete {justice.pending-jail::%{_id}%::%{_targetUuid}%}
			teleport {_target} to {_cell}
			justiceCreateBossbar({_target})
			close player's inventory
			send formatted "<green>%name of {_target}% помещён в камеру на <white>%{_minutes}% минут<green>." to player
			send formatted "<red><bold>ВЫ ЗАКЛЮЧЕНЫ</bold> <gray>Срок: <white>%{_minutes}% минут<gray>." to {_target}
			stop

	if {social.menu-open::%uuid of player%} is true:
		if {_slot} is 29:
			cancel event
			if policeIsGuard(player) is not true:
				stop
			set {_raw} to {social.menu-target::%uuid of player%}
			if {_raw} is not set:
				stop
			set {_targetUuid} to "%{_raw}%"
			set {_target} to justicePlayerFromUuid({_targetUuid})
			if {_target} is not set:
				send "<red>Игрок больше не в сети." to player
				stop
			if justiceCanCuff(player, {_target}) is not true:
				send "<red>Нельзя задерживать граждан чужой страны." to player
				stop
			if {justice.cuffed-by::%{_targetUuid}%} is "%uuid of player%":
				justiceOpenCuffControl(player, {_target})
				stop
			if {justice.cuffed-by::%{_targetUuid}%} is set:
				send "<red>Игрок уже задержан другим стражником." to player
				stop
			if {justice.cuff-target::%uuid of player%} is set:
				send "<red>Вы уже задержали одного игрока." to player
				stop
			set {justice.cuffed-by::%{_targetUuid}%} to "%uuid of player%"
			set {justice.cuff-target::%uuid of player%} to {_targetUuid}
			set {justice.cuff-mode::%{_targetUuid}%} to "HOLD"
			set {justice.cuff-hold::%{_targetUuid}%} to location of {_target}
			close player's inventory
			play sound "block.chain.place" with volume 1 and pitch 1 at player
			play sound "block.chain.place" with volume 1 and pitch 1 at {_target}
			send formatted "<aqua>Вы надели наручники на <white>%name of {_target}%<aqua>. Игрок зафиксирован на месте." to player
			send "<red><bold>ВЫ ЗАДЕРЖАНЫ</bold> <gray>Вы не можете двигаться и взаимодействовать с миром." to {_target}
			stop

	if {justice.menu::%uuid of player%} is not set:
		stop
	cancel event
	set {_menu} to {justice.menu::%uuid of player%}
	if {_menu} is "jail-settings":
		set {_id} to {justice.edit-country::%uuid of player%}
		if {_slot} is 31:
			delete {justice.menu::%uuid of player%}
			delete {justice.readonly::%uuid of player%}
			countryOpenSettings(player)
			stop
		if {_slot} is 11:
			if justiceCanManageCountry(player, {_id}) is not true:
				stop
			if justiceCellCount({_id}) is greater than or equal to {@justice-max-cells}:
				send "<red>Достигнут лимит камер." to player
				stop
			set {_new} to 1
			while {justice.jail-cell::%{_id}%::%{_new}%} is set:
				add 1 to {_new}
			set {justice.jail-cell::%{_id}%::%{_new}%} to location of player
			justiceOpenJailSettings(player, {_id})
			stop
		if {_slot} is 15:
			set {_bestDistance} to 11
			loop {justice.jail-cell::%{_id}%::*}:
				if world of loop-value is world of player:
					set {_distance} to distance between loop-value and location of player
					if {_distance} is less than {_bestDistance}:
						set {_bestDistance} to {_distance}
						set {_bestIndex} to loop-index
			if {_bestIndex} is not set:
				send "<red>Поблизости нет точки камеры." to player
				stop
			delete {justice.jail-cell::%{_id}%::%{_bestIndex}%}
			justiceOpenJailSettings(player, {_id})
			stop
	if {_menu} is "convictions":
		set {_target} to {justice.conviction-target::%uuid of player%}
		set {_page} to {justice.conviction-page::%uuid of player%}
		if {_slot} is 45:
			justiceOpenConvictions(player, {_target}, {_page} - 1)
			stop
		if {_slot} is 53:
			justiceOpenConvictions(player, {_target}, {_page} + 1)
			stop
		stop
	if {_menu} is "sentence-law":
		set {_target} to {justice.sentence-target::%uuid of player%}
		set {_page} to {justice.sentence-page::%uuid of player%}
		if {_slot} is 45:
			justiceOpenSentenceLaws(player, {_target}, {_page} - 1)
			stop
		if {_slot} is 53:
			justiceOpenSentenceLaws(player, {_target}, {_page} + 1)
			stop
		if {_slot} is 48:
			delete {justice.menu::%uuid of player%}
			delete {justice.readonly::%uuid of player%}
			policeOpenWantedDetail(player, {_target})
			stop
		set {_law} to {justice.menu-law::%uuid of player%::%{_slot}%}
		if {_law} is set:
			justiceApplyLaw(player, {_target}, {_law})
			delete {justice.menu::%uuid of player%}
			delete {justice.readonly::%uuid of player%}
			policeOpenWantedDetail(player, {_target})
			stop
	if {_menu} is "cuff-control":
		set {_targetUuid} to {justice.cuff-menu-target::%uuid of player%}
		set {_target} to justicePlayerFromUuid({_targetUuid})
		if {_target} is not set:
			close player's inventory
			stop
		if {justice.cuffed-by::%{_targetUuid}%} is not "%uuid of player%":
			close player's inventory
			stop
		if {_slot} is 10:
			set {justice.cuff-mode::%{_targetUuid}%} to "FOLLOW"
			delete {justice.cuff-hold::%{_targetUuid}%}
			play sound "block.chain.place" with volume 1 and pitch 1 at player
			send "<yellow>Режим: вести задержанного за собой." to player
			justiceOpenCuffControl(player, {_target})
			stop
		if {_slot} is 12:
			set {justice.cuff-mode::%{_targetUuid}%} to "FREE"
			delete {justice.cuff-hold::%{_targetUuid}%}
			play sound "block.chain.place" with volume 1 and pitch 1 at player
			send "<green>Задержанному разрешено ходить." to player
			justiceOpenCuffControl(player, {_target})
			stop
		if {_slot} is 14:
			set {justice.cuff-mode::%{_targetUuid}%} to "HOLD"
			set {justice.cuff-hold::%{_targetUuid}%} to location of {_target}
			play sound "block.chain.place" with volume 1 and pitch 1 at player
			send "<red>Задержанный зафиксирован на месте." to player
			justiceOpenCuffControl(player, {_target})
			stop
		if {_slot} is 16:
			justiceReleaseCuffs({_targetUuid})
			close player's inventory
			send "<green>Вы сняли наручники." to player
			send "<green>С вас сняли наручники." to {_target}
			stop
		if {_slot} is 22:
			close player's inventory
			stop

on inventory drag:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event
		stop
	if {justice.readonly::%uuid of player%} is true:
		cancel event
		stop
	if {justice.menu::%uuid of player%} is set:
		cancel event
		stop
	if {police.menu::%uuid of player%} is "passport":
		cancel event

# =========================================================
# LAW INPUT
# =========================================================

on chat:
	if {justice.input::%uuid of player%} is not set:
		stop
	cancel event
	set {_mode} to {justice.input::%uuid of player%}
	delete {justice.input::%uuid of player%}
	set {_input} to unformatted message
	set {_id} to countryId(player)
	set {_number} to {country.selected-law::%uuid of player%}
	if countryHasPermission(player, "MANAGE_LAWS") is not true:
		stop
	if {country.law::%{_id}%::%{_number}%} is not set:
		stop
	if {_mode} is "LAW_FINE":
		set {_value} to {_input} parsed as number
		if {_value} is not set:
			send "<red>Введите число." to player
			stop
		set {_value} to rounded down {_value}
		if {_value} is less than 0:
			set {_value} to 0
		if {_value} is greater than {@justice-max-fine}:
			set {_value} to {@justice-max-fine}
		set {justice.law-fine::%{_id}%::%{_number}%} to {_value}
		countryOpenLawEditor(player, {_number})
		stop
	if {_mode} is "LAW_JAIL":
		set {_value} to {_input} parsed as number
		if {_value} is not set:
			send "<red>Введите число." to player
			stop
		set {_value} to rounded down {_value}
		if {_value} is less than 0:
			set {_value} to 0
		if {_value} is greater than {@justice-max-jail-minutes}:
			set {_value} to {@justice-max-jail-minutes}
		set {justice.law-jail::%{_id}%::%{_number}%} to {_value}
		countryOpenLawEditor(player, {_number})
		stop
	if {_mode} is "LAW_MOVE":
		set {_new} to {_input} parsed as number
		if {_new} is not set:
			send "<red>Введите номер." to player
			stop
		set {_new} to rounded down {_new}
		set {_count} to countryLawCount({_id})
		if {_new} is less than 1:
			set {_new} to 1
		if {_new} is greater than {_count}:
			set {_new} to {_count}
		justiceMoveLaw({_id}, {_number}, {_new})
		set {country.selected-law::%uuid of player%} to {_new}
		countryOpenLawEditor(player, {_new})

# =========================================================
# CUFF PHYSICS + RESTRICTIONS
# =========================================================

every 5 ticks:
	loop all players:
		set {_targetUuid} to {justice.cuff-target::%uuid of loop-player%}
		if {_targetUuid} is not set:
			continue
		set {_target} to justicePlayerFromUuid({_targetUuid})
		if {_target} is not set:
			continue
		if {justice.cuffed-by::%{_targetUuid}%} is not "%uuid of loop-player%":
			delete {justice.cuff-target::%uuid of loop-player%}
			continue
		if {justice.cuff-mode::%{_targetUuid}%} is "FOLLOW":
			if world of {_target} is not world of loop-player:
				teleport {_target} to loop-player
			else if distance between {_target} and loop-player is greater than {@justice-cuff-follow-distance}:
				teleport {_target} to loop-player

on player move:
	set {_uuid} to "%uuid of player%"
	if {justice.cuffed-by::%{_uuid}%} is not set:
		stop
	if {justice.cuff-mode::%{_uuid}%} is "HOLD":
		set {_hold} to {justice.cuff-hold::%{_uuid}%}
		if {_hold} is not set:
			set {justice.cuff-hold::%{_uuid}%} to location of player
			stop
		if world of player is not world of {_hold}:
			teleport player to {_hold}
			stop
		if distance between player and {_hold} is greater than 0.15:
			teleport player to {_hold}

on break:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event
		send action bar "<red>Вы в наручниках." to player

on place:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event
		send action bar "<red>Вы в наручниках." to player

on right click:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event
		send action bar "<red>Вы не можете взаимодействовать с миром в наручниках." to player
		stop
	if {justice.prison-until::%uuid of player%} is not in the future:
		stop
	if clicked block is set:
		set {_type} to lowercase "%type of clicked block%"
		if {_type} contains "door":
			cancel event
			send action bar "<red>Вы не можете открывать двери в тюрьме." to player
			stop
	if player's tool is ender pearl:
		cancel event
		send action bar "<red>Телепортация запрещена." to player

on damage:
	if attacker is a player:
		if {justice.cuffed-by::%uuid of attacker%} is set:
			cancel event
			send action bar "<red>Вы не можете атаковать в наручниках." to attacker

on drop:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event

on pickup:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event

on swap hand items:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event

on consume:
	if {justice.cuffed-by::%uuid of player%} is set:
		cancel event
		send action bar "<red>Вы не можете использовать предметы в наручниках." to player
		stop
	if {justice.prison-until::%uuid of player%} is in the future:
		if event-item is chorus fruit:
			cancel event

# =========================================================
# PRISON TIMER / ESCAPE PROTECTION
# =========================================================

every 1 second:
	loop all players:
		set {_until} to {justice.prison-until::%uuid of loop-player%}
		if {_until} is not set:
			continue
		if {_until} is not in the future:
			justiceReleasePrisoner(loop-player)
			continue
		set {_cell} to {justice.prison-cell::%uuid of loop-player%}
		if {_cell} is set:
			if world of loop-player is not world of {_cell}:
				teleport loop-player to {_cell}
			else if distance between loop-player and {_cell} is greater than {@justice-prison-escape-radius}:
				teleport loop-player to {_cell}
				send action bar "<red>Вы не можете покинуть камеру." to loop-player
		set {_remaining} to difference between {_until} and now
		set {_seconds} to seconds of {_remaining}
		set {_minutes} to floor({_seconds} / 60)
		set {_secondsPart} to {_seconds} - ({_minutes} * 60)
		set {_bar} to justiceBossbarId(loop-player)
		set {_value} to {_secondsPart} + 40
		if {_value} is greater than 100:
			set {_value} to 100
		execute console command "bossbar set %{_bar}% value %{_value}%"
		execute console command "bossbar set %{_bar}% name {""text"":""Тюрьма • Осталось: %{_minutes}% мин %{_secondsPart}% сек"",""color"":""red""}"

function justiceDangerousCommand(commandName: text) :: boolean:
	set {_cmd} to lowercase {_commandName}
	if {_cmd} is "tpa":
		return true
	if {_cmd} is "tpaccept":
		return true
	if {_cmd} is "tpahere":
		return true
	if {_cmd} is "rtp":
		return true
	if {_cmd} is "wild":
		return true
	if {_cmd} is "home":
		return true
	if {_cmd} is "sethome":
		return true
	if {_cmd} is "back":
		return true
	if {_cmd} is "spawn":
		return true
	if {_cmd} is "warp":
		return true
	if {_cmd} is "capital":
		return true
	if {_cmd} is "suicide":
		return true
	return false

on command:
	if executor is not a player:
		stop
	set {_uuid} to "%uuid of player%"
	set {_cmd} to command
	if {justice.cuffed-by::%{_uuid}%} is set:
		cancel event
		send "<red>Команды недоступны в наручниках." to player
		stop
	if {justice.prison-until::%{_uuid}%} is in the future:
		if justiceDangerousCommand({_cmd}) is true:
			cancel event
			send "<red>Эта команда недоступна в тюрьме." to player
			stop

# =========================================================
# JOIN / QUIT / CLEANUP
# =========================================================

on join:
	set {_uuid} to "%uuid of player%"
	if {justice.prison-until::%{_uuid}%} is set:
		if {justice.prison-until::%{_uuid}%} is in the future:
			wait 10 ticks
			if {justice.prison-cell::%{_uuid}%} is set:
				teleport player to {justice.prison-cell::%{_uuid}%}
			justiceCreateBossbar(player)
		else:
			wait 10 ticks
			justiceReleasePrisoner(player)
	if {justice.cuffed-by::%{_uuid}%} is set:
		set {_guardUuid} to {justice.cuffed-by::%{_uuid}%}
		if justicePlayerFromUuid({_guardUuid}) is not set:
			justiceReleaseCuffs({_uuid})

on inventory close:
	delete {justice.readonly::%uuid of player%}
	if {justice.menu::%uuid of player%} is set:
		delete {justice.menu::%uuid of player%}

on quit:
	set {_uuid} to "%uuid of player%"
	justiceRemoveBossbar(player)
	set {_targetUuid} to {justice.cuff-target::%{_uuid}%}
	if {_targetUuid} is set:
		justiceReleaseCuffs({_targetUuid})
	delete {justice.menu::%{_uuid}%}
	delete {justice.readonly::%{_uuid}%}
	delete {justice.input::%{_uuid}%}
	delete {justice.edit-country::%{_uuid}%}
	delete {justice.menu-law::%{_uuid}%::*}
	delete {justice.sentence-target::%{_uuid}%}
	delete {justice.sentence-page::%{_uuid}%}
	delete {justice.conviction-target::%{_uuid}%}
	delete {justice.conviction-page::%{_uuid}%}
	delete {justice.cuff-menu-target::%{_uuid}%}
