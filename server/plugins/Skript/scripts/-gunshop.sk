# =========================================================
# GUN SHOP
# =========================================================
#
# ЗОЛОТАЯ МОТЫГА     = ПИСТОЛЕТ
# ЖЕЛЕЗНАЯ МОТЫГА    = АВТОМАТ
# НЕЗЕРИТОВАЯ МОТЫГА = ПУЛЕМЁТ
# ЖЕЛЕЗНЫЙ ТОПОР      = SUPER DUPER GUN
#
# CUSTOM MODEL DATA:
# 1001 = ПИСТОЛЕТ
# 1002 = АВТОМАТ
# 1003 = ПУЛЕМЁТ
# SUPER DUPER GUN пока без отдельной модели
#
# ПКМ = СТРЕЛЬБА
# SHIFT + ПКМ = ПЕРЕЗАРЯДКА
#
# =========================================================
# ОРУЖИЕ
# =========================================================
#
# ПИСТОЛЕТ:
# Урон: 12 HP = 6 сердец
# Магазин: 8
# Скорость: 3
# КД: 1 сек
#
# АВТОМАТ:
# Урон: 6 HP = 3 сердца
# Магазин: 30
# Скорость: 4
# КД: 0.5 сек
#
# ПУЛЕМЁТ:
# Урон: 3 HP = 1.5 сердца
# Магазин: 100
# Скорость: 5
# КД: 0.25 сек
#
# SUPER DUPER GUN:
# Урон: 5 HP = 2.5 сердца
# Магазин: 100
# Скорость: 6
# КД: 0.05 сек
#
# =========================================================


# =========================================================
# GUN SHOP
# =========================================================

command /gunshop:
	permission: op
	trigger:
		set {_gui} to chest inventory with 3 rows named "&0&lGUN SHOP"

		loop integers from 0 to 26:
			set slot loop-number of {_gui} to black stained glass pane named " "

		# =================================================
		# ПИСТОЛЕТ
		# =================================================

		set {_pistol} to golden hoe named "&8&l⚔ Пистолет" with lore "&7Оружие" and "&7" and "&eУрон: &f12 &7(6 сердец)" and "&eМагазин: &f8 патронов" and "&eКД: &f1.0 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"
		set custom model data of {_pistol} to 1001
		set slot 11 of {_gui} to {_pistol}

		# =================================================
		# АВТОМАТ
		# =================================================

		set {_rifle} to iron hoe named "&6&l⚔ Автомат" with lore "&7Оружие" and "&7" and "&eУрон: &f6 &7(3 сердца)" and "&eМагазин: &f30 патронов" and "&eКД: &f0.5 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"
		set custom model data of {_rifle} to 1002
		set slot 13 of {_gui} to {_rifle}

		# =================================================
		# ПУЛЕМЁТ
		# =================================================

		set {_mg} to netherite hoe named "&4&l⚔ Пулемёт" with lore "&7Оружие" and "&7" and "&eУрон: &f3 &7(1.5 сердца)" and "&eМагазин: &f100 патронов" and "&eКД: &f0.25 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"
		set custom model data of {_mg} to 1003
		set slot 15 of {_gui} to {_mg}

		# =================================================
		# SUPER DUPER GUN
		# Под автоматом — слот 22
		# =================================================

		set slot 22 of {_gui} to iron axe named "&b&l⚡ SUPER DUPER GUN" with lore "&7Сверхбыстрое оружие" and "&7" and "&eУрон: &f5 &7(2.5 сердца)" and "&eМагазин: &f100 патронов" and "&eКД: &f0.05 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"

		open {_gui} to player


# =========================================================
# ВЫДАЧА ОРУЖИЯ
# =========================================================

on inventory click:
	if name of event-inventory is "&0&lGUN SHOP":
		cancel event

		# =================================================
		# ПИСТОЛЕТ
		# =================================================

		if index of event-slot is 11:
			close player's inventory

			set {_pistol} to golden hoe named "&8&l⚔ Пистолет" with lore "&7Оружие" and "&7" and "&eУрон: &f12 &7(6 сердец)" and "&eМагазин: &f8 патронов" and "&eКД: &f1.0 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"
			set custom model data of {_pistol} to 1001
			give {_pistol} to player

			set {gun.ammo::%player%::pistol} to 8

			send "&7Оружие &fПистолет &7выдано. &8[&a8/8&8]" to player
			play sound "item.armor.equip_gold" with volume 1 and pitch 1.2 at player

		# =================================================
		# АВТОМАТ
		# =================================================

		if index of event-slot is 13:
			close player's inventory

			set {_rifle} to iron hoe named "&6&l⚔ Автомат" with lore "&7Оружие" and "&7" and "&eУрон: &f6 &7(3 сердца)" and "&eМагазин: &f30 патронов" and "&eКД: &f0.5 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"
			set custom model data of {_rifle} to 1002
			give {_rifle} to player

			set {gun.ammo::%player%::rifle} to 30

			send "&7Оружие &fАвтомат &7выдано. &8[&a30/30&8]" to player
			play sound "item.armor.equip_iron" with volume 1 and pitch 1.2 at player

		# =================================================
		# ПУЛЕМЁТ
		# =================================================

		if index of event-slot is 15:
			close player's inventory

			set {_mg} to netherite hoe named "&4&l⚔ Пулемёт" with lore "&7Оружие" and "&7" and "&eУрон: &f3 &7(1.5 сердца)" and "&eМагазин: &f100 патронов" and "&eКД: &f0.25 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка"
			set custom model data of {_mg} to 1003
			give {_mg} to player

			set {gun.ammo::%player%::mg} to 100

			send "&7Оружие &fПулемёт &7выдано. &8[&a100/100&8]" to player
			play sound "item.armor.equip_netherite" with volume 1 and pitch 1.2 at player

		# =================================================
		# SUPER DUPER GUN
		# =================================================

		if index of event-slot is 22:
			close player's inventory

			give 1 iron axe named "&b&l⚡ SUPER DUPER GUN" with lore "&7Сверхбыстрое оружие" and "&7" and "&eУрон: &f5 &7(2.5 сердца)" and "&eМагазин: &f100 патронов" and "&eКД: &f0.05 сек." and "&7" and "&eПКМ &8» &fВыстрелить" and "&eSHIFT + ПКМ &8» &fПерезарядка" to player

			set {gun.ammo::%player%::super} to 100

			send "&b&lSUPER DUPER GUN &7выдан. &8[&a100/100&8]" to player
			play sound "item.armor.equip_iron" with volume 1 and pitch 1.8 at player


# =========================================================
# СТРЕЛЬБА
# =========================================================

on right click:
	if player's tool is golden hoe or iron hoe or netherite hoe or iron axe:

		set {_name} to name of player's tool

		# =================================================
		# ПИСТОЛЕТ
		# =================================================

		if {_name} is "&8&l⚔ Пистолет":
			set {_type} to "pistol"
			set {_max} to 8
			set {_cooldown} to 20 ticks
			set {_speed} to 3
			set {_damage} to 12
			set {_cooldownText} to "1.0"

		# =================================================
		# АВТОМАТ
		# =================================================

		else if {_name} is "&6&l⚔ Автомат":
			set {_type} to "rifle"
			set {_max} to 30
			set {_cooldown} to 10 ticks
			set {_speed} to 4
			set {_damage} to 6
			set {_cooldownText} to "0.5"

		# =================================================
		# ПУЛЕМЁТ
		# =================================================

		else if {_name} is "&4&l⚔ Пулемёт":
			set {_type} to "mg"
			set {_max} to 100
			set {_cooldown} to 5 ticks
			set {_speed} to 5
			set {_damage} to 3
			set {_cooldownText} to "0.25"

		# =================================================
		# SUPER DUPER GUN
		# =================================================

		else if {_name} is "&b&l⚡ SUPER DUPER GUN":
			set {_type} to "super"
			set {_max} to 100
			set {_cooldown} to 1 tick
			set {_speed} to 6
			set {_damage} to 5
			set {_cooldownText} to "0.05"

		else:
			stop

		cancel event

		# =================================================
		# ПЕРЕЗАРЯДКА
		# =================================================

		if player is sneaking:

			if {gun.reloading::%player%} is set:
				send action bar "&c⚠ &fПЕРЕЗАРЯДКА..." to player
				stop

			if {gun.ammo::%player%::%{_type}%} is {_max}:
				send action bar "&a✔ &fМАГАЗИН ПОЛОН &8[&a%{_max}%/%{_max}%&8]" to player
				play sound "block.note_block.pling" with volume 0.7 and pitch 1.5 at player
				stop

			set {gun.reloading::%player%} to true

			send action bar "&6⚡ &eПЕРЕЗАРЯДКА &8[&e0%%&8]" to player
			play sound "block.piston.extend" with volume 1 and pitch 0.8 at player

			wait 10 ticks

			if {gun.reloading::%player%} is not set:
				stop

			send action bar "&6⚡ &eПЕРЕЗАРЯДКА &8[&e33%%&8]" to player
			play sound "block.note_block.hat" with volume 0.5 and pitch 0.8 at player

			wait 10 ticks

			if {gun.reloading::%player%} is not set:
				stop

			send action bar "&6⚡ &eПЕРЕЗАРЯДКА &8[&e66%%&8]" to player
			play sound "block.note_block.hat" with volume 0.5 and pitch 1 at player

			wait 10 ticks

			if {gun.reloading::%player%} is not set:
				stop

			set {gun.ammo::%player%::%{_type}%} to {_max}

			delete {gun.reloading::%player%}

			send action bar "&a✔ &fПЕРЕЗАРЯЖЕНО! &8[&a%{_max}%/%{_max}%&8]" to player
			play sound "item.armor.equip_generic" with volume 1 and pitch 1.5 at player

			stop

		# =================================================
		# ЕСЛИ ИДЁТ ПЕРЕЗАРЯДКА
		# =================================================

		if {gun.reloading::%player%} is set:
			send action bar "&c⚠ &fПерезарядка..." to player
			stop

		# =================================================
		# ИНИЦИАЛИЗАЦИЯ ПАТРОНОВ
		# =================================================

		if {gun.ammo::%player%::%{_type}%} is not set:
			set {gun.ammo::%player%::%{_type}%} to {_max}

		# =================================================
		# НЕТ ПАТРОНОВ
		# =================================================

		if {gun.ammo::%player%::%{_type}%} <= 0:
			send action bar "&c✖ &fНЕТ ПАТРОНОВ! &7SHIFT + ПКМ — перезарядка" to player
			play sound "block.note_block.bass" with volume 1 and pitch 0.5 at player
			stop

		# =================================================
		# ПРОВЕРКА КД
		# =================================================

		if {gun.next_shot::%player%} is set:

			set {_passed} to difference between now and {gun.next_shot::%player%}

			if {_passed} is less than {_cooldown}:

				set {_remaining} to {_cooldown} - {_passed}
				set {_seconds} to {_remaining} / 20

				send action bar "&c⏳ &fКД: &e%{_seconds}% сек." to player
				stop

		# =================================================
		# ЗАПИСЬ ВРЕМЕНИ ВЫСТРЕЛА
		# =================================================

		set {gun.next_shot::%player%} to now

		# =================================================
		# УМЕНЬШЕНИЕ ПАТРОНОВ
		# =================================================

		remove 1 from {gun.ammo::%player%::%{_type}%}

		# =================================================
		# СОЗДАНИЕ СНАРЯДА
		# =================================================

		shoot snowball from player at speed {_speed}

		set {_proj} to last shot snowball
		set {_uuid} to uuid of {_proj}

		# =================================================
		# ДАННЫЕ СНАРЯДА
		# =================================================

		set {gun.projectile::%{_uuid}%} to player
		set {gun.proj_damage::%{_uuid}%} to {_damage}
		set {gun.proj_type::%{_uuid}%} to {_type}
		set {gun.proj_age::%{_uuid}%} to 0

		# =================================================
		# ЗВУК ВЫСТРЕЛА
		# =================================================

		if {_type} is "pistol":
			play sound "entity.firework_rocket.launch" with volume 1 and pitch 1.8 at player

		else if {_type} is "rifle":
			play sound "entity.firework_rocket.launch" with volume 1 and pitch 1.4 at player

		else if {_type} is "mg":
			play sound "entity.firework_rocket.launch" with volume 1 and pitch 1.1 at player

		else:
			play sound "entity.firework_rocket.launch" with volume 1 and pitch 2 at player

		# =================================================
		# ACTION BAR ВЫСТРЕЛА
		# =================================================

		send action bar "&e⚡ &fВЫСТРЕЛ! &8[&f%{gun.ammo::%player%::%{_type}%}%&8/&f%{_max}%&8] &7| &cКД &8» &e%{_cooldownText}% сек." to player

		# =================================================
		# ТРАССЕР
		# =================================================

		while {_proj} is alive:

			if {gun.projectile::%{_uuid}%} is not set:
				stop

			add 1 to {gun.proj_age::%{_uuid}%}

			if {_type} is "pistol":
				draw 2 flame particles at {_proj}

			else if {_type} is "rifle":
				draw 3 end rod particles at {_proj}

			else if {_type} is "mg":
				draw 3 smoke particles at {_proj}

			else if {_type} is "super":
				draw 3 flame particles at {_proj}

			wait 1 tick


# =========================================================
# ПОПАДАНИЕ СНАРЯДА
# =========================================================

on projectile hit:

	if projectile is snowball:

		set {_uuid} to uuid of projectile

		if {gun.projectile::%{_uuid}%} is set:

			set {_shooter} to {gun.projectile::%{_uuid}%}
			set {_damage} to {gun.proj_damage::%{_uuid}%}
			set {_age} to {gun.proj_age::%{_uuid}%}

			# =================================================
			# ЗАЩИТА ОТ МОМЕНТАЛЬНОГО ПОПАДАНИЯ В СТРЕЛКА
			# =================================================

			if {_age} < 2:
				stop

			set {_hitloc} to location of projectile

			# =================================================
			# УДАЛЕНИЕ ДАННЫХ СНАРЯДА
			# =================================================

			delete {gun.projectile::%{_uuid}%}
			delete {gun.proj_damage::%{_uuid}%}
			delete {gun.proj_type::%{_uuid}%}
			delete {gun.proj_age::%{_uuid}%}

			# =================================================
			# ЭФФЕКТ ПОПАДАНИЯ
			# =================================================

			draw 15 smoke particles at {_hitloc}
			draw 8 flame particles at {_hitloc}

			play sound "entity.generic.explode" with volume 0.5 and pitch 1.5 at {_hitloc}

			# =================================================
			# УРОН ИГРОКАМ
			# =================================================

			loop all players in radius 2 around {_hitloc}:

				if loop-player is not {_shooter}:

					set {_current} to health of loop-player

					if {_current} <= {_damage}:
						set {_realDamage} to {_current}
					else:
						set {_realDamage} to {_damage}

					set {_newhealth} to {_current} - {_damage}

					if {_newhealth} <= 0:
						set health of loop-player to 0
					else:
						set health of loop-player to {_newhealth}

					set {_hearts} to {_realDamage} / 2

					# =================================================
					# СТРЕЛКУ: КТО И СКОЛЬКО ПОЛУЧИЛ
					# =================================================

					send action bar "&c⚔ ПОПАДАНИЕ &8» &f%loop-player% &8- &c%{_realDamage}% HP &7(-%{_hearts}% ❤)" to {_shooter}

					# =================================================
					# ПОПАВШЕМУ: СКОЛЬКО ПОЛУЧИЛ
					# =================================================

					send action bar "&c✖ &f-%{_realDamage}% HP &8» &f%{_shooter}%" to loop-player

					play sound "entity.player.hurt" with volume 1 and pitch 0.7 at loop-player

					draw 5 damage indicator particles at loop-player


			# =================================================
			# УРОН МОБАМ
			# =================================================

			loop all living entities in radius 2 around {_hitloc}:

				if loop-entity is not a player:

					if loop-entity is not {_shooter}:

						set {_mobHealth} to health of loop-entity

						if {_mobHealth} <= {_damage}:
							set {_realMobDamage} to {_mobHealth}
						else:
							set {_realMobDamage} to {_damage}

						# Наносим урон
						damage loop-entity by {_damage}

						set {_mobHearts} to {_realMobDamage} / 2

						# =================================================
						# ГЛАВНОЕ:
						# СООБЩЕНИЕ О ФАКТИЧЕСКОМ ПОПАДАНИИ ПО МОБУ
						# =================================================

						send action bar "&c⚔ ПОПАДАНИЕ &8» &f%loop-entity% &8- &c%{_realMobDamage}% HP &7(-%{_mobHearts}% ❤)" to {_shooter}

						# Дополнительный звук именно стрелку
						play sound "entity.player.attack.strong" with volume 0.8 and pitch 1.2 at {_shooter}

						# Эффект на мобе
						draw 5 damage indicator particles at loop-entity


# =========================================================
# ОЧИСТКА ПРИ ВЫХОДЕ
# =========================================================

on quit:

	delete {gun.ammo::%player%::*}
	delete {gun.reloading::%player%}
	delete {gun.next_shot::%player%}

	loop {gun.projectile::*}:

		if loop-value is player:

			set {_uuid} to loop-index

			delete {gun.projectile::%{_uuid}%}
			delete {gun.proj_damage::%{_uuid}%}
			delete {gun.proj_type::%{_uuid}%}
			delete {gun.proj_age::%{_uuid}%}
