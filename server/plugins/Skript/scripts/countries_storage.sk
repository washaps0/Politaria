	send formatted "<light green>%{_building-name}% улучшено до <white>%{_next}% уровня<light green>." to {_p}

command /cstorage:
	aliases: /cstore, /cwarehouse
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		if countryId(player) is "":
			send "<red>Вы не состоите в стране." to player
			stop
		countryOpenStorageHub(player)

command /cdevelopment:
	aliases: /cdev, /cbuildings
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		if countryId(player) is "":
			send "<red>Вы не состоите в стране." to player
			stop
		countryOpenDevelopment2(player)

on inventory open:
	wait 1 tick
	if player is not online:
		stop
	set {_menu-state} to {country.menu::%uuid of player%}
	set {_inv} to player's current inventory
	if {_menu-state} is "main":
		set {_id} to countryId(player)
		if {_id} is "":
			stop
		set {_level} to countryLevel({_id})
		set {_pages} to countryStoragePages({_id})
		set slot 36 of {_inv} to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Категории и быстрый склад" and "<gray>Занятые слоты общие для всех категорий" and "<gray>Страниц: <white>%{_pages}%/2" and "" and "<yellow>Нажмите, чтобы открыть"
		set slot 37 of {_inv} to beacon named "<aqua><bold>РАЗВИТИЕ СТРАНЫ" with lore "<gray>Уровень страны: <white>%{_level}%/3" and "<gray>Виртуальные здания производят" and "<gray>ресурсы каждый реальный час" and "" and "<yellow>Нажмите, чтобы открыть"
		stop
	if {_menu-state} is "role-editor":
		set {_id} to countryId(player)
		set {_role} to {country.selected-role::%uuid of player%}
		if {_id} is "":
			stop
		if {_role} is not set:
			stop
		if {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT} is true:
			set slot 44 of {_inv} to lime dye named "<light green><bold>РАЗВИТИЕ СТРАНЫ" with lore "<green>РАЗРЕШЕНО" and "<gray>Строить и улучшать здания" and "<gray>и повышать уровень страны."
		else:
			set slot 44 of {_inv} to gray dye named "<gray><bold>РАЗВИТИЕ СТРАНЫ" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Строить и улучшать здания" and "<gray>и повышать уровень страны."
		if {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} is true:
			set slot 46 of {_inv} to lime dye named "<light green><bold>ПОПОЛНЯТЬ ХРАНИЛИЩЕ" with lore "<green>РАЗРЕШЕНО" and "<gray>Класть предметы в склад страны"
		else:
			set slot 46 of {_inv} to gray dye named "<gray><bold>ПОПОЛНЯТЬ ХРАНИЛИЩЕ" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Класть предметы в склад страны"
		if {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} is true:
			set slot 47 of {_inv} to lime dye named "<light green><bold>ЗАБИРАТЬ ИЗ ХРАНИЛИЩА" with lore "<green>РАЗРЕШЕНО" and "<gray>Забирать предметы из склада страны"
		else:
			set slot 47 of {_inv} to gray dye named "<gray><bold>ЗАБИРАТЬ ИЗ ХРАНИЛИЩА" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Забирать предметы из склада страны"

on inventory click:
	if event-slot is not set:
		stop
	set {_menu-state} to {country.menu::%uuid of player%}
	set {_slot} to raw index of event-slot
	if {_menu-state} is "main":
		if {_slot} is 36:
			cancel event
			countryOpenStorageHub(player)
			stop
		if {_slot} is 37:
			cancel event
			countryOpenDevelopment2(player)
			stop
	if {_menu-state} is "role-editor":
		if {_slot} is not 44:
			if {_slot} is not 46:
				if {_slot} is not 47:
					stop
		cancel event
		set {_id} to countryId(player)
		set {_role} to {country.selected-role::%uuid of player%}
		if {_id} is "":
			stop
		if {_role} is not set:
			stop
		if countryHasPermission(player, "MANAGE_ROLES") is not true:
			send "<red>У вас нет права настраивать роли." to player
			stop
		if {_slot} is 44:
			if {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT} to true
		else if {_slot} is 46:
			if {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} to true
		else:
			if {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} to true
		countryOpenRoleEditor(player, {_role})
		stop
	if {_menu-state} is "development2":
		cancel event
		if {_slot} is 40:
			delete {country.building-menu::%uuid of player%::*}
			countryOpenMain(player)
			stop
		if {_slot} is 4:
			countryTryUpgradeLevel2(player)
			countryOpenDevelopment2(player)
			stop
		if {_slot} is 31:
			if countryStorageCanDeposit(player) is not true:
				send "<red>Нужно право пополнять хранилище, чтобы собрать продукцию." to player
				stop
			countryCollectProduction(player)
			countryOpenDevelopment2(player)
			stop
		set {_kind} to {country.building-menu::%uuid of player%::%{_slot}%}
		if {_kind} is set:
			countryTryUpgradeBuilding2(player, {_kind})
			countryOpenDevelopment2(player)
		stop

on load:
	loop {country.name::*}:
		if {country.level::%loop-index%} is not set:
			set {country.level::%loop-index%} to 1
	countryProcessProduction()

every 5 minutes:
	countryProcessProduction()

on quit:
	delete {country.storage-page::%uuid of player%}
	delete {country.building-menu::%uuid of player%::*}

# =========================================================
# COUNTRY STORAGE V5 - GUI AND EVENTS
# =========================================================

function countryStorageQuickDeposit(p: player, category: text, mode: text) :: number:
	set {_id} to countryId({_p})
	if {_id} is "":
		return 0
	if countryStorageCanDeposit({_p}) is not true:
		return 0
	countryStorageMigrate({_id})
	set {_movedTotal} to 0
	set {_slot} to 0
	while {_slot} is less than or equal to 35:
		set {_item} to slot {_slot} of {_p}'s inventory
		if {_item} is set:
			if {_item} is not air:
				set {_allowed} to true
				if {_mode} is "MATCHING":
					set {_typeText} to "%type of {_item}%"
					if countryStorageCategoryHasType({_id}, {_category}, {_typeText}) is not true:
						set {_allowed} to false
				if {_allowed} is true:
					set {_before} to amount of {_item}
					set {_moved} to countryStorageInsertAmount({_id}, {_category}, {_item})
					if {_moved} is greater than 0:
						add {_moved} to {_movedTotal}
						set {_left} to {_before} - {_moved}
						if {_left} is less than or equal to 0:
							set slot {_slot} of {_p}'s inventory to air
						else:
							set amount of {_item} to {_left}
							set slot {_slot} of {_p}'s inventory to {_item}
		add 1 to {_slot}
	return {_movedTotal}

function countryStorageAutoSortPlayer(p: player) :: number:
	set {_id} to countryId({_p})
	if {_id} is "":
		return 0
	if countryStorageCanDeposit({_p}) is not true:
		return 0
	countryStorageMigrate({_id})
	set {_movedTotal} to 0
	set {_slot} to 0
	while {_slot} is less than or equal to 35:
		set {_item} to slot {_slot} of {_p}'s inventory
		if {_item} is set:
			if {_item} is not air:
				set {_typeText} to "%type of {_item}%"
				set {_target} to ""
				if countryStorageCategoryHasType({_id}, "general", {_typeText}) is true:
					set {_target} to "general"
				if {_target} is "":
					loop {country.storage-category-name::%{_id}%::*}:
						set {_cat} to loop-index
						if countryStorageCategoryHasType({_id}, {_cat}, {_typeText}) is true:
							set {_target} to {_cat}
							stop loop
				if {_target} is not "":
					set {_before} to amount of {_item}
					set {_moved} to countryStorageInsertAmount({_id}, {_target}, {_item})
					if {_moved} is greater than 0:
						add {_moved} to {_movedTotal}
						set {_left} to {_before} - {_moved}
						if {_left} is less than or equal to 0:
							set slot {_slot} of {_p}'s inventory to air
						else:
							set amount of {_item} to {_left}
							set slot {_slot} of {_p}'s inventory to {_item}
		add 1 to {_slot}
	return {_movedTotal}

function countryStorageSortCategory(id: text, category: text) :: number:
	countryStorageMigrate({_id})
	delete {_sortKeys::*}
	delete {_sortItems::*}
	delete {_packed::*}
	set {_serial} to 0
	set {_pages} to countryStoragePages({_id})
	set {_page} to 1
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			set {_item} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
			if {_item} is set:
				if {_item} is not air:
					add 1 to {_serial}
					set {_key} to "%type of {_item}%|%{_serial}%"
					set {_sortItems::%{_key}%} to {_item}
					add {_key} to {_sortKeys::*}
			delete {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
			add 1 to {_slot}
		add 1 to {_page}
	if {_serial} is 0:
		return 0
	# Keep insertion order for compatibility with this Skript version.
	loop {_sortKeys::*}:
		set {_item} to {_sortItems::%loop-value%}
		if {_item} is set:
			set {_remaining} to amount of {_item}
			set {_one} to {_item}
			set amount of {_one} to 1
			set {_itemType} to type of {_item}
			set {_limit} to maximum stack size of {_itemType}
			set {_packedIndex} to 1
			while {_packedIndex} is less than or equal to size of {_packed::*}:
				if {_remaining} is greater than 0:
					set {_existing} to {_packed::%{_packedIndex}%}
					set {_existingOne} to {_existing}
					set amount of {_existingOne} to 1
					if {_existingOne} is {_one}:
						set {_existingAmount} to amount of {_existing}
						if {_existingAmount} is less than {_limit}:
							set {_space} to {_limit} - {_existingAmount}
							set {_move} to {_remaining}
							if {_move} is greater than {_space}:
								set {_move} to {_space}
							add {_move} to {_existingAmount}
							set amount of {_existing} to {_existingAmount}
							set {_packed::%{_packedIndex}%} to {_existing}
							subtract {_move} from {_remaining}
				add 1 to {_packedIndex}
			while {_remaining} is greater than 0:
				set {_part} to {_remaining}
				if {_part} is greater than {_limit}:
					set {_part} to {_limit}
				set {_newStack} to {_item}
				set amount of {_newStack} to {_part}
				add {_newStack} to {_packed::*}
				subtract {_part} from {_remaining}
	set {_packedIndex} to 1
	set {_page} to 1
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			if {_packedIndex} is less than or equal to size of {_packed::*}:
				set {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%} to {_packed::%{_packedIndex}%}
				add 1 to {_packedIndex}
			add 1 to {_slot}
		add 1 to {_page}
	return size of {_packed::*}

function countryStorageSyncInventory(p: player, id: text, category: text, page: number, inventoryToSync: inventory):
	if {_id} is "":
		stop
	if {_category} is not set:
		stop
	if {_page} is less than 1:
		stop

	# Capacity uses item units: 64 items = 1 storage stack.
	# A sword/armor piece therefore uses only 1/64 of a capacity stack.
	set {_oldPageItems} to 0
	set {_slot} to 0
	while {_slot} is less than or equal to 44:
		set {_old} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
		if {_old} is set:
			if {_old} is not air:
				add amount of {_old} to {_oldPageItems}
		add 1 to {_slot}

	set {_otherItems} to countryStorageUsedItems({_id}) - {_oldPageItems}
	set {_allowedOnPage} to countryStorageMaxItems({_id}) - {_otherItems}
	if {_allowedOnPage} is less than {_oldPageItems}:
		set {_allowedOnPage} to {_oldPageItems}

	set {_shownItems} to 0
	set {_slot} to 0
	while {_slot} is less than or equal to 44:
		set {_shown} to slot {_slot} of {_inventoryToSync}
		if {_shown} is set:
			if {_shown} is not air:
				add amount of {_shown} to {_shownItems}
		add 1 to {_slot}

	set {_overflow} to {_shownItems} - {_allowedOnPage}
	if {_overflow} is greater than 0:
		set {_slot} to 44
		while {_slot} is greater than or equal to 0:
			if {_overflow} is greater than 0:
				set {_shown} to slot {_slot} of {_inventoryToSync}
				set {_old} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
				if {_shown} is set:
					if {_shown} is not air:
						set {_added} to amount of {_shown}
						if {_old} is set:
							if {_old} is not air:
								set {_shownOne} to {_shown}
								set {_oldOne} to {_old}
								set amount of {_shownOne} to 1
								set amount of {_oldOne} to 1
								if {_shownOne} is {_oldOne}:
									set {_added} to amount of {_shown} - amount of {_old}
									if {_added} is less than 0:
										set {_added} to 0
						if {_added} is greater than 0:
							set {_returnAmount} to {_added}
							if {_returnAmount} is greater than {_overflow}:
								set {_returnAmount} to {_overflow}
							set {_leftAmount} to amount of {_shown} - {_returnAmount}
							set {_returned} to {_shown}
							set amount of {_returned} to {_returnAmount}
							give {_returned} to {_p}
							if {_leftAmount} is less than or equal to 0:
								set slot {_slot} of {_inventoryToSync} to air
							else:
								set amount of {_shown} to {_leftAmount}
								set slot {_slot} of {_inventoryToSync} to {_shown}
							subtract {_returnAmount} from {_overflow}
			subtract 1 from {_slot}

	set {_slot} to 0
	while {_slot} is less than or equal to 44:
		set {_shown} to slot {_slot} of {_inventoryToSync}
		if {_shown} is set:
			if {_shown} is not air:
				set {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%} to {_shown}
			else:
				delete {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
		else:
			delete {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
		add 1 to {_slot}

function countryOpenStorageHub(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		send "<red>Вы не состоите в стране." to {_p}
		stop
	countryStorageMigrate({_id})
	delete {country.storage5-menu-category::%uuid of {_p}%::*}
	delete {country.storage5-current-category::%uuid of {_p}%}
	delete {country.storage5-current-page::%uuid of {_p}%}
	set {_menu} to chest inventory with 6 rows named "<dark gray>Хранилище страны"
	set {_slot} to 0
	while {_slot} is less than or equal to 53:
		set slot {_slot} of {_menu} to gray stained glass pane named " "
		add 1 to {_slot}
	set {_usedItems} to countryStorageUsedItems({_id})
	set {_maxItems} to countryStorageMaxItems({_id})
	set {_maxStacks} to countryStorageMaxSlots({_id})
	set slot 4 of {_menu} to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Предметов: <white>%{_usedItems}%/%{_maxItems}%" and "<gray>Вместимость: <white>%{_maxStacks}% стаков по 64" and "<gray>Нестакаемые предметы тоже считаются по 1/64 стака."
	set {_generalUsed} to countryStorageCategorySlots({_id}, "general")
	set slot 10 of {_menu} to chest named "<white><bold>ОБЩЕЕ" with lore "<gray>Занято: <white>%{_generalUsed}% стаков" and "" and "<yellow>Нажмите, чтобы открыть"
	set {country.storage5-menu-category::%uuid of {_p}%::10} to "general"
	set {_slots::*} to 11, 12, 13, 14, 15, 16, 19 and 20
	set {_position} to 1
	loop {country.storage-category-name::%{_id}%::*}:
		if {_position} is greater than size of {_slots::*}:
			stop loop
		set {_cat} to loop-index
		set {_menuSlot} to {_slots::%{_position}%}
		set {_catUsed} to countryStorageCategorySlots({_id}, {_cat})
		set {_icon} to {country.storage-category-icon::%{_id}%::%{_cat}%}
		if {_icon} is not set:
			set {_icon} to barrel
		set {_displayIcon} to {_icon}
		set amount of {_displayIcon} to 1
		set name of {_displayIcon} to "<yellow><bold>%loop-value%"
		set lore of {_displayIcon} to "<gray>Занято: <white>%{_catUsed}% стаков" and "" and "<yellow>Нажмите, чтобы открыть"
		set slot {_menuSlot} of {_menu} to {_displayIcon}
		set {country.storage5-menu-category::%uuid of {_p}%::%{_menuSlot}%} to {_cat}
		add 1 to {_position}
	if countryStorageCanManageCategories({_p}) is true:
		if countryStorageCategoryCount({_id}) is less than 9:
			set slot 31 of {_menu} to name tag named "<light green><bold>СОЗДАТЬ КАТЕГОРИЮ" with lore "<gray>Максимум 9 категорий вместе с Общим" and "" and "<yellow>Нажмите, чтобы создать"
	if countryStorageCanDeposit({_p}) is true:
		set slot 32 of {_menu} to hopper named "<aqua><bold>АВТОСОРТИРОВКА" with lore "<gray>Предметы отправятся в категорию," and "<gray>где уже есть такой тип предмета." and "<gray>Остальные предметы останутся у вас."
		set slot 33 of {_menu} to chest named "<light green><bold>СЛОЖИТЬ ВСЁ В ОБЩЕЕ"
	set slot 45 of {_menu} to arrow named "<yellow>Назад"
	open {_menu} to {_p}
	set {country.menu::%uuid of {_p}%} to "storage-hub"

function countryOpenStorageCategory(p: player, category: text, page: number):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	countryStorageMigrate({_id})
	if {_category} is not "general":
		if {country.storage-category-name::%{_id}%::%{_category}%} is not set:
			countryOpenStorageHub({_p})
			stop
	set {_pages} to countryStoragePages({_id})
	if {_page} is less than 1:
		set {_page} to 1
	if {_page} is greater than {_pages}:
		set {_page} to {_pages}
	set {_name} to countryStorageCategoryName({_id}, {_category})
	set {_menu} to chest inventory with 6 rows named "<dark gray>%{_name}% • %{_page}%/%{_pages}%"
	set {_slot} to 0
	while {_slot} is less than or equal to 44:
		set {_stored} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
		if {_stored} is set:
			set slot {_slot} of {_menu} to {_stored}
		else:
			set slot {_slot} of {_menu} to air
		add 1 to {_slot}
	set {_slot} to 45
	while {_slot} is less than or equal to 53:
		set slot {_slot} of {_menu} to gray stained glass pane named " "
		add 1 to {_slot}
	set slot 45 of {_menu} to arrow named "<yellow>К категориям"
	if {_page} is greater than 1:
		set slot 46 of {_menu} to arrow named "<yellow>Предыдущая страница"
	if {_category} is not "general":
		if countryStorageCanManageCategories({_p}) is true:
			set slot 47 of {_menu} to name tag named "<yellow><bold>ПЕРЕИМЕНОВАТЬ"
			if countryStorageCategorySlots({_id}, {_category}) is 0:
				set slot 48 of {_menu} to barrier named "<red><bold>УДАЛИТЬ КАТЕГОРИЮ"
			set {_savedIcon} to {country.storage-category-icon::%{_id}%::%{_category}%}
			if {_savedIcon} is set:
				set {_iconButton} to {_savedIcon}
			else:
				set {_iconButton} to item frame
			set amount of {_iconButton} to 1
			set name of {_iconButton} to "<aqua><bold>ИКОНКА КАТЕГОРИИ"
			set lore of {_iconButton} to "<gray>Возьмите предмет в основную руку" and "<gray>и нажмите сюда, чтобы сделать" and "<gray>его иконкой категории." and "" and "<yellow>Пустая рука — сбросить иконку"
			set slot 50 of {_menu} to {_iconButton}
	set {_totalItems} to countryStorageUsedItems({_id})
	set {_maxItems} to countryStorageMaxItems({_id})
	set {_categoryItems} to countryStorageCategoryItems({_id}, {_category})
	set slot 49 of {_menu} to barrel named "<gold><bold>%{_name}%" with lore "<gray>В категории: <white>%{_categoryItems}% предметов" and "<gray>Всего: <white>%{_totalItems}%/%{_maxItems}% предметов" and "" and "<gray>64 предмета = 1 стак вместимости." and "<gray>Нестакаемые предметы считаются так же." and "<gray>Роли только с одним правом используют Shift-клик." and "" and "<aqua>Нажмите, чтобы отсортировать как ClientSort"
	if countryStorageCanDeposit({_p}) is true:
		set slot 51 of {_menu} to hopper named "<aqua><bold>СЛОЖИТЬ ПОХОЖЕЕ"
		set slot 52 of {_menu} to chest named "<light green><bold>СЛОЖИТЬ ВСЁ"
	if {_page} is less than {_pages}:
		set slot 53 of {_menu} to arrow named "<yellow>Следующая страница"
	open {_menu} to {_p}
	set {country.storage5-current-category::%uuid of {_p}%} to {_category}
	set {country.storage5-current-page::%uuid of {_p}%} to {_page}
	set {country.menu::%uuid of {_p}%} to "storage-category"

on chat:
	if {country.storage5-input::%uuid of player%} is not set:
		stop
	cancel event
	set {_mode} to {country.storage5-input::%uuid of player%}
	delete {country.storage5-input::%uuid of player%}
	set {_id} to countryId(player)
	if {_id} is "":
		stop
	set {_input} to message
	if length of {_input} is less than 1:
		send "<red>Название не может быть пустым." to player
		stop
	if length of {_input} is greater than 20:
		send "<red>Название категории не должно быть длиннее 20 символов." to player
		stop
	if {_mode} is "create":
		if countryStorageCanManageCategories(player) is not true:
			stop
		if countryStorageCategoryCount({_id}) is greater than or equal to 9:
			stop
		if {country.storage-category-seq::%{_id}%} is not set:
			set {country.storage-category-seq::%{_id}%} to 0
		add 1 to {country.storage-category-seq::%{_id}%}
		set {_seq} to {country.storage-category-seq::%{_id}%}
		set {_cat} to "c%{_seq}%"
		set {country.storage-category-name::%{_id}%::%{_cat}%} to {_input}
		wait 1 tick
		countryOpenStorageHub(player)
		stop
	if {_mode} is "rename":
		set {_cat} to {country.storage5-rename-category::%uuid of player%}
		delete {country.storage5-rename-category::%uuid of player%}
		if {_cat} is not set:
			stop
		if {_cat} is "general":
			stop
		if countryStorageCanManageCategories(player) is not true:
			stop
		set {country.storage-category-name::%{_id}%::%{_cat}%} to {_input}
		wait 1 tick
		countryOpenStorageCategory(player, {_cat}, 1)

on inventory click:
	set {_state} to {country.menu::%uuid of player%}
	if {_state} is "storage-hub":
		cancel event
		if event-slot is not set:
			stop
		set {_raw} to raw index of event-slot
		set {_cat} to {country.storage5-menu-category::%uuid of player%::%{_raw}%}
		if {_cat} is set:
			countryOpenStorageCategory(player, {_cat}, 1)
			stop
		if {_raw} is 31:
			if countryStorageCanManageCategories(player) is true:
				set {country.storage5-input::%uuid of player%} to "create"
				close player's inventory
				send "<yellow>Введите название новой категории в чат." to player
			stop
		if {_raw} is 32:
			if countryStorageCanDeposit(player) is true:
				set {_moved} to countryStorageAutoSortPlayer(player)
				send formatted "<green>Перемещено предметов: <white>%{_moved}%" to player
				countryOpenStorageHub(player)
			stop
		if {_raw} is 33:
			if countryStorageCanDeposit(player) is true:
				set {_moved} to countryStorageQuickDeposit(player, "general", "ALL")
				send formatted "<green>Перемещено предметов: <white>%{_moved}%" to player
				countryOpenStorageHub(player)
			stop
		if {_raw} is 45:
			countryOpenMain(player)
			stop
		stop

	if {_state} is not "storage-category":
		stop
	if event-slot is not set:
		stop
	set {_raw} to raw index of event-slot
	set {_id} to countryId(player)
	set {_cat} to {country.storage5-current-category::%uuid of player%}
	set {_page} to {country.storage5-current-page::%uuid of player%}
	if {_id} is "":
		cancel event
		stop
	if {_cat} is not set:
		cancel event
		stop
	if {_page} is not set:
		cancel event
		stop

	# Bottom row is controls only.
	if {_raw} is between 45 and 53:
		cancel event
		set {_openInventory} to player's current inventory
		countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})
		if {_raw} is 45:
			countryOpenStorageHub(player)
			stop
		if {_raw} is 46:
			if {_page} is greater than 1:
				countryOpenStorageCategory(player, {_cat}, {_page} - 1)
			stop
		if {_raw} is 47:
			if {_cat} is not "general":
				if countryStorageCanManageCategories(player) is true:
					set {country.storage5-rename-category::%uuid of player%} to {_cat}
					set {country.storage5-input::%uuid of player%} to "rename"
					close player's inventory
					send "<yellow>Введите новое название категории в чат." to player
			stop
		if {_raw} is 48:
			if {_cat} is not "general":
				if countryStorageCanManageCategories(player) is true:
					if countryStorageCategorySlots({_id}, {_cat}) is 0:
						delete {country.storage-category-name::%{_id}%::%{_cat}%}
						delete {country.storage-category-icon::%{_id}%::%{_cat}%}
						delete {country.storage5::%{_id}%::%{_cat}%::*}
						countryOpenStorageHub(player)
			stop
		if {_raw} is 49:
			set {_sortedStacks} to countryStorageSortCategory({_id}, {_cat})
			send formatted "<aqua>Категория отсортирована. <gray>Стаков: <white>%{_sortedStacks}%" to player
			countryOpenStorageCategory(player, {_cat}, 1)
			stop
		if {_raw} is 50:
			if {_cat} is not "general":
				if countryStorageCanManageCategories(player) is true:
					set {_held} to player's tool
					if {_held} is set:
						if {_held} is not air:
							set {_icon} to {_held}
							set amount of {_icon} to 1
							set {country.storage-category-icon::%{_id}%::%{_cat}%} to {_icon}
							send "<green>Иконка категории изменена." to player
							countryOpenStorageCategory(player, {_cat}, {_page})
							stop
					delete {country.storage-category-icon::%{_id}%::%{_cat}%}
					send "<yellow>Иконка категории сброшена." to player
					countryOpenStorageCategory(player, {_cat}, {_page})
			stop
		if {_raw} is 51:
			if countryStorageCanDeposit(player) is true:
				set {_moved} to countryStorageQuickDeposit(player, {_cat}, "MATCHING")
				countryOpenStorageCategory(player, {_cat}, {_page})
			stop
		if {_raw} is 52:
			if countryStorageCanDeposit(player) is true:
				set {_moved} to countryStorageQuickDeposit(player, {_cat}, "ALL")
				countryOpenStorageCategory(player, {_cat}, {_page})
			stop
		if {_raw} is 53:
			if {_page} is less than countryStoragePages({_id}):
				countryOpenStorageCategory(player, {_cat}, {_page} + 1)
			stop
		stop

	set {_canDeposit} to countryStorageCanDeposit(player)
	set {_canWithdraw} to countryStorageCanWithdraw(player)
	set {_openInventory} to player's current inventory

	# Full-right users get normal chest behaviour.
	if {_canDeposit} is true:
		if {_canWithdraw} is true:
			wait 1 tick
			countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})
			stop

	# Single-right roles deliberately use Shift-click only. This prevents bypassing permissions with the cursor.
	if {_raw} is between 0 and 44:
		if click type is left mouse button with shift:
			if {_canWithdraw} is true:
				wait 1 tick
				countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})
				stop
		if click type is right mouse button with shift:
			if {_canWithdraw} is true:
				wait 1 tick
				countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})
				stop
		cancel event
		stop

	if {_raw} is greater than or equal to 54:
		if click type is left mouse button with shift:
			if {_canDeposit} is true:
				wait 1 tick
				countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})
				stop
		if click type is right mouse button with shift:
			if {_canDeposit} is true:
				wait 1 tick
				countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})
				stop
		cancel event
		stop

on inventory drag:
	if {country.menu::%uuid of player%} is not "storage-category":
		stop
	if countryStorageCanDeposit(player) is not true:
		cancel event
		stop
	set {_id} to countryId(player)
	set {_cat} to {country.storage5-current-category::%uuid of player%}
	set {_page} to {country.storage5-current-page::%uuid of player%}
	set {_openInventory} to player's current inventory
	if {_id} is "":
		cancel event
		stop
	if {_cat} is not set:
		cancel event
		stop
	wait 1 tick
	countryStorageSyncInventory(player, {_id}, {_cat}, {_page}, {_openInventory})

on quit:
	delete {country.storage5-menu-category::%uuid of player%::*}
	delete {country.storage5-current-category::%uuid of player%}
	delete {country.storage5-current-page::%uuid of player%}
	delete {country.storage5-input::%uuid of player%}
	delete {country.storage5-rename-category::%uuid of player%}
