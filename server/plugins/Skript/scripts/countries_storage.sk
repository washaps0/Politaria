# =========================================================
# POLITARIA COUNTRY STORAGE
# Extension for countries.sk
# Two pages, 45 slots each.
# Role permissions:
#   STORAGE_DEPOSIT  - put items into country storage
#   STORAGE_WITHDRAW - take items from country storage
# =========================================================

function countryStorageCanDeposit(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "STORAGE_DEPOSIT") is true:
		return true
	return false

function countryStorageCanWithdraw(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "STORAGE_WITHDRAW") is true:
		return true
	return false

function countryStorageGlobalSlot(page: number, localSlot: number) :: number:
	return ({_page} - 1) * 45 + {_localSlot}

function countryStorageFindFreeSlot(id: text, page: number) :: number:
	loop integers between 0 and 44:
		set {_global} to countryStorageGlobalSlot({_page}, loop-value)
		if {country.storage::%{_id}%::%{_global}%} is not set:
			return loop-value
	return -1

function countryStorageRefreshRoleButtons(p: player):
	if {country.menu::%uuid of {_p}%} is not "role-editor":
		stop
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	set {_role} to {country.selected-role::%uuid of {_p}%}
	if {_role} is not set:
		stop

	if {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} is true:
		set slot 46 of {_p}'s current inventory to lime dye named "<light green><bold>ПОПОЛНЯТЬ ХРАНИЛИЩЕ" with lore "<green>РАЗРЕШЕНО" and "<gray>Роль может класть вещи" and "<gray>в общее хранилище страны." and "" and "<yellow>Нажмите, чтобы запретить"
	else:
		set slot 46 of {_p}'s current inventory to gray dye named "<gray><bold>ПОПОЛНЯТЬ ХРАНИЛИЩЕ" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Роль не может класть вещи" and "<gray>в общее хранилище страны." and "" and "<yellow>Нажмите, чтобы разрешить"

	if {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} is true:
		set slot 47 of {_p}'s current inventory to lime dye named "<light green><bold>ЗАБИРАТЬ ИЗ ХРАНИЛИЩА" with lore "<green>РАЗРЕШЕНО" and "<gray>Роль может забирать вещи" and "<gray>из общего хранилища страны." and "" and "<yellow>Нажмите, чтобы запретить"
	else:
		set slot 47 of {_p}'s current inventory to gray dye named "<gray><bold>ЗАБИРАТЬ ИЗ ХРАНИЛИЩА" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Роль не может забирать вещи" and "<gray>из общего хранилища страны." and "" and "<yellow>Нажмите, чтобы разрешить"

function countryOpenStorage(p: player, page: number):
	set {_id} to countryId({_p})
	if {_id} is "":
		send "<red>Вы не состоите в стране." to {_p}
		stop
	if {_page} is less than 1:
		set {_page} to 1
	if {_page} is greater than 2:
		set {_page} to 2

	set {_menu} to chest inventory with 6 rows named "<dark gray>Хранилище страны • %{_page}%/2"
	loop integers between 0 and 53:
		set slot loop-value of {_menu} to gray stained glass pane named " "

	# 45 actual storage slots.
	loop integers between 0 and 44:
		set {_global} to countryStorageGlobalSlot({_page}, loop-value)
		if {country.storage::%{_id}%::%{_global}%} is set:
			set slot loop-value of {_menu} to {country.storage::%{_id}%::%{_global}%}
		else:
			set slot loop-value of {_menu} to air

	if {_page} is 2:
		set slot 45 of {_menu} to arrow named "<yellow>Предыдущая страница"
	else:
		set slot 45 of {_menu} to gray dye named "<dark gray>Предыдущая страница"

	set slot 48 of {_menu} to barrier named "<red>Назад"

	set {_deposit-text} to "<red>НЕТ"
	if countryStorageCanDeposit({_p}) is true:
		set {_deposit-text} to "<light green>ДА"
	set {_withdraw-text} to "<red>НЕТ"
	if countryStorageCanWithdraw({_p}) is true:
		set {_withdraw-text} to "<light green>ДА"

	set slot 49 of {_menu} to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Страница: <white>%{_page}%/2" and "" and "<gray>Пополнять: %{_deposit-text}%" and "<gray>Забирать: %{_withdraw-text}%" and "" and "<dark gray>Нажмите на предмет в своём инвентаре," and "<dark gray>чтобы положить весь стак." and "<dark gray>Нажмите на предмет сверху," and "<dark gray>чтобы забрать весь стак."

	if {_page} is 1:
		set slot 53 of {_menu} to arrow named "<yellow>Следующая страница"
	else:
		set slot 53 of {_menu} to gray dye named "<dark gray>Следующая страница"

	set {country.storage-page::%uuid of {_p}%} to {_page}
	open {_menu} to {_p}
	set {country.menu::%uuid of {_p}%} to "storage"

command /cstorage:
	aliases: /cstore, /cwarehouse
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		if countryId(player) is "":
			send "<red>Вы не состоите в стране." to player
			stop
		countryOpenStorage(player, 1)

on inventory open:
	wait 1 tick
	if player is not online:
		stop
	set {_menu} to {country.menu::%uuid of player%}
	if {_menu} is "main":
		set slot 36 of player's current inventory to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Общее хранилище страны" and "<gray>2 страницы • 90 ячеек" and "" and "<yellow>Нажмите, чтобы открыть"
		stop
	if {_menu} is "role-editor":
		countryStorageRefreshRoleButtons(player)

on inventory click:
	set {_menu} to {country.menu::%uuid of player%}

	if {_menu} is "main":
		if raw index of event-slot is 36:
			cancel event
			countryOpenStorage(player, 1)
			stop

	if {_menu} is "role-editor":
		set {_raw} to raw index of event-slot
		if {_raw} is not 46:
			if {_raw} is not 47:
				stop
		cancel event
		set {_id} to countryId(player)
		set {_role} to {country.selected-role::%uuid of player%}
		if {_id} is "":
			stop
		if {_role} is not set:
			stop
		if countryHasPermission(player, "MANAGE_ROLES") is not true:
			send "<red>У вас нет права настраивать роли." to player
			stop
		if {_raw} is 46:
			if {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} to true
		else:
			if {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} to true
		countryStorageRefreshRoleButtons(player)
		stop

	if {_menu} is not "storage":
		stop
	cancel event
	if event-slot is not set:
		stop

	set {_raw} to raw index of event-slot
	set {_id} to countryId(player)
	if {_id} is "":
		close player's inventory
		stop
	set {_page} to {country.storage-page::%uuid of player%}
	if {_page} is not set:
		set {_page} to 1

	if {_raw} is 45:
		if {_page} is 2:
			countryOpenStorage(player, 1)
		stop
	if {_raw} is 48:
		countryOpenMain(player)
		stop
	if {_raw} is 49:
		stop
	if {_raw} is 53:
		if {_page} is 1:
			countryOpenStorage(player, 2)
		stop

	if {_raw} is between 0 and 44:
		if countryStorageCanWithdraw(player) is not true:
			send action bar "<red>У вашей роли нет права забирать вещи из хранилища." to player
			stop
		set {_global} to countryStorageGlobalSlot({_page}, {_raw})
		set {_stored} to {country.storage::%{_id}%::%{_global}%}
		if {_stored} is not set:
			stop
		give {_stored} to player
		delete {country.storage::%{_id}%::%{_global}%}
		set slot {_raw} of player's current inventory to air
		stop

	if {_raw} is greater than or equal to 54:
		if countryStorageCanDeposit(player) is not true:
			send action bar "<red>У вашей роли нет права пополнять хранилище." to player
			stop
		set {_item} to event-slot's item
		if {_item} is not set:
			stop
		if {_item} is air:
			stop
		set {_free} to countryStorageFindFreeSlot({_id}, {_page})
		if {_free} is less than 0:
			send action bar "<red>На этой странице нет свободных ячеек." to player
			stop
		set {_global} to countryStorageGlobalSlot({_page}, {_free})
		set {country.storage::%{_id}%::%{_global}%} to {_item}
		set slot {_free} of player's current inventory to {_item}
		set event-slot to air
		stop

on inventory drag:
	if {country.menu::%uuid of player%} is "storage":
		cancel event

on quit:
	delete {country.storage-page::%uuid of player%}
