# =========================================================
# POLITARIA COUNTRY STORAGE + PROGRESSION
# Country storage V5 - clean implementation from scratch
# =========================================================
# Canonical storage data:
# {country.storage5::<country>::<category>::<page>::<slot>} = item
#
# Top GUI slots 0..44 are real storage slots.
# Bottom GUI slots 45..53 are controls only.
# Country level I: 45 occupied stacks total across all categories.
# Country level II+: 90 occupied stacks total across all categories.
# =========================================================

function countryLevel(id: text) :: number:
	if {country.level::%{_id}%} is set:
		return {country.level::%{_id}%}
	return 1

function countryStoragePages(id: text) :: number:
	if countryLevel({_id}) is greater than or equal to 2:
		return 2
	return 1

function countryStorageMaxSlots(id: text) :: number:
	if countryLevel({_id}) is greater than or equal to 2:
		return 90
	return 45

function countryStorageMaxItems(id: text) :: number:
	return countryStorageMaxSlots({_id}) * 64

function countryStorageCanDeposit(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "STORAGE_DEPOSIT") is true:
		return true
	return false

function countryStorageCanWithdraw(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "STORAGE_WITHDRAW") is true:
		return true
	return false

function countryCanManageDevelopment(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "MANAGE_DEVELOPMENT") is true:
		return true
	return false

function countryStorageCanManageCategories(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "MANAGE_DEVELOPMENT") is true:
		return true
	return false

function countryStorageCategoryName(id: text, category: text) :: text:
	if {_category} is "general":
		return "Общее"
	if {country.storage-category-name::%{_id}%::%{_category}%} is set:
		return {country.storage-category-name::%{_id}%::%{_category}%}
	return "Категория"

function countryStorageCategoryCount(id: text) :: number:
	set {_count} to 1
	loop {country.storage-category-name::%{_id}%::*}:
		add 1 to {_count}
	return {_count}

function countryStoragePageSlots(id: text, category: text, page: number) :: number:
	set {_used} to 0
	set {_slot} to 0
	while {_slot} is less than or equal to 44:
		set {_item} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
		if {_item} is set:
			if {_item} is not air:
				add 1 to {_used}
		add 1 to {_slot}
	return {_used}

function countryStorageCategorySlots(id: text, category: text) :: number:
	set {_used} to 0
	set {_page} to 1
	set {_pages} to countryStoragePages({_id})
	while {_page} is less than or equal to {_pages}:
		add countryStoragePageSlots({_id}, {_category}, {_page}) to {_used}
		add 1 to {_page}
	return {_used}

function countryStorageCategoryItems(id: text, category: text) :: number:
	set {_count} to 0
	set {_page} to 1
	set {_pages} to countryStoragePages({_id})
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			set {_item} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
			if {_item} is set:
				if {_item} is not air:
					add amount of {_item} to {_count}
			add 1 to {_slot}
		add 1 to {_page}
	return {_count}

function countryStorageUsedItems(id: text) :: number:
	set {_used} to countryStorageCategoryItems({_id}, "general")
	loop {country.storage-category-name::%{_id}%::*}:
		set {_cat} to loop-index
		add countryStorageCategoryItems({_id}, {_cat}) to {_used}
	return {_used}

function countryStorageUsedSlots(id: text) :: number:
	set {_used} to countryStorageCategorySlots({_id}, "general")
	loop {country.storage-category-name::%{_id}%::*}:
		set {_cat} to loop-index
		add countryStorageCategorySlots({_id}, {_cat}) to {_used}
	return {_used}

function countryStorageCategoryHasType(id: text, category: text, typeText: text) :: boolean:
	set {_wanted} to {_typeText} parsed as item type
	if {_wanted} is not set:
		return false
	set {_page} to 1
	set {_pages} to countryStoragePages({_id})
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			set {_item} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
			if {_item} is set:
				if type of {_item} is {_wanted}:
					return true
			add 1 to {_slot}
		add 1 to {_page}
	return false

function countryStorageInsertAmount(id: text, category: text, stack: item) :: number:
	set {_item} to {_stack}
	if {_item} is not set:
		return 0
	if {_item} is air:
		return 0
	set {_original} to amount of {_item}
	set {_freeItems} to countryStorageMaxItems({_id}) - countryStorageUsedItems({_id})
	if {_freeItems} is less than or equal to 0:
		return 0
	set {_toStore} to {_original}
	if {_toStore} is greater than {_freeItems}:
		set {_toStore} to {_freeItems}
	set {_remaining} to {_toStore}
	set {_one} to {_item}
	set amount of {_one} to 1
	set {_item-type} to type of {_item}
	set {_limit} to maximum stack size of {_item-type}
	set {_pages} to countryStoragePages({_id})

	# First merge into existing compatible stacks.
	set {_page} to 1
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			if {_remaining} is greater than 0:
				set {_stored} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
				if {_stored} is set:
					set {_stored-one} to {_stored}
					set amount of {_stored-one} to 1
					if {_stored-one} is {_one}:
						set {_current} to amount of {_stored}
						if {_current} is less than {_limit}:
							set {_space} to {_limit} - {_current}
							set {_moving} to {_remaining}
							if {_moving} is greater than {_space}:
								set {_moving} to {_space}
							add {_moving} to {_current}
							set amount of {_stored} to {_current}
							set {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%} to {_stored}
							subtract {_moving} from {_remaining}
			add 1 to {_slot}
		add 1 to {_page}

	# Then occupy new slots while the shared country capacity allows it.
	while {_remaining} is greater than 0:
		if countryStorageUsedSlots({_id}) is greater than or equal to countryStorageMaxSlots({_id}):
			return {_toStore} - {_remaining}
		set {_placed} to false
		set {_page} to 1
		while {_page} is less than or equal to {_pages}:
			if {_placed} is false:
				set {_slot} to 0
				while {_slot} is less than or equal to 44:
					if {_placed} is false:
						if {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%} is not set:
							set {_moving} to {_remaining}
							if {_moving} is greater than {_limit}:
								set {_moving} to {_limit}
							set {_new} to {_item}
							set amount of {_new} to {_moving}
							set {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%} to {_new}
							subtract {_moving} from {_remaining}
							set {_placed} to true
					add 1 to {_slot}
			add 1 to {_page}
		if {_placed} is false:
			return {_toStore} - {_remaining}
	return {_toStore}

function countryStoragePutItemInCategory(id: text, category: text, itemToStore: item) :: boolean:
	countryStorageMigrate({_id})
	set {_amount} to amount of {_itemToStore}
	set {_moved} to countryStorageInsertAmount({_id}, {_category}, {_itemToStore})
	if {_moved} is greater than or equal to {_amount}:
		return true
	return false

function countryStorageHasV4Data(id: text) :: boolean:
	set {_pages} to countryStoragePages({_id})
	set {_page} to 1
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			if {country.storage4::%{_id}%::general::%{_page}%::%{_slot}%} is set:
				return true
			add 1 to {_slot}
		add 1 to {_page}
	loop {country.storage-category-name::%{_id}%::*}:
		set {_cat} to loop-index
		set {_page} to 1
		while {_page} is less than or equal to {_pages}:
			set {_slot} to 0
			while {_slot} is less than or equal to 44:
				if {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%{_slot}%} is set:
					return true
				add 1 to {_slot}
			add 1 to {_page}
	return false

function countryStorageMigrate(id: text):
	if {country.storage5-migrated::%{_id}%} is true:
		stop
	set {_pages} to countryStoragePages({_id})
	if countryStorageHasV4Data({_id}) is true:
		# Copy V4 real slots directly. UI filler panes are never copied.
		set {_page} to 1
		while {_page} is less than or equal to {_pages}:
			set {_slot} to 0
			while {_slot} is less than or equal to 44:
				set {_old} to {country.storage4::%{_id}%::general::%{_page}%::%{_slot}%}
				if {_old} is set:
					if {_old} is not air:
						if type of {_old} is not gray stained glass pane:
							set {country.storage5::%{_id}%::general::%{_page}%::%{_slot}%} to {_old}
				add 1 to {_slot}
			add 1 to {_page}
		loop {country.storage-category-name::%{_id}%::*}:
			set {_cat} to loop-index
			set {_page} to 1
			while {_page} is less than or equal to {_pages}:
				set {_slot} to 0
				while {_slot} is less than or equal to 44:
					set {_old} to {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%{_slot}%}
					if {_old} is set:
						if {_old} is not air:
							if type of {_old} is not gray stained glass pane:
								set {country.storage5::%{_id}%::%{_cat}%::%{_page}%::%{_slot}%} to {_old}
					add 1 to {_slot}
				add 1 to {_page}
	else:
		# Very old storage is imported only when no V4 data exists, preventing duplicates.
		loop {country.storage::%{_id}%::*}:
			set {_old} to loop-value
			if {_old} is set:
				if {_old} is not air:
					if type of {_old} is not gray stained glass pane:
						countryStorageInsertAmount({_id}, "general", {_old})
	set {country.storage5-migrated::%{_id}%} to true

function countryStorageMaterialCountInCategory(id: text, category: text, materialName: text) :: number:
	set {_type} to {_materialName} parsed as item type
	if {_type} is not set:
		return 0
	set {_count} to 0
	set {_page} to 1
	set {_pages} to countryStoragePages({_id})
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			set {_item} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
			if {_item} is set:
				if type of {_item} is {_type}:
					add amount of {_item} to {_count}
			add 1 to {_slot}
		add 1 to {_page}
	return {_count}

function countryStorageMaterialCount(id: text, materialName: text) :: number:
	countryStorageMigrate({_id})
	set {_count} to countryStorageMaterialCountInCategory({_id}, "general", {_materialName})
	loop {country.storage-category-name::%{_id}%::*}:
		set {_cat} to loop-index
		add countryStorageMaterialCountInCategory({_id}, {_cat}, {_materialName}) to {_count}
	return {_count}

function countryStorageTakeFromCategory(id: text, category: text, materialName: text, wanted: number) :: number:
	set {_type} to {_materialName} parsed as item type
	if {_type} is not set:
		return 0
	set {_removed} to 0
	set {_left} to {_wanted}
	set {_page} to 1
	set {_pages} to countryStoragePages({_id})
	while {_page} is less than or equal to {_pages}:
		set {_slot} to 0
		while {_slot} is less than or equal to 44:
			if {_left} is greater than 0:
				set {_item} to {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
				if {_item} is set:
					if type of {_item} is {_type}:
						set {_amount} to amount of {_item}
						if {_amount} is less than or equal to {_left}:
							add {_amount} to {_removed}
							subtract {_amount} from {_left}
							delete {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%}
						else:
							add {_left} to {_removed}
							set {_newAmount} to {_amount} - {_left}
							set amount of {_item} to {_newAmount}
							set {country.storage5::%{_id}%::%{_category}%::%{_page}%::%{_slot}%} to {_item}
							set {_left} to 0
			add 1 to {_slot}
		add 1 to {_page}
	return {_removed}

function countryStorageTakeMaterial(id: text, materialName: text, wanted: number) :: boolean:
	if {_wanted} is less than or equal to 0:
		return true
	countryStorageMigrate({_id})
	if countryStorageMaterialCount({_id}, {_materialName}) is less than {_wanted}:
		return false
	set {_left} to {_wanted}
	set {_removed} to countryStorageTakeFromCategory({_id}, "general", {_materialName}, {_left})
	subtract {_removed} from {_left}
	loop {country.storage-category-name::%{_id}%::*}:
		if {_left} is greater than 0:
			set {_cat} to loop-index
			set {_removed} to countryStorageTakeFromCategory({_id}, {_cat}, {_materialName}, {_left})
			subtract {_removed} from {_left}
	return true

function countryStorageAddMaterial(id: text, materialName: text, amountToAdd: number) :: number:
	if {_amountToAdd} is less than or equal to 0:
		return 0
	countryStorageMigrate({_id})
	set {_type} to {_materialName} parsed as item type
	if {_type} is not set:
		return {_amountToAdd}
	set {_left} to {_amountToAdd}
	set {_limit} to maximum stack size of {_type}
	while {_left} is greater than 0:
		set {_part} to {_left}
		if {_part} is greater than {_limit}:
			set {_part} to {_limit}
		set {_stack} to {_type}
		set amount of {_stack} to {_part}
		set {_moved} to countryStorageInsertAmount({_id}, "general", {_stack})
		subtract {_moved} from {_left}
		if {_moved} is less than {_part}:
			return {_left}
	return 0

function countryBuildingLevel(id: text, kind: text) :: number:
	if {country.building::%{_id}%::%{_kind}%} is set:
		return {country.building::%{_id}%::%{_kind}%}
	return 0

function countryBuildingName(kind: text) :: text:
	if {_kind} is "mine":
		return "Шахта"
	if {_kind} is "farm":
		return "Ферма"
	if {_kind} is "sawmill":
		return "Лесопилка"
	if {_kind} is "quarry":
		return "Карьер"
	if {_kind} is "ranch":
		return "Животноводство"
	return {_kind}

function countryBuildingUnlockLevel(kind: text) :: number:
	if {_kind} is "mine":
		return 1
	if {_kind} is "farm":
		return 1
	if {_kind} is "sawmill":
		return 2
	if {_kind} is "quarry":
		return 2
	if {_kind} is "ranch":
		return 3
	return 3

function countryBuildingProductionText(kind: text, level: number) :: text:
	if {_level} is less than 1:
		return "Не построено"
	if {_kind} is "mine":
		if {_level} is 1:
			return "16 угля + 4 сырого железа / час"
		if {_level} is 2:
			return "24 угля + 8 железа + 2 золота / час"
		return "32 угля + 12 железа + 4 золота + 6 редстоуна / час"
	if {_kind} is "farm":
		if {_level} is 1:
			return "24 пшеницы + 8 картофеля / час"
		if {_level} is 2:
			return "36 пшеницы + 16 картофеля + 8 моркови / час"
		return "48 пшеницы + 24 картофеля + 16 моркови + 8 свёклы / час"
	if {_kind} is "sawmill":
		if {_level} is 1:
			return "24 дубовых брёвен / час"
		if {_level} is 2:
			return "32 дуба + 12 ели / час"
		return "40 дуба + 20 ели + 12 берёзы / час"
	if {_kind} is "quarry":
		if {_level} is 1:
			return "32 булыжника + 8 камня / час"
		if {_level} is 2:
			return "48 булыжника + 16 камня + 8 песка / час"
		return "64 булыжника + 24 камня + 16 песка + 8 глины / час"
	if {_kind} is "ranch":
		if {_level} is 1:
			return "4 кожи + 6 белой шерсти / час"
		if {_level} is 2:
			return "8 кожи + 8 шерсти + 4 пера / час"
		return "12 кожи + 12 шерсти + 8 пера + 4 кроличьих шкурки / час"
	return ""

function countryBuildingCostText(kind: text, nextLevel: number) :: text:
	if {_kind} is "mine":
		if {_nextLevel} is 1:
			return "1200 монет • 48 железа • 8 золота"
		if {_nextLevel} is 2:
			return "3000 монет • 96 железа • 20 золота • 4 алмаза"
		return "6000 монет • 128 железа • 40 золота • 10 алмазов"
	if {_kind} is "farm":
		if {_nextLevel} is 1:
			return "700 монет • 96 пшеницы • 48 дуба"
		if {_nextLevel} is 2:
			return "1600 монет • 160 пшеницы • 64 дуба • 20 железа"
		return "3200 монет • 256 пшеницы • 96 дуба • 40 железа • 4 алмаза"
	if {_kind} is "sawmill":
		if {_nextLevel} is 1:
			return "1000 монет • 96 дуба • 20 железа"
		if {_nextLevel} is 2:
			return "2200 монет • 128 дуба • 40 железа • 8 золота"
		return "4500 монет • 192 дуба • 64 железа • 4 алмаза"
	if {_kind} is "quarry":
		if {_nextLevel} is 1:
			return "1200 монет • 160 камня • 20 железа"
		if {_nextLevel} is 2:
			return "2500 монет • 256 камня • 40 железа • 8 золота"
		return "5000 монет • 384 камня • 80 железа • 4 алмаза"
	if {_kind} is "ranch":
		if {_nextLevel} is 1:
			return "1200 монет • 40 сена • 48 дуба"
		if {_nextLevel} is 2:
			return "2800 монет • 80 сена • 64 дуба • 20 железа"
		return "5500 монет • 128 сена • 96 дуба • 40 железа • 8 золота"
	return ""

function countryLevelUpgradeCostText(nextLevel: number) :: text:
	if {_nextLevel} is 2:
		return "3500 монет • 96 железа • 24 золота • 8 алмазов • 160 камня"
	if {_nextLevel} is 3:
		return "9000 монет • 160 железа • 64 золота • 20 алмазов • 16 изумрудов"
	return "Максимальный уровень"

function countryProductionAdd(id: text, materialName: text, amountToAdd: number):
	if {_amountToAdd} is greater than 0:
		add {_amountToAdd} to {country.production::%{_id}%::%{_materialName}%}

function countryProduce(id: text, hours: number):
	if {_hours} is less than 1:
		stop
	set {_level} to countryBuildingLevel({_id}, "mine")
	if {_level} is 1:
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "coal", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "raw iron", {_a})
	else if {_level} is 2:
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "coal", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "raw iron", {_a})
		set {_a} to 2 * {_hours}
		countryProductionAdd({_id}, "raw gold", {_a})
	else if {_level} is 3:
		set {_a} to 32 * {_hours}
		countryProductionAdd({_id}, "coal", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "raw iron", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "raw gold", {_a})
		set {_a} to 6 * {_hours}
		countryProductionAdd({_id}, "redstone", {_a})
	set {_level} to countryBuildingLevel({_id}, "farm")
	if {_level} is 1:
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "wheat", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "potato", {_a})
	else if {_level} is 2:
		set {_a} to 36 * {_hours}
		countryProductionAdd({_id}, "wheat", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "potato", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "carrot", {_a})
	else if {_level} is 3:
		set {_a} to 48 * {_hours}
		countryProductionAdd({_id}, "wheat", {_a})
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "potato", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "carrot", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "beetroot", {_a})
	set {_level} to countryBuildingLevel({_id}, "sawmill")
	if {_level} is 1:
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "oak log", {_a})
	else if {_level} is 2:
		set {_a} to 32 * {_hours}
		countryProductionAdd({_id}, "oak log", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "spruce log", {_a})
	else if {_level} is 3:
		set {_a} to 40 * {_hours}
		countryProductionAdd({_id}, "oak log", {_a})
		set {_a} to 20 * {_hours}
		countryProductionAdd({_id}, "spruce log", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "birch log", {_a})
	set {_level} to countryBuildingLevel({_id}, "quarry")
	if {_level} is 1:
		set {_a} to 32 * {_hours}
		countryProductionAdd({_id}, "cobblestone", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "stone", {_a})
	else if {_level} is 2:
		set {_a} to 48 * {_hours}
		countryProductionAdd({_id}, "cobblestone", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "stone", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "sand", {_a})
	else if {_level} is 3:
		set {_a} to 64 * {_hours}
		countryProductionAdd({_id}, "cobblestone", {_a})
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "stone", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "sand", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "clay", {_a})
	set {_level} to countryBuildingLevel({_id}, "ranch")
	if {_level} is 1:
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "leather", {_a})
		set {_a} to 6 * {_hours}
		countryProductionAdd({_id}, "white wool", {_a})
	else if {_level} is 2:
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "leather", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "white wool", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "feather", {_a})
	else if {_level} is 3:
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "leather", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "white wool", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "feather", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "rabbit hide", {_a})

function countryProcessProduction():
	loop {country.name::*}:
		set {_id} to loop-index
		if {country.level::%{_id}%} is not set:
			set {country.level::%{_id}%} to 1
		if {country.production-next::%{_id}%} is not set:
			set {country.production-next::%{_id}%} to 1 hour from now
		else:
			set {_hours} to 0
			while {country.production-next::%{_id}%} is in the past:
				add 1 to {_hours}
				add 1 hour to {country.production-next::%{_id}%}
				if {_hours} is greater than or equal to 720:
					stop loop
			if {_hours} is greater than 0:
				countryProduce({_id}, {_hours})

function countryPendingProduction(id: text) :: number:
	set {_count} to 0
	loop {country.production::%{_id}%::*}:
		add loop-value to {_count}
	return {_count}

function countryCollectProduction(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	countryProcessProduction()
	set {_moved} to 0
	loop {country.production::%{_id}%::*}:
		set {_material} to loop-index
		set {_amount} to loop-value
		if {_amount} is greater than 0:
			set {_left} to countryStorageAddMaterial({_id}, {_material}, {_amount})
			set {_added} to {_amount} - {_left}
			add {_added} to {_moved}
			if {_left} is less than or equal to 0:
				delete {country.production::%{_id}%::%{_material}%}
			else:
				set {country.production::%{_id}%::%{_material}%} to {_left}
	if {_moved} is greater than 0:
		send formatted "<light green>В хранилище перенесено <white>%{_moved}% <light green>единиц продукции." to {_p}
	else:
		set {_pending} to countryPendingProduction({_id})
		if {_pending} is greater than 0:
			send "<red>В хранилище нет места. Освободите несколько ячеек." to {_p}
		else:
			send "<gray>Накопленной продукции пока нет." to {_p}

function countryOpenStorage2(p: player, page: number):
	countryOpenStorageCategory({_p}, "general", {_page})

function countryOpenDevelopment2(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	countryProcessProduction()
	set {_country-level} to countryLevel({_id})
	set {_pending} to countryPendingProduction({_id})
	set {_menu} to chest inventory with 6 rows named "<dark gray>Развитие страны"
	loop integers between 0 and 53:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	if {_country-level} is less than 3:
		set {_next-level} to {_country-level} + 1
		set {_level-cost} to countryLevelUpgradeCostText({_next-level})
		set slot 4 of {_menu} to beacon named "<aqua><bold>УРОВЕНЬ СТРАНЫ: %{_country-level}%/3" with lore "<gray>Следующий уровень: <white>%{_next-level}%" and "<gray>Цена: <gold>%{_level-cost}%" and "" and "<yellow>Нажмите для повышения"
	else:
		set slot 4 of {_menu} to beacon named "<light green><bold>УРОВЕНЬ СТРАНЫ: III/III" with lore "<gray>Достигнут максимальный уровень"
	delete {country.building-menu::%uuid of {_p}%::*}
	set {_kinds::*} to "mine", "farm", "sawmill", "quarry" and "ranch"
	set {_slots::*} to 10, 12, 14, 16 and 22
	set {_icons::*} to iron pickaxe, wheat, iron axe, stone and leather
	loop {_kinds::*}:
		set {_kind} to loop-value
		set {_slot} to {_slots::%loop-index%}
		set {_icon} to {_icons::%loop-index%}
		set {_name} to countryBuildingName({_kind})
		set {_building-level} to countryBuildingLevel({_id}, {_kind})
		set {_unlock} to countryBuildingUnlockLevel({_kind})
		set {_production} to countryBuildingProductionText({_kind}, {_building-level})
		if {_country-level} is less than {_unlock}:
			set slot {_slot} of {_menu} to barrier named "<red><bold>%{_name}%" with lore "<gray>Открывается на <white>%{_unlock}% уровне страны"
		else if {_building-level} is greater than or equal to 3:
			set slot {_slot} of {_menu} to {_icon} named "<light green><bold>%{_name}% • III" with lore "<gray>%{_production}%" and "" and "<green>МАКСИМАЛЬНЫЙ УРОВЕНЬ"
		else:
			set {_next-building} to {_building-level} + 1
			set {_cost} to countryBuildingCostText({_kind}, {_next-building})
			if {_next-building} is greater than {_country-level}:
				set slot {_slot} of {_menu} to {_icon} named "<yellow><bold>%{_name}% • %{_building-level}%/3" with lore "<gray>Производство: <white>%{_production}%" and "" and "<red>Для следующего уровня нужен" and "<red>%{_next-building}% уровень страны"
			else:
				set slot {_slot} of {_menu} to {_icon} named "<yellow><bold>%{_name}% • %{_building-level}%/3" with lore "<gray>Производство: <white>%{_production}%" and "" and "<gray>Следующий уровень: <white>%{_next-building}%" and "<gray>Цена: <gold>%{_cost}%" and "" and "<yellow>Нажмите, чтобы построить/улучшить"
		set {country.building-menu::%uuid of {_p}%::%{_slot}%} to {_kind}
	set slot 31 of {_menu} to hopper named "<gold><bold>ЗАБРАТЬ ПРОДУКЦИЮ" with lore "<gray>Накоплено: <white>%{_pending}% предметов" and "<gray>Здания производят ресурсы каждый" and "<gray>реальный час, даже без игроков онлайн." and "" and "<yellow>Нажмите, чтобы перенести в хранилище"
	set slot 40 of {_menu} to arrow named "<yellow>Назад"
	open {_menu} to {_p}
	set {country.menu::%uuid of {_p}%} to "development2"

function countryTryUpgradeLevel2(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	if countryCanManageDevelopment({_p}) is not true:
		send "<red>У вашей роли нет права управлять развитием страны." to {_p}
		stop
	set {_level} to countryLevel({_id})
	if {_level} is greater than or equal to 3:
		send "<yellow>У страны уже максимальный уровень." to {_p}
		stop
	set {_next} to {_level} + 1
	if {_next} is 2:
		set {_money} to 3500
		set {_m1} to "iron ingot"
		set {_a1} to 96
		set {_m2} to "gold ingot"
		set {_a2} to 24
		set {_m3} to "diamond"
		set {_a3} to 8
		set {_m4} to "stone"
		set {_a4} to 160
	else:
		set {_money} to 9000
		set {_m1} to "iron ingot"
		set {_a1} to 160
		set {_m2} to "gold ingot"
		set {_a2} to 64
		set {_m3} to "diamond"
		set {_a3} to 20
		set {_m4} to "emerald"
		set {_a4} to 16
	if {country.treasury::%{_id}%} is not set:
		set {country.treasury::%{_id}%} to 0
	if {country.treasury::%{_id}%} is less than {_money}:
		send formatted "<red>В казне недостаточно денег. Нужно <gold>%{_money}% монет<red>." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m1}) is less than {_a1}:
		send formatted "<red>Не хватает <white>%{_a1}% %{_m1}% <red>в хранилище." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m2}) is less than {_a2}:
		send formatted "<red>Не хватает <white>%{_a2}% %{_m2}% <red>в хранилище." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m3}) is less than {_a3}:
		send formatted "<red>Не хватает <white>%{_a3}% %{_m3}% <red>в хранилище." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m4}) is less than {_a4}:
		send formatted "<red>Не хватает <white>%{_a4}% %{_m4}% <red>в хранилище." to {_p}
		stop
	countryStorageTakeMaterial({_id}, {_m1}, {_a1})
	countryStorageTakeMaterial({_id}, {_m2}, {_a2})
	countryStorageTakeMaterial({_id}, {_m3}, {_a3})
	countryStorageTakeMaterial({_id}, {_m4}, {_a4})
	remove {_money} from {country.treasury::%{_id}%}
	set {country.level::%{_id}%} to {_next}
	if {_next} is 2:
		send "<light green><bold>Страна достигла II уровня!</bold> <gray>Открыты вторая страница хранилища, лесопилка и карьер." to {_p}
	else:
		send "<light green><bold>Страна достигла III уровня!</bold> <gray>Открыто животноводство и III уровни зданий." to {_p}

function countryTryUpgradeBuilding2(p: player, kind: text):
