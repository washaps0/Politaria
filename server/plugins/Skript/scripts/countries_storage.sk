# =========================================================
# POLITARIA COUNTRY STORAGE + PROGRESSION
# Extension for countries.sk
# =========================================================
# Country levels:
#   I   - 45 storage slots, Mine and Farm
#   II  - 90 storage slots, Sawmill and Quarry, building level II
#   III - Ranch, building level III
#
# Role permissions stored in the existing country role system:
#   STORAGE_DEPOSIT     - put items into country storage
#   STORAGE_WITHDRAW    - take items from country storage
#   MANAGE_DEVELOPMENT  - upgrade country and buildings
# =========================================================

function countryLevel(id: text) :: number:
	if {country.level::%{_id}%} is set:
		return {country.level::%{_id}%}
	return 1

function countryStoragePages(id: text) :: number:
	if countryLevel({_id}) is greater than or equal to 2:
		return 2
	return 1

function countryStorageMaxSlots(id: text) :: number:
	set {_pages} to countryStoragePages({_id})
	return {_pages} * 45

function countryStorageCanDeposit(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "STORAGE_DEPOSIT") is true:
		return true
	return false

function countryStorageCanWithdraw(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "STORAGE_WITHDRAW") is true:
		return true
	return false

function countryCanManageDevelopment(p: player) :: boolean:
	set {_id} to countryId({_p})
	if {_id} is "":
		return false
	if countryIsAdmin({_p}) is true:
		return true
	if {country.owner::%{_id}%} is "%uuid of {_p}%":
		return true
	if countryHasPermission({_p}, "MANAGE_DEVELOPMENT") is true:
		return true
	return false

function countryStorageMaterialCount(id: text, materialName: text) :: number:
\tcountryStorageMigrate({_id})
\tset {_type} to {_materialName} parsed as item type
\tif {_type} is not set:
\t\treturn 0
\tset {_count} to 0
\tloop integers between 1 and countryStoragePages({_id}):
\t\tset {_page} to loop-value
\t\tloop integers between 0 and 44:
\t\t\tset {_item} to {country.storage4::%{_id}%::general::%{_page}%::%loop-value%}
\t\t\tif {_item} is set:
\t\t\t\tif type of {_item} is {_type}:
\t\t\t\t\tadd amount of {_item} to {_count}
\tloop {country.storage-category-name::%{_id}%::*}:
\t\tset {_cat} to loop-index
\t\tloop integers between 1 and countryStoragePages({_id}):
\t\t\tset {_page} to loop-value
\t\t\tloop integers between 0 and 44:
\t\t\t\tset {_item} to {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%}
\t\t\t\tif {_item} is set:
\t\t\t\t\tif type of {_item} is {_type}:
\t\t\t\t\t\tadd amount of {_item} to {_count}
\treturn {_count}

function countryStorageTakeMaterial(id: text, materialName: text, wanted: number) :: boolean:
\tif {_wanted} is less than or equal to 0:
\t\treturn true
\tcountryStorageMigrate({_id})
\tif countryStorageMaterialCount({_id}, {_materialName}) is less than {_wanted}:
\t\treturn false
\tset {_type} to {_materialName} parsed as item type
\tset {_left} to {_wanted}
\tloop integers between 1 and countryStoragePages({_id}):
\t\tset {_page} to loop-value
\t\tloop integers between 0 and 44:
\t\t\tif {_left} is greater than 0:
\t\t\t\tset {_item} to {country.storage4::%{_id}%::general::%{_page}%::%loop-value%}
\t\t\t\tif {_item} is set:
\t\t\t\t\tif type of {_item} is {_type}:
\t\t\t\t\t\tset {_amount} to amount of {_item}
\t\t\t\t\t\tif {_amount} is less than or equal to {_left}:
\t\t\t\t\t\t\tsubtract {_amount} from {_left}
\t\t\t\t\t\t\tdelete {country.storage4::%{_id}%::general::%{_page}%::%loop-value%}
\t\t\t\t\t\telse:
\t\t\t\t\t\t\tset {_new} to {_amount} - {_left}
\t\t\t\t\t\t\tset amount of {_item} to {_new}
\t\t\t\t\t\t\tset {country.storage4::%{_id}%::general::%{_page}%::%loop-value%} to {_item}
\t\t\t\t\t\t\tset {_left} to 0
\tloop {country.storage-category-name::%{_id}%::*}:
\t\tif {_left} is greater than 0:
\t\t\tset {_cat} to loop-index
\t\t\tloop integers between 1 and countryStoragePages({_id}):
\t\t\t\tset {_page} to loop-value
\t\t\t\tloop integers between 0 and 44:
\t\t\t\t\tif {_left} is greater than 0:
\t\t\t\t\t\tset {_item} to {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%}
\t\t\t\t\t\tif {_item} is set:
\t\t\t\t\t\t\tif type of {_item} is {_type}:
\t\t\t\t\t\t\t\tset {_amount} to amount of {_item}
\t\t\t\t\t\t\t\tif {_amount} is less than or equal to {_left}:
\t\t\t\t\t\t\t\t\tsubtract {_amount} from {_left}
\t\t\t\t\t\t\t\t\tdelete {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%}
\t\t\t\t\t\t\t\telse:
\t\t\t\t\t\t\t\t\tset {_new} to {_amount} - {_left}
\t\t\t\t\t\t\t\t\tset amount of {_item} to {_new}
\t\t\t\t\t\t\t\t\tset {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%} to {_item}
\t\t\t\t\t\t\t\t\tset {_left} to 0
\treturn true

function countryStorageAddMaterial(id: text, materialName: text, amountToAdd: number) :: number:
\tcountryStorageMigrate({_id})
\tset {_type} to {_materialName} parsed as item type
\tif {_type} is not set:
\t\treturn {_amountToAdd}
\tset {_left} to {_amountToAdd}
\twhile {_left} is greater than 0:
\t\tset {_put} to {_left}
\t\tif {_put} is greater than 64:
\t\t\tset {_put} to 64
\t\tset {_stack} to {_type}
\t\tset amount of {_stack} to {_put}
\t\tif countryStoragePutItemInCategory({_id}, "general", {_stack}) is true:
\t\t\tsubtract {_put} from {_left}
\t\telse:
\t\t\treturn {_left}
\treturn 0

function countryBuildingLevel(id: text, kind: text) :: number:
	if {country.building::%{_id}%::%{_kind}%} is set:
		return {country.building::%{_id}%::%{_kind}%}
	return 0

function countryBuildingName(kind: text) :: text:
	if {_kind} is "mine":
		return "Шахта"
	if {_kind} is "farm":
		return "Ферма"
	if {_kind} is "sawmill":
		return "Лесопилка"
	if {_kind} is "quarry":
		return "Карьер"
	if {_kind} is "ranch":
		return "Животноводство"
	return {_kind}

function countryBuildingUnlockLevel(kind: text) :: number:
	if {_kind} is "mine":
		return 1
	if {_kind} is "farm":
		return 1
	if {_kind} is "sawmill":
		return 2
	if {_kind} is "quarry":
		return 2
	if {_kind} is "ranch":
		return 3
	return 3

function countryBuildingProductionText(kind: text, level: number) :: text:
	if {_level} is less than 1:
		return "Не построено"
	if {_kind} is "mine":
		if {_level} is 1:
			return "16 угля + 4 сырого железа / час"
		if {_level} is 2:
			return "24 угля + 8 железа + 2 золота / час"
		return "32 угля + 12 железа + 4 золота + 6 редстоуна / час"
	if {_kind} is "farm":
		if {_level} is 1:
			return "24 пшеницы + 8 картофеля / час"
		if {_level} is 2:
			return "36 пшеницы + 16 картофеля + 8 моркови / час"
		return "48 пшеницы + 24 картофеля + 16 моркови + 8 свёклы / час"
	if {_kind} is "sawmill":
		if {_level} is 1:
			return "24 дубовых брёвен / час"
		if {_level} is 2:
			return "32 дуба + 12 ели / час"
		return "40 дуба + 20 ели + 12 берёзы / час"
	if {_kind} is "quarry":
		if {_level} is 1:
			return "32 булыжника + 8 камня / час"
		if {_level} is 2:
			return "48 булыжника + 16 камня + 8 песка / час"
		return "64 булыжника + 24 камня + 16 песка + 8 глины / час"
	if {_kind} is "ranch":
		if {_level} is 1:
			return "4 кожи + 6 белой шерсти / час"
		if {_level} is 2:
			return "8 кожи + 8 шерсти + 4 пера / час"
		return "12 кожи + 12 шерсти + 8 пера + 4 кроличьих шкурки / час"
	return ""

function countryBuildingCostText(kind: text, nextLevel: number) :: text:
	if {_kind} is "mine":
		if {_nextLevel} is 1:
			return "1200 монет • 48 железа • 8 золота"
		if {_nextLevel} is 2:
			return "3000 монет • 96 железа • 20 золота • 4 алмаза"
		return "6000 монет • 128 железа • 40 золота • 10 алмазов"
	if {_kind} is "farm":
		if {_nextLevel} is 1:
			return "700 монет • 96 пшеницы • 48 дуба"
		if {_nextLevel} is 2:
			return "1600 монет • 160 пшеницы • 64 дуба • 20 железа"
		return "3200 монет • 256 пшеницы • 96 дуба • 40 железа • 4 алмаза"
	if {_kind} is "sawmill":
		if {_nextLevel} is 1:
			return "1000 монет • 96 дуба • 20 железа"
		if {_nextLevel} is 2:
			return "2200 монет • 128 дуба • 40 железа • 8 золота"
		return "4500 монет • 192 дуба • 64 железа • 4 алмаза"
	if {_kind} is "quarry":
		if {_nextLevel} is 1:
			return "1200 монет • 160 камня • 20 железа"
		if {_nextLevel} is 2:
			return "2500 монет • 256 камня • 40 железа • 8 золота"
		return "5000 монет • 384 камня • 80 железа • 4 алмаза"
	if {_kind} is "ranch":
		if {_nextLevel} is 1:
			return "1200 монет • 40 сена • 48 дуба"
		if {_nextLevel} is 2:
			return "2800 монет • 80 сена • 64 дуба • 20 железа"
		return "5500 монет • 128 сена • 96 дуба • 40 железа • 8 золота"
	return ""

function countryLevelUpgradeCostText(nextLevel: number) :: text:
	if {_nextLevel} is 2:
		return "3500 монет • 96 железа • 24 золота • 8 алмазов • 160 камня"
	if {_nextLevel} is 3:
		return "9000 монет • 160 железа • 64 золота • 20 алмазов • 16 изумрудов"
	return "Максимальный уровень"

function countryProductionAdd(id: text, materialName: text, amountToAdd: number):
	if {_amountToAdd} is greater than 0:
		add {_amountToAdd} to {country.production::%{_id}%::%{_materialName}%}

function countryProduce(id: text, hours: number):
	if {_hours} is less than 1:
		stop
	set {_level} to countryBuildingLevel({_id}, "mine")
	if {_level} is 1:
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "coal", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "raw iron", {_a})
	else if {_level} is 2:
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "coal", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "raw iron", {_a})
		set {_a} to 2 * {_hours}
		countryProductionAdd({_id}, "raw gold", {_a})
	else if {_level} is 3:
		set {_a} to 32 * {_hours}
		countryProductionAdd({_id}, "coal", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "raw iron", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "raw gold", {_a})
		set {_a} to 6 * {_hours}
		countryProductionAdd({_id}, "redstone", {_a})
	set {_level} to countryBuildingLevel({_id}, "farm")
	if {_level} is 1:
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "wheat", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "potato", {_a})
	else if {_level} is 2:
		set {_a} to 36 * {_hours}
		countryProductionAdd({_id}, "wheat", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "potato", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "carrot", {_a})
	else if {_level} is 3:
		set {_a} to 48 * {_hours}
		countryProductionAdd({_id}, "wheat", {_a})
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "potato", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "carrot", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "beetroot", {_a})
	set {_level} to countryBuildingLevel({_id}, "sawmill")
	if {_level} is 1:
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "oak log", {_a})
	else if {_level} is 2:
		set {_a} to 32 * {_hours}
		countryProductionAdd({_id}, "oak log", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "spruce log", {_a})
	else if {_level} is 3:
		set {_a} to 40 * {_hours}
		countryProductionAdd({_id}, "oak log", {_a})
		set {_a} to 20 * {_hours}
		countryProductionAdd({_id}, "spruce log", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "birch log", {_a})
	set {_level} to countryBuildingLevel({_id}, "quarry")
	if {_level} is 1:
		set {_a} to 32 * {_hours}
		countryProductionAdd({_id}, "cobblestone", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "stone", {_a})
	else if {_level} is 2:
		set {_a} to 48 * {_hours}
		countryProductionAdd({_id}, "cobblestone", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "stone", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "sand", {_a})
	else if {_level} is 3:
		set {_a} to 64 * {_hours}
		countryProductionAdd({_id}, "cobblestone", {_a})
		set {_a} to 24 * {_hours}
		countryProductionAdd({_id}, "stone", {_a})
		set {_a} to 16 * {_hours}
		countryProductionAdd({_id}, "sand", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "clay", {_a})
	set {_level} to countryBuildingLevel({_id}, "ranch")
	if {_level} is 1:
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "leather", {_a})
		set {_a} to 6 * {_hours}
		countryProductionAdd({_id}, "white wool", {_a})
	else if {_level} is 2:
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "leather", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "white wool", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "feather", {_a})
	else if {_level} is 3:
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "leather", {_a})
		set {_a} to 12 * {_hours}
		countryProductionAdd({_id}, "white wool", {_a})
		set {_a} to 8 * {_hours}
		countryProductionAdd({_id}, "feather", {_a})
		set {_a} to 4 * {_hours}
		countryProductionAdd({_id}, "rabbit hide", {_a})

function countryProcessProduction():
	loop {country.name::*}:
		set {_id} to loop-index
		if {country.level::%{_id}%} is not set:
			set {country.level::%{_id}%} to 1
		if {country.production-next::%{_id}%} is not set:
			set {country.production-next::%{_id}%} to 1 hour from now
		else:
			set {_hours} to 0
			while {country.production-next::%{_id}%} is in the past:
				add 1 to {_hours}
				add 1 hour to {country.production-next::%{_id}%}
				if {_hours} is greater than or equal to 720:
					stop loop
			if {_hours} is greater than 0:
				countryProduce({_id}, {_hours})

function countryPendingProduction(id: text) :: number:
	set {_count} to 0
	loop {country.production::%{_id}%::*}:
		add loop-value to {_count}
	return {_count}

function countryCollectProduction(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	countryProcessProduction()
	set {_moved} to 0
	loop {country.production::%{_id}%::*}:
		set {_material} to loop-index
		set {_amount} to loop-value
		if {_amount} is greater than 0:
			set {_left} to countryStorageAddMaterial({_id}, {_material}, {_amount})
			set {_added} to {_amount} - {_left}
			add {_added} to {_moved}
			if {_left} is less than or equal to 0:
				delete {country.production::%{_id}%::%{_material}%}
			else:
				set {country.production::%{_id}%::%{_material}%} to {_left}
	if {_moved} is greater than 0:
		send formatted "<light green>В хранилище перенесено <white>%{_moved}% <light green>единиц продукции." to {_p}
	else:
		set {_pending} to countryPendingProduction({_id})
		if {_pending} is greater than 0:
			send "<red>В хранилище нет места. Освободите несколько ячеек." to {_p}
		else:
			send "<gray>Накопленной продукции пока нет." to {_p}

function countryOpenStorage2(p: player, page: number):
	countryOpenStorageCategory({_p}, "general", {_page})

function countryOpenDevelopment2(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	countryProcessProduction()
	set {_country-level} to countryLevel({_id})
	set {_pending} to countryPendingProduction({_id})
	set {_menu} to chest inventory with 6 rows named "<dark gray>Развитие страны"
	loop integers between 0 and 53:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	if {_country-level} is less than 3:
		set {_next-level} to {_country-level} + 1
		set {_level-cost} to countryLevelUpgradeCostText({_next-level})
		set slot 4 of {_menu} to beacon named "<aqua><bold>УРОВЕНЬ СТРАНЫ: %{_country-level}%/3" with lore "<gray>Следующий уровень: <white>%{_next-level}%" and "<gray>Цена: <gold>%{_level-cost}%" and "" and "<yellow>Нажмите для повышения"
	else:
		set slot 4 of {_menu} to beacon named "<light green><bold>УРОВЕНЬ СТРАНЫ: III/III" with lore "<gray>Достигнут максимальный уровень"
	delete {country.building-menu::%uuid of {_p}%::*}
	set {_kinds::*} to "mine", "farm", "sawmill", "quarry" and "ranch"
	set {_slots::*} to 10, 12, 14, 16 and 22
	set {_icons::*} to iron pickaxe, wheat, iron axe, stone and leather
	loop {_kinds::*}:
		set {_kind} to loop-value
		set {_slot} to {_slots::%loop-index%}
		set {_icon} to {_icons::%loop-index%}
		set {_name} to countryBuildingName({_kind})
		set {_building-level} to countryBuildingLevel({_id}, {_kind})
		set {_unlock} to countryBuildingUnlockLevel({_kind})
		set {_production} to countryBuildingProductionText({_kind}, {_building-level})
		if {_country-level} is less than {_unlock}:
			set slot {_slot} of {_menu} to barrier named "<red><bold>%{_name}%" with lore "<gray>Открывается на <white>%{_unlock}% уровне страны"
		else if {_building-level} is greater than or equal to 3:
			set slot {_slot} of {_menu} to {_icon} named "<light green><bold>%{_name}% • III" with lore "<gray>%{_production}%" and "" and "<green>МАКСИМАЛЬНЫЙ УРОВЕНЬ"
		else:
			set {_next-building} to {_building-level} + 1
			set {_cost} to countryBuildingCostText({_kind}, {_next-building})
			if {_next-building} is greater than {_country-level}:
				set slot {_slot} of {_menu} to {_icon} named "<yellow><bold>%{_name}% • %{_building-level}%/3" with lore "<gray>Производство: <white>%{_production}%" and "" and "<red>Для следующего уровня нужен" and "<red>%{_next-building}% уровень страны"
			else:
				set slot {_slot} of {_menu} to {_icon} named "<yellow><bold>%{_name}% • %{_building-level}%/3" with lore "<gray>Производство: <white>%{_production}%" and "" and "<gray>Следующий уровень: <white>%{_next-building}%" and "<gray>Цена: <gold>%{_cost}%" and "" and "<yellow>Нажмите, чтобы построить/улучшить"
		set {country.building-menu::%uuid of {_p}%::%{_slot}%} to {_kind}
	set slot 31 of {_menu} to hopper named "<gold><bold>ЗАБРАТЬ ПРОДУКЦИЮ" with lore "<gray>Накоплено: <white>%{_pending}% предметов" and "<gray>Здания производят ресурсы каждый" and "<gray>реальный час, даже без игроков онлайн." and "" and "<yellow>Нажмите, чтобы перенести в хранилище"
	set slot 40 of {_menu} to arrow named "<yellow>Назад"
	open {_menu} to {_p}
	set {country.menu::%uuid of {_p}%} to "development2"

function countryTryUpgradeLevel2(p: player):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	if countryCanManageDevelopment({_p}) is not true:
		send "<red>У вашей роли нет права управлять развитием страны." to {_p}
		stop
	set {_level} to countryLevel({_id})
	if {_level} is greater than or equal to 3:
		send "<yellow>У страны уже максимальный уровень." to {_p}
		stop
	set {_next} to {_level} + 1
	if {_next} is 2:
		set {_money} to 3500
		set {_m1} to "iron ingot"
		set {_a1} to 96
		set {_m2} to "gold ingot"
		set {_a2} to 24
		set {_m3} to "diamond"
		set {_a3} to 8
		set {_m4} to "stone"
		set {_a4} to 160
	else:
		set {_money} to 9000
		set {_m1} to "iron ingot"
		set {_a1} to 160
		set {_m2} to "gold ingot"
		set {_a2} to 64
		set {_m3} to "diamond"
		set {_a3} to 20
		set {_m4} to "emerald"
		set {_a4} to 16
	if {country.treasury::%{_id}%} is not set:
		set {country.treasury::%{_id}%} to 0
	if {country.treasury::%{_id}%} is less than {_money}:
		send formatted "<red>В казне недостаточно денег. Нужно <gold>%{_money}% монет<red>." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m1}) is less than {_a1}:
		send formatted "<red>Не хватает <white>%{_a1}% %{_m1}% <red>в хранилище." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m2}) is less than {_a2}:
		send formatted "<red>Не хватает <white>%{_a2}% %{_m2}% <red>в хранилище." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m3}) is less than {_a3}:
		send formatted "<red>Не хватает <white>%{_a3}% %{_m3}% <red>в хранилище." to {_p}
		stop
	if countryStorageMaterialCount({_id}, {_m4}) is less than {_a4}:
		send formatted "<red>Не хватает <white>%{_a4}% %{_m4}% <red>в хранилище." to {_p}
		stop
	countryStorageTakeMaterial({_id}, {_m1}, {_a1})
	countryStorageTakeMaterial({_id}, {_m2}, {_a2})
	countryStorageTakeMaterial({_id}, {_m3}, {_a3})
	countryStorageTakeMaterial({_id}, {_m4}, {_a4})
	remove {_money} from {country.treasury::%{_id}%}
	set {country.level::%{_id}%} to {_next}
	if {_next} is 2:
		send "<light green><bold>Страна достигла II уровня!</bold> <gray>Открыты вторая страница хранилища, лесопилка и карьер." to {_p}
	else:
		send "<light green><bold>Страна достигла III уровня!</bold> <gray>Открыто животноводство и III уровни зданий." to {_p}

function countryTryUpgradeBuilding2(p: player, kind: text):
	set {_id} to countryId({_p})
	if {_id} is "":
		stop
	if countryCanManageDevelopment({_p}) is not true:
		send "<red>У вашей роли нет права управлять развитием страны." to {_p}
		stop
	set {_country-level} to countryLevel({_id})
	set {_unlock} to countryBuildingUnlockLevel({_kind})
	if {_country-level} is less than {_unlock}:
		send formatted "<red>Это здание открывается на <white>%{_unlock}% уровне страны<red>." to {_p}
		stop
	set {_current} to countryBuildingLevel({_id}, {_kind})
	set {_next} to {_current} + 1
	if {_next} is greater than 3:
		send "<yellow>Здание уже максимального уровня." to {_p}
		stop
	if {_next} is greater than {_country-level}:
		send formatted "<red>Сначала повысьте уровень страны до <white>%{_next}%<red>." to {_p}
		stop
	set {_money} to 0
	set {_m1} to ""
	set {_a1} to 0
	set {_m2} to ""
	set {_a2} to 0
	set {_m3} to ""
	set {_a3} to 0
	set {_m4} to ""
	set {_a4} to 0
	if {_kind} is "mine":
		if {_next} is 1:
			set {_money} to 1200
			set {_m1} to "iron ingot"
			set {_a1} to 48
			set {_m2} to "gold ingot"
			set {_a2} to 8
		else if {_next} is 2:
			set {_money} to 3000
			set {_m1} to "iron ingot"
			set {_a1} to 96
			set {_m2} to "gold ingot"
			set {_a2} to 20
			set {_m3} to "diamond"
			set {_a3} to 4
		else:
			set {_money} to 6000
			set {_m1} to "iron ingot"
			set {_a1} to 128
			set {_m2} to "gold ingot"
			set {_a2} to 40
			set {_m3} to "diamond"
			set {_a3} to 10
	else if {_kind} is "farm":
		if {_next} is 1:
			set {_money} to 700
			set {_m1} to "wheat"
			set {_a1} to 96
			set {_m2} to "oak log"
			set {_a2} to 48
		else if {_next} is 2:
			set {_money} to 1600
			set {_m1} to "wheat"
			set {_a1} to 160
			set {_m2} to "oak log"
			set {_a2} to 64
			set {_m3} to "iron ingot"
			set {_a3} to 20
		else:
			set {_money} to 3200
			set {_m1} to "wheat"
			set {_a1} to 256
			set {_m2} to "oak log"
			set {_a2} to 96
			set {_m3} to "iron ingot"
			set {_a3} to 40
			set {_m4} to "diamond"
			set {_a4} to 4
	else if {_kind} is "sawmill":
		if {_next} is 1:
			set {_money} to 1000
			set {_m1} to "oak log"
			set {_a1} to 96
			set {_m2} to "iron ingot"
			set {_a2} to 20
		else if {_next} is 2:
			set {_money} to 2200
			set {_m1} to "oak log"
			set {_a1} to 128
			set {_m2} to "iron ingot"
			set {_a2} to 40
			set {_m3} to "gold ingot"
			set {_a3} to 8
		else:
			set {_money} to 4500
			set {_m1} to "oak log"
			set {_a1} to 192
			set {_m2} to "iron ingot"
			set {_a2} to 64
			set {_m3} to "diamond"
			set {_a3} to 4
	else if {_kind} is "quarry":
		if {_next} is 1:
			set {_money} to 1200
			set {_m1} to "stone"
			set {_a1} to 160
			set {_m2} to "iron ingot"
			set {_a2} to 20
		else if {_next} is 2:
			set {_money} to 2500
			set {_m1} to "stone"
			set {_a1} to 256
			set {_m2} to "iron ingot"
			set {_a2} to 40
			set {_m3} to "gold ingot"
			set {_a3} to 8
		else:
			set {_money} to 5000
			set {_m1} to "stone"
			set {_a1} to 384
			set {_m2} to "iron ingot"
			set {_a2} to 80
			set {_m3} to "diamond"
			set {_a3} to 4
	else if {_kind} is "ranch":
		if {_next} is 1:
			set {_money} to 1200
			set {_m1} to "hay bale"
			set {_a1} to 40
			set {_m2} to "oak log"
			set {_a2} to 48
		else if {_next} is 2:
			set {_money} to 2800
			set {_m1} to "hay bale"
			set {_a1} to 80
			set {_m2} to "oak log"
			set {_a2} to 64
			set {_m3} to "iron ingot"
			set {_a3} to 20
		else:
			set {_money} to 5500
			set {_m1} to "hay bale"
			set {_a1} to 128
			set {_m2} to "oak log"
			set {_a2} to 96
			set {_m3} to "iron ingot"
			set {_a3} to 40
			set {_m4} to "gold ingot"
			set {_a4} to 8
	if {country.treasury::%{_id}%} is not set:
		set {country.treasury::%{_id}%} to 0
	if {country.treasury::%{_id}%} is less than {_money}:
		send formatted "<red>В казне недостаточно денег. Нужно <gold>%{_money}% монет<red>." to {_p}
		stop
	if {_a1} is greater than 0:
		if countryStorageMaterialCount({_id}, {_m1}) is less than {_a1}:
			send formatted "<red>Не хватает <white>%{_a1}% %{_m1}% <red>в хранилище." to {_p}
			stop
	if {_a2} is greater than 0:
		if countryStorageMaterialCount({_id}, {_m2}) is less than {_a2}:
			send formatted "<red>Не хватает <white>%{_a2}% %{_m2}% <red>в хранилище." to {_p}
			stop
	if {_a3} is greater than 0:
		if countryStorageMaterialCount({_id}, {_m3}) is less than {_a3}:
			send formatted "<red>Не хватает <white>%{_a3}% %{_m3}% <red>в хранилище." to {_p}
			stop
	if {_a4} is greater than 0:
		if countryStorageMaterialCount({_id}, {_m4}) is less than {_a4}:
			send formatted "<red>Не хватает <white>%{_a4}% %{_m4}% <red>в хранилище." to {_p}
			stop
	if {_a1} is greater than 0:
		countryStorageTakeMaterial({_id}, {_m1}, {_a1})
	if {_a2} is greater than 0:
		countryStorageTakeMaterial({_id}, {_m2}, {_a2})
	if {_a3} is greater than 0:
		countryStorageTakeMaterial({_id}, {_m3}, {_a3})
	if {_a4} is greater than 0:
		countryStorageTakeMaterial({_id}, {_m4}, {_a4})
	remove {_money} from {country.treasury::%{_id}%}
	set {country.building::%{_id}%::%{_kind}%} to {_next}
	set {_building-name} to countryBuildingName({_kind})
	send formatted "<light green>%{_building-name}% улучшено до <white>%{_next}% уровня<light green>." to {_p}

command /cstorage:
	aliases: /cstore, /cwarehouse
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		if countryId(player) is "":
			send "<red>Вы не состоите в стране." to player
			stop
		countryOpenStorageHub(player)

command /cdevelopment:
	aliases: /cdev, /cbuildings
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		if countryId(player) is "":
			send "<red>Вы не состоите в стране." to player
			stop
		countryOpenDevelopment2(player)

on inventory open:
	wait 1 tick
	if player is not online:
		stop
	set {_menu-state} to {country.menu::%uuid of player%}
	set {_inv} to player's current inventory
	if {_menu-state} is "main":
		set {_id} to countryId(player)
		if {_id} is "":
			stop
		set {_level} to countryLevel({_id})
		set {_pages} to countryStoragePages({_id})
		set slot 36 of {_inv} to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Категории и быстрый склад" and "<gray>Занятые слоты общие для всех категорий" and "<gray>Страниц: <white>%{_pages}%/2" and "" and "<yellow>Нажмите, чтобы открыть"
		set slot 37 of {_inv} to beacon named "<aqua><bold>РАЗВИТИЕ СТРАНЫ" with lore "<gray>Уровень страны: <white>%{_level}%/3" and "<gray>Виртуальные здания производят" and "<gray>ресурсы каждый реальный час" and "" and "<yellow>Нажмите, чтобы открыть"
		stop
	if {_menu-state} is "role-editor":
		set {_id} to countryId(player)
		set {_role} to {country.selected-role::%uuid of player%}
		if {_id} is "":
			stop
		if {_role} is not set:
			stop
		if {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT} is true:
			set slot 44 of {_inv} to lime dye named "<light green><bold>РАЗВИТИЕ СТРАНЫ" with lore "<green>РАЗРЕШЕНО" and "<gray>Строить и улучшать здания" and "<gray>и повышать уровень страны."
		else:
			set slot 44 of {_inv} to gray dye named "<gray><bold>РАЗВИТИЕ СТРАНЫ" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Строить и улучшать здания" and "<gray>и повышать уровень страны."
		if {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} is true:
			set slot 46 of {_inv} to lime dye named "<light green><bold>ПОПОЛНЯТЬ ХРАНИЛИЩЕ" with lore "<green>РАЗРЕШЕНО" and "<gray>Класть предметы в склад страны"
		else:
			set slot 46 of {_inv} to gray dye named "<gray><bold>ПОПОЛНЯТЬ ХРАНИЛИЩЕ" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Класть предметы в склад страны"
		if {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} is true:
			set slot 47 of {_inv} to lime dye named "<light green><bold>ЗАБИРАТЬ ИЗ ХРАНИЛИЩА" with lore "<green>РАЗРЕШЕНО" and "<gray>Забирать предметы из склада страны"
		else:
			set slot 47 of {_inv} to gray dye named "<gray><bold>ЗАБИРАТЬ ИЗ ХРАНИЛИЩА" with lore "<red>ЗАПРЕЩЕНО" and "<gray>Забирать предметы из склада страны"

on inventory click:
	if event-slot is not set:
		stop
	set {_menu-state} to {country.menu::%uuid of player%}
	set {_slot} to raw index of event-slot
	if {_menu-state} is "main":
		if {_slot} is 36:
			cancel event
			countryOpenStorageHub(player)
			stop
		if {_slot} is 37:
			cancel event
			countryOpenDevelopment2(player)
			stop
	if {_menu-state} is "role-editor":
		if {_slot} is not 44:
			if {_slot} is not 46:
				if {_slot} is not 47:
					stop
		cancel event
		set {_id} to countryId(player)
		set {_role} to {country.selected-role::%uuid of player%}
		if {_id} is "":
			stop
		if {_role} is not set:
			stop
		if countryHasPermission(player, "MANAGE_ROLES") is not true:
			send "<red>У вас нет права настраивать роли." to player
			stop
		if {_slot} is 44:
			if {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::MANAGE_DEVELOPMENT} to true
		else if {_slot} is 46:
			if {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::STORAGE_DEPOSIT} to true
		else:
			if {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} is true:
				delete {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW}
			else:
				set {country.role-perm::%{_id}%::%{_role}%::STORAGE_WITHDRAW} to true
		countryOpenRoleEditor(player, {_role})
		stop
	if {_menu-state} is "development2":
		cancel event
		if {_slot} is 40:
			delete {country.building-menu::%uuid of player%::*}
			countryOpenMain(player)
			stop
		if {_slot} is 4:
			countryTryUpgradeLevel2(player)
			countryOpenDevelopment2(player)
			stop
		if {_slot} is 31:
			if countryStorageCanDeposit(player) is not true:
				send "<red>Нужно право пополнять хранилище, чтобы собрать продукцию." to player
				stop
			countryCollectProduction(player)
			countryOpenDevelopment2(player)
			stop
		set {_kind} to {country.building-menu::%uuid of player%::%{_slot}%}
		if {_kind} is set:
			countryTryUpgradeBuilding2(player, {_kind})
			countryOpenDevelopment2(player)
		stop

on load:
	loop {country.name::*}:
		if {country.level::%loop-index%} is not set:
			set {country.level::%loop-index%} to 1
	countryProcessProduction()

every 5 minutes:
	countryProcessProduction()

on quit:
	delete {country.storage-page::%uuid of player%}
	delete {country.building-menu::%uuid of player%::*}

# =========================================================
# COUNTRY STORAGE V4 - CLEAN REBUILD
# Canonical data:
# {country.storage4::<country>::<category>::<page>::<slot>} = item
# Slots 0..44 are real chest slots. Slots 45..53 are controls only.
# =========================================================

function countryStorageCanManageCategories(p: player) :: boolean:
\tset {_id} to countryId({_p})
\tif {_id} is "":
\t\treturn false
\tif countryIsAdmin({_p}) is true:
\t\treturn true
\tif {country.owner::%{_id}%} is "%uuid of {_p}%":
\t\treturn true
\tif countryHasPermission({_p}, "MANAGE_DEVELOPMENT") is true:
\t\treturn true
\treturn false

function countryStorageCategoryName(id: text, category: text) :: text:
\tif {_category} is "general":
\t\treturn "Общее"
\tif {country.storage-category-name::%{_id}%::%{_category}%} is set:
\t\treturn {country.storage-category-name::%{_id}%::%{_category}%}
\treturn "Категория"

function countryStorageCategoryCount(id: text) :: number:
\tset {_count} to 1
\tloop {country.storage-category-name::%{_id}%::*}:
\t\tadd 1 to {_count}
\treturn {_count}

function countryStorageCategoryKnowsType(id: text, category: text, typeText: text) :: boolean:
\tif {country.storage4-type::%{_id}%::%{_category}%::%{_typeText}%} is true:
\t\treturn true
\treturn false

function countryStorageRememberType(id: text, category: text, storedItem: item):
\tset {_type-text} to "%type of {_storedItem}%"
\tset {country.storage4-type::%{_id}%::%{_category}%::%{_type-text}%} to true

function countryStorageUsedSlots(id: text) :: number:
\tset {_used} to 0
\tloop integers between 1 and countryStoragePages({_id}):
\t\tset {_page} to loop-value
\t\tloop integers between 0 and 44:
\t\t\tif {country.storage4::%{_id}%::general::%{_page}%::%loop-value%} is set:
\t\t\t\tadd 1 to {_used}
\tloop {country.storage-category-name::%{_id}%::*}:
\t\tset {_cat} to loop-index
\t\tloop integers between 1 and countryStoragePages({_id}):
\t\t\tset {_page} to loop-value
\t\t\tloop integers between 0 and 44:
\t\t\t\tif {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%} is set:
\t\t\t\t\tadd 1 to {_used}
\treturn {_used}

function countryStorageCategorySlots(id: text, category: text) :: number:
\tset {_used} to 0
\tloop integers between 1 and countryStoragePages({_id}):
\t\tset {_page} to loop-value
\t\tloop integers between 0 and 44:
\t\t\tif {country.storage4::%{_id}%::%{_category}%::%{_page}%::%loop-value%} is set:
\t\t\t\tadd 1 to {_used}
\treturn {_used}

function countryStoragePutItemInCategory(id: text, category: text, itemToStore: item) :: boolean:
\tset {_item} to {_itemToStore}
\tif {_item} is not set:
\t\treturn false
\tif {_item} is air:
\t\treturn false
\tset {_one} to {_item}
\tset amount of {_one} to 1
\tloop integers between 1 and countryStoragePages({_id}):
\t\tset {_page} to loop-value
\t\tloop integers between 0 and 44:
\t\t\tset {_stored} to {country.storage4::%{_id}%::%{_category}%::%{_page}%::%loop-value%}
\t\t\tif {_stored} is set:
\t\t\t\tset {_stored-one} to {_stored}
\t\t\t\tset amount of {_stored-one} to 1
\t\t\t\tif {_stored-one} is {_one}:
\t\t\t\t\tset {_stored-type} to type of {_stored}
\t\t\t\t\tset {_limit} to maximum stack size of {_stored-type}
\t\t\t\t\tset {_current} to amount of {_stored}
\t\t\t\t\tif {_current} is less than {_limit}:
\t\t\t\t\t\tset {_space} to {_limit} - {_current}
\t\t\t\t\t\tset {_moving} to amount of {_item}
\t\t\t\t\t\tif {_moving} is greater than {_space}:
\t\t\t\t\t\t\tset {_moving} to {_space}
\t\t\t\t\t\tadd {_moving} to {_current}
\t\t\t\t\t\tset amount of {_stored} to {_current}
\t\t\t\t\t\tset {country.storage4::%{_id}%::%{_category}%::%{_page}%::%loop-value%} to {_stored}
\t\t\t\t\t\tset {_remaining} to amount of {_item} - {_moving}
\t\t\t\t\t\tif {_remaining} is less than or equal to 0:
\t\t\t\t\t\t\tcountryStorageRememberType({_id}, {_category}, {_item})
\t\t\t\t\t\t\treturn true
\t\t\t\t\t\tset amount of {_item} to {_remaining}
\tif countryStorageUsedSlots({_id}) is greater than or equal to countryStorageMaxSlots({_id}):
\t\treturn false
\tloop integers between 1 and countryStoragePages({_id}):
\t\tset {_page} to loop-value
\t\tloop integers between 0 and 44:
\t\t\tif {country.storage4::%{_id}%::%{_category}%::%{_page}%::%loop-value%} is not set:
\t\t\t\tset {country.storage4::%{_id}%::%{_category}%::%{_page}%::%loop-value%} to {_item}
\t\t\t\tcountryStorageRememberType({_id}, {_category}, {_item})
\t\t\t\treturn true
\treturn false

function countryStorageMigrate(id: text):
\tif {country.storage4-migrated::%{_id}%} is true:
\t\tstop
\tloop {country.storage::%{_id}%::*}:
\t\tset {_old} to loop-value
\t\tif {_old} is set:
\t\t\tif {_old} is not air:
\t\t\t\tif type of {_old} is not gray stained glass pane:
\t\t\t\t\tcountryStoragePutItemInCategory({_id}, "general", {_old})
\tdelete {country.storage::%{_id}%::*}
\tdelete {country.storage-category::%{_id}%::*}
\tdelete {country.storage-pos::%{_id}%::*}
\tset {country.storage4-migrated::%{_id}%} to true

function countryStorageQuickDeposit(p: player, category: text, mode: text) :: number:
\tset {_id} to countryId({_p})
\tif {_id} is "":
\t\treturn 0
\tcountryStorageMigrate({_id})
\tset {_moved} to 0
\tloop integers between 0 and 35:
\t\tset {_item} to slot loop-value of {_p}'s inventory
\t\tif {_item} is set:
\t\t\tif {_item} is not air:
\t\t\t\tset {_allowed} to true
\t\t\t\tif {_mode} is "MATCHING":
\t\t\t\t\tset {_type-text} to "%type of {_item}%"
\t\t\t\t\tif countryStorageCategoryKnowsType({_id}, {_category}, {_type-text}) is not true:
\t\t\t\t\t\tset {_allowed} to false
\t\t\t\tif {_allowed} is true:
\t\t\t\t\tif countryStoragePutItemInCategory({_id}, {_category}, {_item}) is true:
\t\t\t\t\t\tset slot loop-value of {_p}'s inventory to air
\t\t\t\t\t\tadd 1 to {_moved}
\t\t\t\t\telse:
\t\t\t\t\t\treturn {_moved}
\treturn {_moved}

function countryStorageAutoSortPlayer(p: player) :: number:
\tset {_id} to countryId({_p})
\tif {_id} is "":
\t\treturn 0
\tcountryStorageMigrate({_id})
\tset {_moved} to 0
\tloop integers between 0 and 35:
\t\tset {_item} to slot loop-value of {_p}'s inventory
\t\tif {_item} is set:
\t\t\tif {_item} is not air:
\t\t\t\tset {_type-text} to "%type of {_item}%"
\t\t\t\tset {_target} to ""
\t\t\t\tif countryStorageCategoryKnowsType({_id}, "general", {_type-text}) is true:
\t\t\t\t\tset {_target} to "general"
\t\t\t\tif {_target} is "":
\t\t\t\t\tloop {country.storage-category-name::%{_id}%::*}:
\t\t\t\t\t\tset {_cat} to loop-index
\t\t\t\t\t\tif countryStorageCategoryKnowsType({_id}, {_cat}, {_type-text}) is true:
\t\t\t\t\t\t\tset {_target} to {_cat}
\t\t\t\t\t\t\tstop loop
\t\t\t\tif {_target} is not "":
\t\t\t\t\tif countryStoragePutItemInCategory({_id}, {_target}, {_item}) is true:
\t\t\t\t\t\tset slot loop-value of {_p}'s inventory to air
\t\t\t\t\t\tadd 1 to {_moved}
\treturn {_moved}

function countryOpenStorageHub(p: player):
\tset {_id} to countryId({_p})
\tif {_id} is "":
\t\tsend "<red>Вы не состоите в стране." to {_p}
\t\tstop
\tcountryStorageMigrate({_id})
\tset {_menu} to chest inventory with 6 rows named "<dark gray>Хранилище страны"
\tloop integers between 0 and 53:
\t\tset slot loop-value of {_menu} to gray stained glass pane named " "
\tdelete {country.storage-menu-category::%uuid of {_p}%::*}
\tset {_used} to countryStorageUsedSlots({_id})
\tset {_capacity} to countryStorageMaxSlots({_id})
\tset slot 4 of {_menu} to chest named "<gold><bold>ХРАНИЛИЩЕ СТРАНЫ" with lore "<gray>Занято: <white>%{_used}%/%{_capacity}% слотов" and "<gray>Внутри категорий пустые ячейки — воздух."
\tset {_general-used} to countryStorageCategorySlots({_id}, "general")
\tset slot 10 of {_menu} to chest named "<white><bold>ОБЩЕЕ" with lore "<gray>Занято: <white>%{_general-used}% слотов" and "" and "<yellow>Нажмите, чтобы открыть"
\tset {country.storage-menu-category::%uuid of {_p}%::10} to "general"
\tset {_slots::*} to 11, 12, 13, 14, 15, 16, 19 and 20
\tset {_pos} to 1
\tloop {country.storage-category-name::%{_id}%::*}:
\t\tif {_pos} is greater than size of {_slots::*}:
\t\t\tstop loop
\t\tset {_cat} to loop-index
\t\tset {_slot} to {_slots::%{_pos}%}
\t\tset {_cat-used} to countryStorageCategorySlots({_id}, {_cat})
\t\tset slot {_slot} of {_menu} to barrel named "<yellow><bold>%loop-value%" with lore "<gray>Занято: <white>%{_cat-used}% слотов" and "" and "<yellow>Нажмите, чтобы открыть"
\t\tset {country.storage-menu-category::%uuid of {_p}%::%{_slot}%} to {_cat}
\t\tadd 1 to {_pos}
\tset {_cat-count} to countryStorageCategoryCount({_id})
\tif {_cat-count} is less than 9:
\t\tset slot 31 of {_menu} to name tag named "<light green><bold>СОЗДАТЬ КАТЕГОРИЮ" with lore "<gray>Категорий: <white>%{_cat-count}%/9" and "" and "<yellow>Нажмите, чтобы создать"
\tset slot 32 of {_menu} to hopper named "<aqua><bold>АВТОСОРТИРОВКА"
\tset slot 33 of {_menu} to chest named "<gold><bold>СЛОЖИТЬ ВСЁ В ОБЩЕЕ"
\tset slot 45 of {_menu} to arrow named "<yellow>Назад"
\topen {_menu} to {_p}
\tset {country.menu::%uuid of {_p}%} to "storage-hub"

function countryOpenStorageCategory(p: player, category: text, page: number):
\tset {_id} to countryId({_p})
\tif {_id} is "":
\t\tstop
\tcountryStorageMigrate({_id})
\tset {_pages} to countryStoragePages({_id})
\tif {_page} is less than 1:
\t\tset {_page} to 1
\tif {_page} is greater than {_pages}:
\t\tset {_page} to {_pages}
\tset {_name} to countryStorageCategoryName({_id}, {_category})
\tset {_count} to countryStorageCategorySlots({_id}, {_category})
\tset {_menu} to chest inventory with 6 rows named "<dark gray>%{_name}% • %{_page}%/%{_pages}%"
\tloop integers between 0 and 44:
\t\tset {_stored} to {country.storage4::%{_id}%::%{_category}%::%{_page}%::%loop-value%}
\t\tif {_stored} is set:
\t\t\tset slot loop-value of {_menu} to {_stored}
\t\telse:
\t\t\tset slot loop-value of {_menu} to air
\tloop integers between 45 and 53:
\t\tset slot loop-value of {_menu} to gray stained glass pane named " "
\tset slot 45 of {_menu} to arrow named "<yellow>К категориям"
\tif {_page} is greater than 1:
\t\tset slot 46 of {_menu} to arrow named "<yellow>Предыдущая страница"
\tif {_category} is not "general":
\t\tset slot 47 of {_menu} to name tag named "<yellow><bold>ПЕРЕИМЕНОВАТЬ"
\t\tif {_count} is 0:
\t\t\tset slot 48 of {_menu} to barrier named "<red><bold>УДАЛИТЬ КАТЕГОРИЮ"
\tset {_used-total} to countryStorageUsedSlots({_id})
\tset {_capacity-total} to countryStorageMaxSlots({_id})
\tset slot 49 of {_menu} to barrel named "<gold><bold>%{_name}%" with lore "<gray>В категории: <white>%{_count}% стаков" and "<gray>Общий лимит: <white>%{_used-total}%/%{_capacity-total}%" and "" and "<green>Верхние 45 слотов работают как обычный сундук."
\tset slot 51 of {_menu} to hopper named "<aqua><bold>СЛОЖИТЬ ПОХОЖЕЕ"
\tset slot 52 of {_menu} to chest named "<light green><bold>СЛОЖИТЬ ВСЁ"
\tif {_page} is less than {_pages}:
\t\tset slot 53 of {_menu} to arrow named "<yellow>Следующая страница"
\tset {country.storage-current-category::%uuid of {_p}%} to {_category}
\tset {country.storage-category-page::%uuid of {_p}%} to {_page}
\topen {_menu} to {_p}
\tset {country.menu::%uuid of {_p}%} to "storage-category"

function countryStorageSyncOpenCategory(p: player):
\tif {_p} is not online:
\t\tstop
\tif {country.menu::%uuid of {_p}%} is not "storage-category":
\t\tstop
\tset {_id} to countryId({_p})
\tset {_cat} to {country.storage-current-category::%uuid of {_p}%}
\tset {_page} to {country.storage-category-page::%uuid of {_p}%}
\tif {_id} is "":
\t\tstop
\tif {_cat} is not set:
\t\tstop
\tif {_page} is not set:
\t\tstop
\tset {_inv} to {_p}'s current inventory
\tloop integers between 0 and 44:
\t\tset {_shown} to slot loop-value of {_inv}
\t\tif {_shown} is set:
\t\t\tif {_shown} is not air:
\t\t\t\tset {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%} to {_shown}
\t\t\t\tcountryStorageRememberType({_id}, {_cat}, {_shown})
\t\t\telse:
\t\t\t\tdelete {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%}
\t\telse:
\t\t\tdelete {country.storage4::%{_id}%::%{_cat}%::%{_page}%::%loop-value%}

on chat:
\tif {country.storage-input::%uuid of player%} is not set:
\t\tstop
\tcancel event
\tset {_mode} to {country.storage-input::%uuid of player%}
\tdelete {country.storage-input::%uuid of player%}
\tset {_id} to countryId(player)
\tif {_id} is "":
\t\tstop
\tset {_input} to message
\tif length of {_input} is greater than 20:
\t\tsend "<red>Название категории не должно быть длиннее 20 символов." to player
\t\tstop
\tif {_mode} is "create":
\t\tif countryStorageCanManageCategories(player) is not true:
\t\t\tstop
\t\tif countryStorageCategoryCount({_id}) is greater than or equal to 9:
\t\t\tstop
\t\tif {country.storage-category-seq::%{_id}%} is not set:
\t\t\tset {country.storage-category-seq::%{_id}%} to 0
\t\tadd 1 to {country.storage-category-seq::%{_id}%}
\t\tset {_cat} to "c%{country.storage-category-seq::%{_id}%}%"
\t\tset {country.storage-category-name::%{_id}%::%{_cat}%} to {_input}
\t\tcountryOpenStorageHub(player)
\t\tstop
\tif {_mode} is "rename":
\t\tset {_cat} to {country.storage-current-category::%uuid of player%}
\t\tif {_cat} is not set:
\t\t\tstop
\t\tif {_cat} is "general":
\t\t\tstop
\t\tset {country.storage-category-name::%{_id}%::%{_cat}%} to {_input}
\t\tcountryOpenStorageCategory(player, {_cat}, 1)

on inventory click:
\tset {_state} to {country.menu::%uuid of player%}
\tif {_state} is "storage-hub":
\t\tcancel event
\t\tif event-slot is not set:
\t\t\tstop
\t\tset {_raw} to raw index of event-slot
\t\tset {_id} to countryId(player)
\t\tset {_cat} to {country.storage-menu-category::%uuid of player%::%{_raw}%}
\t\tif {_cat} is set:
\t\t\tcountryOpenStorageCategory(player, {_cat}, 1)
\t\t\tstop
\t\tif {_raw} is 31:
\t\t\tif countryStorageCanManageCategories(player) is true:
\t\t\t\tset {country.storage-input::%uuid of player%} to "create"
\t\t\t\tclose player's inventory
\t\t\t\tsend "<yellow>Введите название новой категории в чат." to player
\t\t\tstop
\t\tif {_raw} is 32:
\t\t\tif countryStorageCanDeposit(player) is true:
\t\t\t\tset {_moved} to countryStorageAutoSortPlayer(player)
\t\t\t\tcountryOpenStorageHub(player)
\t\t\tstop
\t\tif {_raw} is 33:
\t\t\tif countryStorageCanDeposit(player) is true:
\t\t\t\tset {_moved} to countryStorageQuickDeposit(player, "general", "ALL")
\t\t\t\tcountryOpenStorageHub(player)
\t\t\tstop
\t\tif {_raw} is 45:
\t\t\tcountryOpenMain(player)
\t\t\tstop
\t\tstop

\tif {_state} is not "storage-category":
\t\tstop
\tif event-slot is not set:
\t\tstop
\tset {_raw} to raw index of event-slot
\tif {_raw} is between 45 and 53:
\t\tcancel event
\t\tcountryStorageSyncOpenCategory(player)
\t\tset {_id} to countryId(player)
\t\tset {_cat} to {country.storage-current-category::%uuid of player%}
\t\tset {_page} to {country.storage-category-page::%uuid of player%}
\t\tif {_raw} is 45:
\t\t\tcountryOpenStorageHub(player)
\t\t\tstop
\t\tif {_raw} is 46:
\t\t\tif {_page} is greater than 1:
\t\t\t\tcountryOpenStorageCategory(player, {_cat}, {_page} - 1)
\t\t\tstop
\t\tif {_raw} is 47:
\t\t\tif {_cat} is not "general":
\t\t\t\tif countryStorageCanManageCategories(player) is true:
\t\t\t\t\tset {country.storage-input::%uuid of player%} to "rename"
\t\t\t\t\tclose player's inventory
\t\t\t\t\tsend "<yellow>Введите новое название категории в чат." to player
\t\t\tstop
\t\tif {_raw} is 48:
\t\t\tif {_cat} is not "general":
\t\t\t\tif countryStorageCanManageCategories(player) is true:
\t\t\t\t\tif countryStorageCategorySlots({_id}, {_cat}) is 0:
\t\t\t\t\t\tdelete {country.storage-category-name::%{_id}%::%{_cat}%}
\t\t\t\t\t\tdelete {country.storage4-type::%{_id}%::%{_cat}%::*}
\t\t\t\t\t\tdelete {country.storage4::%{_id}%::%{_cat}%::*}
\t\t\t\t\t\tcountryOpenStorageHub(player)
\t\t\tstop
\t\tif {_raw} is 51:
\t\t\tif countryStorageCanDeposit(player) is true:
\t\t\t\tset {_moved} to countryStorageQuickDeposit(player, {_cat}, "MATCHING")
\t\t\t\tcountryOpenStorageCategory(player, {_cat}, {_page})
\t\t\tstop
\t\tif {_raw} is 52:
\t\t\tif countryStorageCanDeposit(player) is true:
\t\t\t\tset {_moved} to countryStorageQuickDeposit(player, {_cat}, "ALL")
\t\t\t\tcountryOpenStorageCategory(player, {_cat}, {_page})
\t\t\tstop
\t\tif {_raw} is 53:
\t\t\tif {_page} is less than countryStoragePages({_id}):
\t\t\t\tcountryOpenStorageCategory(player, {_cat}, {_page} + 1)
\t\t\tstop
\t\tstop

\t# Owners/admins and roles with both rights get fully native chest behaviour.
\tif countryStorageCanDeposit(player) is true:
\t\tif countryStorageCanWithdraw(player) is true:
\t\t\twait 1 tick
\t\t\tcountryStorageSyncOpenCategory(player)
\t\t\tstop
\t# Restricted roles use directional Shift-click only.
\tif {_raw} is between 0 and 44:
\t\tif countryStorageCanWithdraw(player) is not true:
\t\t\tcancel event
\t\t\tstop
\telse if {_raw} is greater than or equal to 54:
\t\tif click type is left mouse button with shift:
\t\t\tif countryStorageCanDeposit(player) is not true:
\t\t\t\tcancel event
\t\t\t\tstop
\t\tif click type is right mouse button with shift:
\t\t\tif countryStorageCanDeposit(player) is not true:
\t\t\t\tcancel event
\t\t\t\tstop
\twait 1 tick
\tcountryStorageSyncOpenCategory(player)

on inventory drag:
\tif {country.menu::%uuid of player%} is not "storage-category":
\t\tstop
\tif countryStorageCanDeposit(player) is not true:
\t\tcancel event
\t\tstop
\twait 1 tick
\tcountryStorageSyncOpenCategory(player)

on inventory close:
\tif {country.menu::%uuid of player%} is "storage-category":
\t\tcountryStorageSyncOpenCategory(player)
\tdelete {country.storage-menu-category::%uuid of player%::*}
\tdelete {country.storage-current-category::%uuid of player%}
\tdelete {country.storage-category-page::%uuid of player%}

on quit:
\tdelete {country.storage-menu-category::%uuid of player%::*}
\tdelete {country.storage-current-category::%uuid of player%}
\tdelete {country.storage-category-page::%uuid of player%}
\tdelete {country.storage-input::%uuid of player%}
\tdelete {country.storage-view::%uuid of player%::*}

