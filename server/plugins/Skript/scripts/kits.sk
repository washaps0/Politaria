# =========================================================
# POLITARIA - KITS SHOP
# Requires economy.sk
# Uses: {economy.balance::<uuid>}
# =========================================================

options:
    kits-currency: монет

# =========================================================
# KIT PRICES
# =========================================================

function kitPrice(id: text) :: number:
    if {_id} is "starter":
        return 50
    if {_id} is "iron":
        return 200
    if {_id} is "diamond":
        return 750
    if {_id} is "netherite":
        return 2000
    return 0

# =========================================================
# GIVE KIT ITEMS
# =========================================================

function giveKit(p: player, id: text):
    if {_id} is "starter":
        give leather helmet to {_p}
        give leather chestplate to {_p}
        give leather leggings to {_p}
        give leather boots to {_p}
        give iron pickaxe to {_p}
        give stone axe to {_p}
        give stone sword to {_p}
        give 16 cooked beef to {_p}
        give 8 torch to {_p}
        stop

    if {_id} is "iron":
        give iron helmet to {_p}
        give iron chestplate to {_p}
        give iron leggings to {_p}
        give iron boots to {_p}
        give iron sword to {_p}
        give iron pickaxe to {_p}
        give iron axe to {_p}
        give 32 cooked beef to {_p}
        give 16 torch to {_p}
        stop

    if {_id} is "diamond":
        give diamond helmet to {_p}
        give diamond chestplate to {_p}
        give diamond leggings to {_p}
        give diamond boots to {_p}
        give diamond sword to {_p}
        give diamond pickaxe to {_p}
        give diamond axe to {_p}
        give 64 cooked beef to {_p}
        give 32 torch to {_p}
        give 8 golden apple to {_p}
        stop

    if {_id} is "netherite":
        give netherite helmet to {_p}
        give netherite chestplate to {_p}
        give netherite leggings to {_p}
        give netherite boots to {_p}
        give netherite sword to {_p}
        give netherite pickaxe to {_p}
        give netherite axe to {_p}
        give 64 cooked beef to {_p}
        give 64 torch to {_p}
        give 16 golden apple to {_p}

# =========================================================
# OPEN KIT SHOP
# =========================================================

function openKitsMenu(p: player):
    economyEnsure({_p})

    set {_menu} to chest inventory with 4 rows named "<dark gray>Магазин китов"

    loop integers between 0 and 35:
        set slot loop-value of {_menu} to gray stained glass pane named " "

    set {_starter-price} to kitPrice("starter")
    set slot 10 of {_menu} to leather chestplate named "<green><bold>НОВИЧОК" with lore "<gray>Кожаная броня" and "<gray>Железная кирка" and "<gray>Каменный меч и топор" and "<gray>16 стейков" and "<gray>8 факелов" and "" and "<yellow>Цена: <white>%{_starter-price}% {@kits-currency}" and "<green>Нажмите, чтобы купить"

    set {_iron-price} to kitPrice("iron")
    set slot 12 of {_menu} to iron chestplate named "<white><bold>ЖЕЛЕЗНЫЙ" with lore "<gray>Полный железный сет" and "<gray>Железный меч" and "<gray>Железная кирка и топор" and "<gray>32 стейка" and "<gray>16 факелов" and "" and "<yellow>Цена: <white>%{_iron-price}% {@kits-currency}" and "<green>Нажмите, чтобы купить"

    set {_diamond-price} to kitPrice("diamond")
    set slot 14 of {_menu} to diamond chestplate named "<aqua><bold>АЛМАЗНЫЙ" with lore "<gray>Полный алмазный сет" and "<gray>Алмазный меч" and "<gray>Алмазная кирка и топор" and "<gray>64 стейка" and "<gray>32 факела" and "<gray>8 золотых яблок" and "" and "<yellow>Цена: <white>%{_diamond-price}% {@kits-currency}" and "<green>Нажмите, чтобы купить"

    set {_netherite-price} to kitPrice("netherite")
    set slot 16 of {_menu} to netherite chestplate named "<dark gray><bold>НЕЗЕРИТОВЫЙ" with lore "<gray>Полный незеритовый сет" and "<gray>Незеритовый меч" and "<gray>Незеритовая кирка и топор" and "<gray>64 стейка" and "<gray>64 факела" and "<gray>16 золотых яблок" and "" and "<yellow>Цена: <white>%{_netherite-price}% {@kits-currency}" and "<green>Нажмите, чтобы купить"

    set slot 31 of {_menu} to gold nugget named "<gold><bold>ВАШ БАЛАНС" with lore "<white>%economyBalance({_p})% {@kits-currency}"

    open {_menu} to {_p}
    set {kits.menu::%uuid of {_p}%} to true

# =========================================================
# BUY KIT
# =========================================================

function buyKit(p: player, id: text, displayName: text):
    economyEnsure({_p})

    set {_price} to kitPrice({_id})

    if {_price} <= 0:
        send "<red>Этот кит не существует." to {_p}
        stop

    set {_balance} to economyBalance({_p})

    if {_balance} < {_price}:
        set {_missing} to {_price} - {_balance}
        send formatted "<red>Недостаточно денег. <gray>Не хватает: <white>%{_missing}% {@kits-currency}<gray>." to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop

    remove {_price} from {economy.balance::%uuid of {_p}%}

    giveKit({_p}, {_id})

    send formatted "<green>Вы купили кит <white>%{_displayName}% <green>за <white>%{_price}% {@kits-currency}<green>." to {_p}
    play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 to {_p}

    openKitsMenu({_p})

# =========================================================
# COMMANDS
# =========================================================

command /kits:
    aliases: /kit
    executable by: players
    trigger:
        if {auth.logged-in::%name of player%} is not true:
            send "<red>Сначала войдите в аккаунт." to player
            stop

        openKitsMenu(player)

# =========================================================
# GUI CLICK
# =========================================================

on inventory click:
    if {kits.menu::%uuid of player%} is not set:
        stop

    cancel event

    if {kits.click-until::%uuid of player%} is in the future:
        stop

    set {kits.click-until::%uuid of player%} to 8 ticks from now

    if event-slot is not set:
        stop

    set {_slot} to raw index of event-slot

    if {_slot} is 10:
        buyKit(player, "starter", "Новичок")
        stop

    if {_slot} is 12:
        buyKit(player, "iron", "Железный")
        stop

    if {_slot} is 14:
        buyKit(player, "diamond", "Алмазный")
        stop

    if {_slot} is 16:
        buyKit(player, "netherite", "Незеритовый")
        stop

# =========================================================
# GUI PROTECTION
# =========================================================

on inventory drag:
    if {kits.menu::%uuid of player%} is set:
        cancel event

on inventory close:
    if {kits.menu::%uuid of player%} is set:
        delete {kits.menu::%uuid of player%}

on quit:
    delete {kits.menu::%uuid of player%}
    delete {kits.click-until::%uuid of player%}
