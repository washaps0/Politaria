    return ""

function hunterAddXP(p: player, amount: number):
    set {_old-level} to hunterLevel({_p})
    if {_old-level} >= 10:
        stop
    add {_amount} to {skills.hunter.xp::%uuid of {_p}%}
    set {_new-level} to hunterLevel({_p})
    set {_xp} to hunterXP({_p})
    set {_working} to false
    if skillsCurrentJob({_p}) is "hunter":
        set {_working} to true

    if {_new-level} > {_old-level}:
        send "{@skills-prefix} &fНавык &cОхотник &fповышен до &c%{_new-level}% уровня&f!" to {_p}
        if {_working} is false:
            send action bar formatted "<red><bold>⚔ ОХОТНИК</bold> <dark_gray>» <green><bold>УРОВЕНЬ %{_new-level}%!" to {_p}
        if {_old-level} < 4:
            if {_new-level} >= 4:
                send "{@skills-prefix} &fОткрыт навык охотника: &cАвтоподбор добычи&f." to {_p}
        if {_new-level} >= 10:
            send "{@skills-prefix} &6Охотник достиг максимального уровня!" to {_p}
        stop

    if {_working} is true:
        stop

    set {_needed} to skillNextXP({_new-level})
    send action bar formatted "<red>⚔ Охотник <dark_gray>• <white>%{_xp}%<gray>/%{_needed}% XP <dark_gray>• <green>+%{_amount}% XP" to {_p}

on death:
    set {_killer} to attacker
    if {_killer} is not set:
        stop
    if {_killer} is a projectile:
        set {_killer} to shooter of {_killer}
    if {_killer} is not a player:
        stop

    set {_p} to {_killer}
    set {_kind} to type of victim
    set {_earned-xp} to hunterMobXP({_kind})
    if {_earned-xp} <= 0:
        stop

    set {_working} to false
    if skillsCurrentJob({_p}) is "hunter":
        set {_working} to true

    set {_level} to hunterLevel({_p})
    set {_loc} to location of victim

    if {_working} is false:
        if {_level} >= 4:
            set {_drops::*} to drops
            clear drops
            loop {_drops::*}:
                if {_p} can hold loop-value:
                    give loop-value to {_p}
                else:
                    drop loop-value at {_loc}

    hunterAddXP({_p}, {_earned-xp})

    # Во время работы охотником jobs.sk полностью управляет дропом.
    if {_working} is true:
        stop

    set {_chance} to hunterChance({_p})
    chance of {_chance}%:
        set {_bonus-name} to hunterBonus({_kind})
        if {_bonus-name} is "":
            stop
        set {_bonus} to {_bonus-name} parsed as item type
        if {_bonus} is not set:
            stop
        if {_level} >= 4:
            if {_p} can hold 1 of {_bonus}:
                give 1 of {_bonus} to {_p}
            else:
                drop 1 of {_bonus} at {_loc}
        else:
            drop 1 of {_bonus} at {_loc}
        send action bar formatted "<red>⚔ <green><bold>УДАЧНАЯ ОХОТА!</bold> <white>Получена дополнительная добыча." to {_p}

# =========================================================
# LUMBERJACK
# =========================================================

function lumberjackXP(p: player) :: number:
    if {skills.lumberjack.xp::%uuid of {_p}%} is not set:
        set {skills.lumberjack.xp::%uuid of {_p}%} to 0
    return {skills.lumberjack.xp::%uuid of {_p}%}

function lumberjackLevel(p: player) :: number:
    return skillLevelFromXP(lumberjackXP({_p}))

function lumberjackChance(p: player) :: number:
    return lumberjackLevel({_p}) * 2

function lumberjackLogXP(name: text) :: number:
    if {_name} is "oak log":
        return 1
    if {_name} is "stripped oak log":
        return 1
    if {_name} is "spruce log":
        return 1
    if {_name} is "stripped spruce log":
        return 1
    if {_name} is "birch log":
        return 1
    if {_name} is "stripped birch log":
        return 1
    if {_name} is "jungle log":
        return 1
    if {_name} is "stripped jungle log":
        return 1
    if {_name} is "acacia log":
        return 1
    if {_name} is "stripped acacia log":
        return 1
    if {_name} is "dark oak log":
        return 1
    if {_name} is "stripped dark oak log":
        return 1
    if {_name} is "mangrove log":
        return 1
    if {_name} is "stripped mangrove log":
        return 1
    if {_name} is "cherry log":
        return 1
    if {_name} is "stripped cherry log":
        return 1
    if {_name} is "crimson stem":
        return 2
    if {_name} is "stripped crimson stem":
        return 2
    if {_name} is "warped stem":
        return 2
    if {_name} is "stripped warped stem":
        return 2
    return 0

function lumberjackAddXP(p: player, amount: number):
    set {_old-level} to lumberjackLevel({_p})
    if {_old-level} >= 10:
        stop
    add {_amount} to {skills.lumberjack.xp::%uuid of {_p}%}
    set {_new-level} to lumberjackLevel({_p})
    set {_xp} to lumberjackXP({_p})
    set {_working} to false
    if skillsCurrentJob({_p}) is "lumberjack":
        set {_working} to true

    if {_new-level} > {_old-level}:
        send "{@skills-prefix} &fНавык &6Лесоруб &fповышен до &6%{_new-level}% уровня&f!" to {_p}
        if {_working} is false:
            send action bar formatted "<gold><bold>🪓 ЛЕСОРУБ</bold> <dark_gray>» <green><bold>УРОВЕНЬ %{_new-level}%!" to {_p}
        if {_old-level} < 4:
            if {_new-level} >= 4:
                send "{@skills-prefix} &fОткрыт навык лесоруба: &6Автоподбор&f." to {_p}
        if {_new-level} >= 10:
            send "{@skills-prefix} &6Лесоруб достиг максимального уровня!" to {_p}
        stop

    if {_working} is true:
        stop

    set {_needed} to skillNextXP({_new-level})
    send action bar formatted "<gold>🪓 Лесоруб <dark_gray>• <white>%{_xp}%<gray>/%{_needed}% XP <dark_gray>• <green>+%{_amount}% XP" to {_p}

on break with priority monitor:
    if event is cancelled:
        stop

    set {_name} to lowercase "%type of event-block%"
    set {_earned-xp} to lumberjackLogXP({_name})
    if {_earned-xp} <= 0:
        stop

    if {skills.lumberjack.placed::%location of event-block%} is set:
        delete {skills.lumberjack.placed::%location of event-block%}
        stop

    set {_working} to false
    if skillsCurrentJob(player) is "lumberjack":
        set {_working} to true

    set {_kind} to type of event-block
    set {_level} to lumberjackLevel(player)
    set {_loc} to location of event-block

    if {_working} is false:
        set {_drops::*} to drops of event-block using player's tool as player
        if {_level} >= 4:
            clear drops
            loop {_drops::*}:
                if player can hold loop-value:
                    give loop-value to player
                else:
                    drop loop-value at {_loc}

    lumberjackAddXP(player, {_earned-xp})

    # Во время работы лесорубом jobs.sk полностью управляет дропом.
    if {_working} is true:
        stop

    set {_chance} to lumberjackChance(player)
    chance of {_chance}%:
        if player can hold 1 of {_kind}:
            give 1 of {_kind} to player
        else:
            drop 1 of {_kind} at {_loc}
        send action bar formatted "<gold>🪓 <green><bold>УДАЧНАЯ РУБКА!</bold> <white>Получено дополнительное бревно." to player

# =========================================================
# ANTI-FARM TRACKING
# =========================================================

on place:
    set {_name} to lowercase "%type of event-block%"

    if miningOreXP({_name}) > 0:
        set {skills.mining.placed::%location of event-block%} to true

    if lumberjackLogXP({_name}) > 0:
        set {skills.lumberjack.placed::%location of event-block%} to true

    if farmingCropXP({_name}) > 0:
        set {skills.farming.placed::%location of event-block%} to true

on grow:
    if {skills.farming.placed::%location of event-block%} is set:
        delete {skills.farming.placed::%location of event-block%}

# =========================================================
# /SKILLS
# =========================================================

command /skills:
    executable by: players
    trigger:
        set {_mining-xp} to miningXP(player)
        set {_mining-level} to miningLevel(player)
        set {_crafting-xp} to craftingXP(player)
        set {_crafting-level} to craftingLevel(player)
        set {_farming-xp} to farmingXP(player)
        set {_farming-level} to farmingLevel(player)
        set {_hunter-xp} to hunterXP(player)
        set {_hunter-level} to hunterLevel(player)
        set {_lumber-xp} to lumberjackXP(player)
        set {_lumber-level} to lumberjackLevel(player)

        send ""
        send "&b&lPOLITARIA &8— &fНавыки"
        send ""

        if {_mining-level} >= 10:
            send "&fШахтёрство: &b10&7/10 &8(&aMAX&8)"
        else:
            set {_next} to skillNextXP({_mining-level})
            send "&fШахтёрство: &b%{_mining-level}%&7/10 &8(&f%{_mining-xp}%&7/%{_next}% XP&8)"
        set {_chance} to miningChance(player)
        send "  &7Шанс дополнительной руды: &b%{_chance}%%%"
        if {_mining-level} >= 4:
            send "  &a✔ &7Автоподбор"
        else:
            send "  &8✖ &7Автоподбор &8— уровень 4"
        send ""

        if {_crafting-level} >= 10:
            send "&fКрафт: &e10&7/10 &8(&aMAX&8)"
        else:
            set {_next} to skillNextXP({_crafting-level})
            send "&fКрафт: &e%{_crafting-level}%&7/10 &8(&f%{_crafting-xp}%&7/%{_next}% XP&8)"
        set {_chance} to craftingChance(player)
        send "  &7Шанс улучшения: &e%{_chance}%%%"
        send ""

        if {_farming-level} >= 10:
            send "&fФермерство: &a10&7/10 &8(&aMAX&8)"
        else:
            set {_next} to skillNextXP({_farming-level})
            send "&fФермерство: &a%{_farming-level}%&7/10 &8(&f%{_farming-xp}%&7/%{_next}% XP&8)"
        set {_chance} to farmingChance(player)
        send "  &7Шанс дополнительного урожая: &a%{_chance}%%%"
        if {_farming-level} >= 4:
            send "  &a✔ &7Автоподбор"
        else:
            send "  &8✖ &7Автоподбор &8— уровень 4"
        if {_farming-level} >= 6:
            send "  &a✔ &7Автопосадка базовых культур"
        else:
            send "  &8✖ &7Автопосадка &8— уровень 6"
        send ""

        if {_hunter-level} >= 10:
            send "&fОхотник: &c10&7/10 &8(&aMAX&8)"
        else:
            set {_next} to skillNextXP({_hunter-level})
            send "&fОхотник: &c%{_hunter-level}%&7/10 &8(&f%{_hunter-xp}%&7/%{_next}% XP&8)"
        set {_chance} to hunterChance(player)
        send "  &7Шанс дополнительной добычи: &c%{_chance}%%%"
        if {_hunter-level} >= 4:
            send "  &a✔ &7Автоподбор добычи"
        else:
            send "  &8✖ &7Автоподбор добычи &8— уровень 4"
        send ""

        if {_lumber-level} >= 10:
            send "&fЛесоруб: &610&7/10 &8(&aMAX&8)"
        else:
            set {_next} to skillNextXP({_lumber-level})
            send "&fЛесоруб: &6%{_lumber-level}%&7/10 &8(&f%{_lumber-xp}%&7/%{_next}% XP&8)"
        set {_chance} to lumberjackChance(player)
        send "  &7Шанс дополнительного дерева: &6%{_chance}%%%"
        if {_lumber-level} >= 4:
            send "  &a✔ &7Автоподбор"
        else:
            send "  &8✖ &7Автоподбор &8— уровень 4"
        send ""

# =========================================================
# ADMIN
# =========================================================

command /skillset <text> <number>:
    permission: politaria.admin
    executable by: players
    trigger:
        if arg-2 < 1:
            send "{@skills-prefix} &cМинимальный уровень: 1"
            stop
        if arg-2 > 10:
            send "{@skills-prefix} &cМаксимальный уровень: 10"
            stop

        set {_skill} to lowercase arg-1
        set {_xp} to skillXPForLevel(arg-2)

        if {_skill} is "mining":
            set {skills.mining.xp::%uuid of player%} to {_xp}
            send "{@skills-prefix} &fШахтёрство установлено на уровень &b%arg-2%&f."
            stop
        if {_skill} is "crafting":
            set {skills.crafting.xp::%uuid of player%} to {_xp}
            send "{@skills-prefix} &fКрафт установлен на уровень &e%arg-2%&f."
            stop
        if {_skill} is "farming":
            set {skills.farming.xp::%uuid of player%} to {_xp}
            send "{@skills-prefix} &fФермерство установлено на уровень &a%arg-2%&f."
            stop
        if {_skill} is "hunter":
            set {skills.hunter.xp::%uuid of player%} to {_xp}
            send "{@skills-prefix} &fОхотник установлен на уровень &c%arg-2%&f."
            stop
        if {_skill} is "lumberjack":
            set {skills.lumberjack.xp::%uuid of player%} to {_xp}
            send "{@skills-prefix} &fЛесоруб установлен на уровень &6%arg-2%&f."
            stop

        send "{@skills-prefix} &7Использование: &f/skillset <mining/crafting/farming/hunter/lumberjack> <1-10>"

# =========================================================
# DEBUG
# =========================================================

command /skilldebug:
    permission: politaria.admin
    executable by: players
    trigger:
        send ""
        send "&b&lSKILLS DEBUG"
        send "&7Mining XP: &f%miningXP(player)%"
        send "&7Mining level: &f%miningLevel(player)%"
        send ""
        send "&7Crafting XP: &f%craftingXP(player)%"
        send "&7Crafting level: &f%craftingLevel(player)%"
        send ""
        send "&7Farming XP: &f%farmingXP(player)%"
        send "&7Farming level: &f%farmingLevel(player)%"
        send ""
        send "&7Hunter XP: &f%hunterXP(player)%"
        send "&7Hunter level: &f%hunterLevel(player)%"
        send ""
        send "&7Lumberjack XP: &f%lumberjackXP(player)%"
        send "&7Lumberjack level: &f%lumberjackLevel(player)%"
        send "&7Current job: &f%skillsCurrentJob(player)%"
        send ""