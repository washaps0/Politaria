options:
	economy-currency: монет
	economy-start-balance: 200
	economy-max-transaction: 100000000

# Internal Politaria economy.
# {economy.balance::<uuid>} stores personal money.
# {country.treasury::<country id>} stores country money.

function economyEnsure(p: player):
	if {economy.balance::%uuid of {_p}%} is not set:
		set {economy.balance::%uuid of {_p}%} to {@economy-start-balance}

function economyBalance(p: player) :: number:
	economyEnsure({_p})
	return {economy.balance::%uuid of {_p}%}

function economyTreasury(id: text) :: number:
	if {country.treasury::%{_id}%} is not set:
		set {country.treasury::%{_id}%} to 0
	return {country.treasury::%{_id}%}

function economyOpenCountryMenu(p: player):
	economyEnsure({_p})
	set {_id} to countryId({_p})
	set {_menu} to chest inventory with 3 rows named "<dark gray>Деньги и казна"
	loop integers between 0 and 26:
		set slot loop-value of {_menu} to gray stained glass pane named " "
	set slot 4 of {_menu} to gold nugget named "<gold><bold>ВАШ БАЛАНС" with lore "<white>%economyBalance({_p})% {@economy-currency}"
	if {_id} is not "":
		set {_daily-tax} to countryDailyTax({_id})
		set slot 13 of {_menu} to chest named "<yellow><bold>КАЗНА СТРАНЫ" with lore "<white>%economyTreasury({_id})% {@economy-currency}" and "<gray>Страна: %countryColor({_id})%%countryName({_id})%" and "" and "<gray>Чанков: <white>%countryClaimCount({_id})%" and "<gray>Плата в сутки: <gold>%{_daily-tax}% {@economy-currency}"
		set slot 11 of {_menu} to lime dye named "<light green><bold>ВНЕСТИ В КАЗНУ" with lore "<gray>Сумма вводится в чат"
		if countryHasPermission({_p}, "TREASURY_WITHDRAW") is true:
			set slot 15 of {_menu} to red dye named "<red><bold>СНЯТЬ ИЗ КАЗНЫ" with lore "<gray>Перевести средства на личный баланс" and "<dark gray>Доступно вашей роли"
	set slot 22 of {_menu} to arrow named "<yellow>Назад"
	open {_menu} to {_p}
	set {economy.menu::%uuid of {_p}%} to "country"

function economyStartTransfer(sender: player, target: player):
	economyEnsure({_sender})
	economyEnsure({_target})
	set {economy.input::%uuid of {_sender}%} to "transfer"
	set {economy.target::%uuid of {_sender}%} to uuid of {_target}
	close {_sender}'s inventory
	send formatted "<gold>Введите сумму для передачи игроку <white>%name of {_target}% <gold>в чат." to {_sender}
	send formatted "<gray>Ваш баланс: <white>%economyBalance({_sender})% {@economy-currency}<gray>." to {_sender}

command /money:
	aliases: /balance, /bal
	executable by: players
	trigger:
		if {auth.logged-in::%name of player%} is not true:
			send "<red>Сначала войдите в аккаунт." to player
			stop
		economyOpenCountryMenu(player)

# Administrative balance editor. Works for online and offline players.
# /moneyadmin add <player> <amount>
# /moneyadmin remove <player> <amount>
# /moneyadmin set <player> <amount>
command /moneyadmin <text> <offlineplayer> <number>:
	aliases: /economyadmin, /eco
	permission: politaria.economy.admin
	permission message: <red>У вас нет права изменять баланс игроков.
	trigger:
		set {_action} to lowercase arg-1
		if {_action} is not "add":
			if {_action} is not "remove":
				if {_action} is not "set":
					send "<red>Использование: /moneyadmin <add|remove|set> <игрок> <сумма>" to sender
					stop

		set {_target} to arg-2
		set {_amount} to arg-3
		set {_amount} to round({_amount} * 100) / 100
		if {_amount} is less than 0:
			send "<red>Сумма не может быть отрицательной." to sender
			stop
		if {_action} is not "set":
			if {_amount} is 0:
				send "<red>Для добавления или снятия укажите сумму больше нуля." to sender
				stop
		if {_amount} is greater than {@economy-max-transaction}:
			send "<red>Максимальная сумма: <white>{@economy-max-transaction}<red>." to sender
			stop

		set {_target-id} to uuid of {_target}
		if {economy.balance::%{_target-id}%} is not set:
			set {economy.balance::%{_target-id}%} to {@economy-start-balance}
		set {_old} to {economy.balance::%{_target-id}%}

		if {_action} is "add":
			set {_new} to {_old} + {_amount}
			if {_new} is greater than {@economy-max-transaction}:
				send "<red>После добавления баланс превысит максимум <white>{@economy-max-transaction}<red>." to sender
				stop
		if {_action} is "remove":
			set {_new} to {_old} - {_amount}
			if {_new} is less than 0:
				set {_new} to 0
		if {_action} is "set":
			set {_new} to {_amount}

		set {economy.balance::%{_target-id}%} to {_new}
		send formatted "<green>Баланс игрока <white>%name of {_target}% <green>изменён: <white>%{_old}% <gray>→ <white>%{_new}% {@economy-currency}<green>." to sender
		set {_online-target} to player from {_target-id}
		if {_online-target} is set:
			send formatted "<yellow>Администратор изменил ваш баланс: <white>%{_old}% <gray>→ <white>%{_new}% {@economy-currency}<yellow>." to {_online-target}

on join:
	economyEnsure(player)

on inventory click:
	if {economy.menu::%uuid of player%} is not set:
		stop
	cancel event
	if {ui.click-until::%uuid of player%} is in the future:
		stop
	set {ui.click-until::%uuid of player%} to 8 ticks from now
	if event-slot is not set:
		stop
	set {_slot} to raw index of event-slot
	set {_id} to countryId(player)
	if {_slot} is 22:
		if {_id} is "":
			close player's inventory
		else:
			countryOpenMain(player)
		stop
	if {_id} is "":
		stop
	if {_slot} is 11:
		set {economy.input::%uuid of player%} to "deposit"
		set {economy.country::%uuid of player%} to {_id}
		close player's inventory
		send formatted "<yellow>Введите сумму для внесения в казну. <gray>Баланс: <white>%economyBalance(player)% {@economy-currency}<gray>." to player
		stop
	if {_slot} is 15:
		if countryHasPermission(player, "TREASURY_WITHDRAW") is not true:
			send "<red>У вашей роли нет права снимать деньги из казны." to player
			stop
		set {economy.input::%uuid of player%} to "withdraw"
		set {economy.country::%uuid of player%} to {_id}
		close player's inventory
		send formatted "<yellow>Введите сумму для снятия из казны. <gray>Казна: <white>%economyTreasury({_id})% {@economy-currency}<gray>." to player

on inventory drag:
	if {economy.menu::%uuid of player%} is set:
		cancel event

on inventory close:
	if {economy.menu::%uuid of player%} is set:
		delete {economy.menu::%uuid of player%}

on chat:
	if {economy.input::%uuid of player%} is not set:
		stop
	cancel event
	set {_mode} to {economy.input::%uuid of player%}
	set {_amount} to unformatted message parsed as number
	if {_amount} is not set:
		send "<red>Введите сумму числом." to player
		stop
	set {_amount} to rounded down {_amount}
	if {_amount} is less than 1:
		send "<red>Сумма должна быть больше нуля." to player
		stop
	if {_amount} is greater than {@economy-max-transaction}:
		send "<red>Сумма одной операции слишком большая." to player
		stop

	if {_mode} is "transfer":
		set {_target-id} to {economy.target::%uuid of player%}
		set {_target} to player from {_target-id}
		if {_target} is not set:
			delete {economy.input::%uuid of player%}
			delete {economy.target::%uuid of player%}
			send "<red>Игрок вышел с сервера. Перевод отменён." to player
			stop
		economyEnsure(player)
		economyEnsure({_target})
		if economyBalance(player) is less than {_amount}:
			send "<red>На вашем балансе недостаточно денег." to player
			stop
		remove {_amount} from {economy.balance::%uuid of player%}
		add {_amount} to {economy.balance::%uuid of {_target}%}
		delete {economy.input::%uuid of player%}
		delete {economy.target::%uuid of player%}
		send formatted "<green>Вы передали <white>%{_amount}% {@economy-currency} <green>игроку <white>%name of {_target}%<green>." to player
		send formatted "<gold>%name of player% <green>передал вам <white>%{_amount}% {@economy-currency}<green>." to {_target}
		stop

	set {_id} to {economy.country::%uuid of player%}
	if {_id} is not countryId(player):
		delete {economy.input::%uuid of player%}
		delete {economy.country::%uuid of player%}
		send "<red>Вы больше не состоите в этой стране. Операция отменена." to player
		stop

	if {_mode} is "deposit":
		if economyBalance(player) is less than {_amount}:
			send "<red>На вашем балансе недостаточно денег." to player
			stop
		remove {_amount} from {economy.balance::%uuid of player%}
		add {_amount} to {country.treasury::%{_id}%}
		delete {economy.input::%uuid of player%}
		delete {economy.country::%uuid of player%}
		send formatted "<green>В казну внесено <white>%{_amount}% {@economy-currency}<green>." to player
		stop

	if {_mode} is "withdraw":
		if countryHasPermission(player, "TREASURY_WITHDRAW") is not true:
			delete {economy.input::%uuid of player%}
			delete {economy.country::%uuid of player%}
			send "<red>У вас больше нет права снимать деньги из казны." to player
			stop
		if economyTreasury({_id}) is less than {_amount}:
			send "<red>В казне недостаточно денег." to player
			stop
		remove {_amount} from {country.treasury::%{_id}%}
		add {_amount} to {economy.balance::%uuid of player%}
		delete {economy.input::%uuid of player%}
		delete {economy.country::%uuid of player%}
		send formatted "<green>Из казны снято <white>%{_amount}% {@economy-currency}<green>." to player

on quit:
	delete {economy.menu::%uuid of player%}
	delete {economy.input::%uuid of player%}
	delete {economy.target::%uuid of player%}
	delete {economy.country::%uuid of player%}
