# ============================================================
#  GUNSHOP.SK — оружейный магазин /gunshop (чистый Skript 2.15.4)
#  Требует gun.sk (функция gunItem, переменные оружия)
#  3 категории: Пистолеты / ПП и автоматы / Снайперки и дробовики
#  Выдача бесплатная (меню выдачи). Экономику легко прикрутить позже.
# ============================================================

options:
    prefix: <dark_gray>[<#ff4655>Магазин<dark_gray>]

command /gunshop:
    description: Оружейный магазин
    executable by: players
    trigger:
        openMain(player)

# ------------------------------------------------------------
#  ГЛАВНОЕ МЕНЮ
# ------------------------------------------------------------
function openMain(p: player):
    set {_inv} to chest inventory with 3 rows named "<#0f0f0f>⚙ <#ff4655>Оружейный магазин"
    set {_glass} to gray stained glass pane named " "
    loop 27 times:
        set slot (loop-number - 1) of {_inv} to {_glass}
    set {_b1} to unbreakable wooden hoe named "Пистолеты"
    set lore of {_b1} to "<yellow>3 ствола" and "<gray>Патроны: пистолетные"
    set slot 11 of {_inv} to {_b1}
    set {_b2} to unbreakable iron hoe named "ПП и автоматы"
    set lore of {_b2} to "<yellow>3 ствола" and "<gray>Патроны: автоматные"
    set slot 13 of {_inv} to {_b2}
    set {_b3} to unbreakable netherite hoe named "Снайперки и дробовики"
    set lore of {_b3} to "<yellow>3 ствола" and "<gray>Патроны: снайперские, дробь"
    set slot 15 of {_inv} to {_b3}
    open {_inv} to {_p}
    set metadata tag "gunshop" of {_p} to "main"

# ------------------------------------------------------------
#  МЕНЮ КАТЕГОРИИ
# ------------------------------------------------------------
function openCat(p: player, cat: text):
    set {_inv} to chest inventory with 3 rows named "<#0f0f0f>⚙ <#ff4655>%{guncatname::%{_cat}%}%"
    set {_glass} to gray stained glass pane named " "
    loop 27 times:
        set slot (loop-number - 1) of {_inv} to {_glass}
    # стволы категории
    set {_n} to 0
    loop {guncat::%{_cat}%::*}:
        set {_id} to loop-value
        set slot (10 + {_n} * 2) of {_inv} to gunItem({_id})
        add 1 to {_n}
    # кнопка боеприпасов
    set {_info::*} to ""
    loop {ammotypes::*}:
        if {guncat::%{_cat}%::ammo1at} is loop-value:
            set {_info::*} to "<gray>+ %{guncat::%{_cat}%::ammo1give}% %{ammo::name::%loop-value%}%"
        if {guncat::%{_cat}%::ammo2at} is loop-value:
            add "<gray>+ %{guncat::%{_cat}%::ammo2give}% %{ammo::name::%loop-value%}%" to {_info::*}
    set {_ammo} to gunpowder named "Боеприпасы"
    set lore of {_ammo} to {_info::*}
    set slot 16 of {_inv} to {_ammo}
    # назад
    set slot 22 of {_inv} to barrier named "Назад"
    open {_inv} to {_p}
    set metadata tag "gunshop" of {_p} to {_cat}

# ------------------------------------------------------------
#  КЛИКИ
# ------------------------------------------------------------
on inventory click:
    if metadata tag "gunshop" of player is set:
        cancel event
        if event-inventory is not player's current inventory:
            stop
        if name of event-item is not set:
            stop
        set {_m} to metadata tag "gunshop" of player
        set {_n} to name of event-item
        # назад
        if {_n} is "Назад":
            play sound "ui.button.click" with volume 0.5 and pitch 1.2 at player
            openMain(player)
            stop
        if {_m} is "main":
            if {_n} is "Пистолеты":
                play sound "ui.button.click" with volume 0.5 and pitch 1.2 at player
                openCat(player, "pistols")
            else if {_n} is "ПП и автоматы":
                play sound "ui.button.click" with volume 0.5 and pitch 1.2 at player
                openCat(player, "smg")
            else if {_n} is "Снайперки и дробовики":
                play sound "ui.button.click" with volume 0.5 and pitch 1.2 at player
                openCat(player, "sniper")
            stop
        # покупка оружия
        loop {guncat::%{_m}%::*}:
            if {_n} is {gun::%loop-value%::name}:
                give player gunItem(loop-value)
                set {_at} to {gun::%loop-value%::at}
                if {ammo::%uuid of player%::%{_at}%} < {gun::%loop-value%::clip}:
                    set {ammo::%uuid of player%::%{_at}%} to {gun::%loop-value%::clip}
                send action bar "<green>Получено: <yellow>%{_n}% <gray>+ полный магазин" to player
                play sound "entity.experience_orb.pickup" with volume 0.7 and pitch 1.3 at player
                stop
        # покупка патронов
        if {_n} is "Боеприпасы":
            if {guncat::%{_m}%::ammo1at} is set:
                set {_a1} to {guncat::%{_m}%::ammo1at}
                add {guncat::%{_m}%::ammo1give} to {ammo::%uuid of player%::%{_a1}%}
            if {guncat::%{_m}%::ammo2at} is set:
                set {_a2} to {guncat::%{_m}%::ammo2at}
                add {guncat::%{_m}%::ammo2give} to {ammo::%uuid of player%::%{_a2}%}
            send action bar "<green>Патроны пополнены!" to player
            play sound "entity.experience_orb.pickup" with volume 0.7 and pitch 1.5 at player

on inventory close:
    delete metadata tag "gunshop" of player

on quit:
    delete metadata tag "gunshop" of player
