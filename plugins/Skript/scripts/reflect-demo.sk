# =====================================================================
# ДЕМО 3: Работа с NBT-тегами предмета (исправлено для 1.21.1)
# =====================================================================
command /nbttool:
    trigger:
        # Получаем предмет в руке
        set {_item} to player's tool
        
        if {_item} is air:
            send "&cВозьмите любой предмет в руку!" to player
            stop
        
        # Получаем ItemMeta
        set {_meta} to {_item}.getItemMeta()
        
        # Проверяем текущее состояние
        set {_wasUnbreakable} to {_meta}.isUnbreakable()
        
        # Делаем предмет неломаемым
        {_meta}.setUnbreakable(true)
        
        # Добавляем красивое имя
        {_meta}.setDisplayName("§6§lНЕЛОМАЕМЫЙ ПРЕДМЕТ")
        
        # Устанавливаем обновленный мета обратно на предмет
        {_item}.setItemMeta({_meta})
        
        # ВАЖНО: возвращаем изменённый предмет в руку игрока
        set player's tool to {_item}
        
        send "&6=== NBT-ИНСТРУМЕНТ ===" to player
        send "&eПредмет: &f%{_item}.getType()%" to player
        send "&eБыл неломаемым: &f%{_wasUnbreakable}%" to player
        send "&aТеперь предмет НЕЛОМАЕМЫЙ и имеет золотое имя!" to player